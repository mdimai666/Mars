{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "AllowedHosts": "*",
    "JWTSettings": {
        "PrivateKeyPath": "jwt_private.pem",
        "validAudience": "mars-app",
        "expiryInMinutes": 43200
    },
    "FeatureManagement": {
        "DockerAgent": false,
        "AITool": false,
        "AiChat": false,
        "SingleSignOn": false
    },
    "AppDatabaseMigrationOptions": {
        "AutoMigrate": true
    },
    "OpenTelemetryAppOptions": {
        "Enable": false
    },
    "PostgresDistributedCache": {
        "SchemaName": "cache",
        "TableName": "cache",
        "CreateIfNotExists": true,
        "UseWAL": false,
        "ExpiredItemsDeletionInterval": "00:30:00",
        "DefaultSlidingExpiration": "00:20:00"
    }
}
