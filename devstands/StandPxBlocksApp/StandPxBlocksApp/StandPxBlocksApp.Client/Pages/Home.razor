@page "/"
@using Mars.PxBlocks.Workspace
@using Mars.PxBlocks.Workspace.Run
@inject PxServerRunClient PxApi

<PageTitle>PxBlocks</PageTitle>

@* Песочница: контекст «sandbox» решает, какие блоки доступны и как запускать
    (политика start/loop — в контексте, у редактора явных параметров нет).
    Запуск — через PxRunController стенда (PxBlocks REST исполнения не даёт). *@
<div style="position:relative; height:100vh;">
    <PxSandboxEditor Context="sandbox"
                     RunTransport="@PxApi" />
    <a class="pxb-page-link" href="form">форма редактирования →</a>
</div>
