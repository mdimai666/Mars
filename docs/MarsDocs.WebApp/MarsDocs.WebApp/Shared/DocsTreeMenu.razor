@using MarsDocs.WebApp.Models
@using Microsoft.AspNetCore.Components.Routing
@inherits FluentComponentBase

<FluentNav Class="@Class" Style="@Style" Id="@Id"
           AdditionalAttributes="@AdditionalAttributes">
    @foreach (var item in Items.OrderBy(s => s.Order))
    {
        @if (item.IsDivider)
        {
            <FluentDivider />
        }
        else if (item.SubItemFlag)
        {
            <FluentNavCategory Title="@item.Title">
                @foreach (var leaf in Flatten(item))
                {
                    <FluentNavItem Href="@leaf.Url" Match="@MatchOf(leaf)">@leaf.Title</FluentNavItem>
                }
            </FluentNavCategory>
        }
        else
        {
            <FluentNavItem Href="@item.Url" Match="@MatchOf(item)">@item.Title</FluentNavItem>
        }
    }
</FluentNav>

@code {
    public DocsTreeMenu(LibraryConfiguration configuration) : base(configuration)
    {
    }

    [Parameter] public MenuItem[] Items { get; set; } = default!;

    // FluentNav v5 поддерживает только один уровень вложенности: вложенные группы схлопываются до листьев
    static IEnumerable<MenuItem> Flatten(MenuItem item) =>
        item.SubItems.OrderBy(s => s.Order)
                     .SelectMany(s => s.SubItemFlag ? Flatten(s) : [s]);

    static NavLinkMatch MatchOf(MenuItem item) =>
        item.Url is "/" or "" ? NavLinkMatch.All : NavLinkMatch.Prefix;
}
