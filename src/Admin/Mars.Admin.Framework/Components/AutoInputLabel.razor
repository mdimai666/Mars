@using Microsoft.FluentUI.AspNetCore.Components

@typeparam TValue

<FluentLabel AdditionalAttributes="@AdditionalAttributes" Required="_required">@_displayName</FluentLabel>

<div class="AutoInputLabel__Content">
    @ChildContent

    @if (_description is not null)
    {
        <div class="d-fluent-input-description">@_description</div>
    }
</div>
