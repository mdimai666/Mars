@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody Class="text-start">
    <TitleTemplate>
        <div class="hstack">
            <FluentIcon Value="@(new Icons.Regular.Size24.Delete())" Color="Color.Info" Class="me-2" />
            <FluentLabel Typo="Typography.Header">@(Dialog.Options.Header.Title ?? AppRes.ActionConfirmationPrompt)</FluentLabel>
        </div>
    </TitleTemplate>
    <ChildContent>
        <div class="my-2">
            <FluentLabel Typo="Typography.PaneHeader">@Content</FluentLabel>
        </div>
    </ChildContent>
    <ActionTemplate>
        <div class="hstack gap-2 justify-content-end">
            <FluentButton Appearance="ButtonAppearance.Primary" BackgroundColor="var(--bs-danger)" Color="white" Style="min-width:100px" OnClick="OkAsync">
                @AppRes.Ok
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="CancelAsync">
                @AppRes.Cancel
            </FluentButton>
        </div>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public MarkupString Content { get; set; } = default!;

    private Task OkAsync() => Dialog.CloseAsync();

    private Task CancelAsync() => Dialog.CancelAsync();
}
