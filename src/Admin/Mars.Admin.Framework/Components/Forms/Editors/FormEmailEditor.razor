@using Mars.Forms.Front
@using Microsoft.FluentUI.AspNetCore.Components

@* Общий редактор «Email» *@

<FluentTextField @bind-Value=Text
                 TextFieldType="@TextFieldType.Email"
                 Placeholder="user@example.com"
                 Name="@Binding.Field.Key"
                 Disabled="@Binding.ReadOnly"
                 Class="w-100" />

@code {
    [Parameter, EditorRequired] public FormFieldBinding Binding { get; set; } = default!;

    string Text
    {
        get => Binding.Value as string ?? "";
        set => Binding.Value = value;
    }
}
