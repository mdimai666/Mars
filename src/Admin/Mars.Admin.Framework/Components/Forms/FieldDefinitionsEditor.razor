@using Mars.Forms.Contracts
@using Microsoft.FluentUI.AspNetCore.Components

@* Общий редактор определений полей: источник (системные слоты типа, метаполя) отдаёт определения
   и возможности, редактор правит их и сообщает о каждом изменении. Что можно править — из
   FormDefinitionCapabilities, доменные настройки типа — из панелей реестра
   IFormFieldTypeSettingsLocator, поэтому компонент не знает домена. *@

<div class="vstack gap-2">

    @if (Definitions.Count == 0)
    {
        <div class="text-secondary">
            <SharedContentNoRecords />
        </div>
    }

    @foreach (var definition in Definitions)
    {
        <FieldDefinitionRow @key="definition"
                            Definition="definition"
                            Capabilities="Capabilities"
                            RuleTypes="RuleTypes"
                            SettingsScope="@SettingsScope"
                            TypePickerComponent="TypePickerComponent"
                            OnChanged="OnChanged"
                            OnSourceChanged="OnSourceChanged"
                            OnClone="OnClone"
                            OnDelete="OnDelete" />
    }

    @if (Capabilities.CanAdd)
    {
        <div class="mt-2">
            <FluentButton Appearance="Appearance.Accent"
                          IconStart="@(new Icons.Regular.Size16.Add())"
                          OnClick="OnAdd">Добавить</FluentButton>
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FormFieldDefinition> Definitions { get; set; } = [];

    [Parameter] public FormDefinitionCapabilities Capabilities { get; set; } = new();

    /// <summary>Доступные типы правил; пусто — весь каталог общего слоя</summary>
    [Parameter] public IReadOnlyCollection<string>? RuleTypes { get; set; }

    /// <summary>Скоуп панелей доменных настроек типа; пусто — панелей нет</summary>
    [Parameter] public string? SettingsScope { get; set; }

    /// <summary>Компонент пикера типа поля источника; null — тип поля не меняется</summary>
    [Parameter] public Type? TypePickerComponent { get; set; }

    /// <summary>Правка общего параметра определения</summary>
    [Parameter] public EventCallback<FormFieldDefinition> OnChanged { get; set; }

    /// <summary>Правка модели источника доменной панелью — определение перечитывается</summary>
    [Parameter] public EventCallback<FormFieldDefinition> OnSourceChanged { get; set; }

    [Parameter] public EventCallback OnAdd { get; set; }

    [Parameter] public EventCallback<FormFieldDefinition> OnClone { get; set; }

    [Parameter] public EventCallback<FormFieldDefinition> OnDelete { get; set; }
}
