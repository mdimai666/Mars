@using Microsoft.FluentUI.AspNetCore.Components

@* Компактная кнопка-иконка дизайнера: без текста, действие подписано в title *@
<FluentButton Appearance="Appearance.Stealth" Style="min-width:32px; width:32px; padding:2px" Class="@Class"
              Title="@Title" Disabled="@Disabled" OnClick="@OnClick">
    <FluentIcon Value="@Icon" />
</FluentButton>
