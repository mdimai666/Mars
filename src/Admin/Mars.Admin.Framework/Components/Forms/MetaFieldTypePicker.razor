@using Mars.Admin.Framework.Components.MetaFieldViews
@using Mars.Cms.Contracts.MetaFields
@using Mars.Forms.Contracts

@if (Field is not null)
{
    <div>
        <label>Тип поля</label>
        <GroupedSelectDropDown TOption="MetaFieldTypePresets.PickerItem"
                               Items="@TypePickerGroups"
                               OptionText="@(i => i.Label)"
                               OptionValue="@(i => i.OptionKey)"
                               Value="@CurrentValue"
                               Disabled="Definition.Protected"
                               ValueChanged="OnChangeTypeAsync"
                               ButtonStyle="min-width:250px;" />
    </div>
}
