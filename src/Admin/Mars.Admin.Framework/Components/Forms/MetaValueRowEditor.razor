@using Mars.Admin.Framework.Components.MetaFieldViews
@using Mars.Forms.Front
@implements IFormSelfLabeledEditor

@* Значение метаполя: примитивы по типу и кастомные редакторы из реестра MetaFieldEditors
   (WYSIWYG, Monaco, EditorJS, цвет, ссылка, email, дата…). Подпись и описание рисует сам
   инлайн-редактор значения, поэтому общий рендерер их не дублирует. *@

@if (Row is not null)
{
    <RowMetaValue Value="Row" Client="Client" />
}
else
{
    <div class="text-secondary fz12px">нет значения для поля @Binding.Field.Key</div>
}

@code {
    [CascadingParameter] public FormRenderContext Context { get; set; } = default!;

    [Parameter] public FormFieldBinding Binding { get; set; } = default!;

    /// <summary>Строка значения приходит из стора формы — это и есть значение метаполя</summary>
    MetaValueEditModel? Row => Binding.Value as MetaValueEditModel ?? FirstRow;

    /// <summary>У множественного поля значение — список строк, для примитивного редактора берём первую</summary>
    MetaValueEditModel? FirstRow
        => (Binding.Values.NativeValue(Binding.Field) as List<MetaValueEditModel>)
            ?.FirstOrDefault(v => v.MetaField.Key == Binding.Field.Key && v.Index == 0);

    bool Client => Context?.Client ?? false;
}
