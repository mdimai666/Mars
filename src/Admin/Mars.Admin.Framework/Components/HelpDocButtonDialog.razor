@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody Class="text-start">
    <TitleTemplate>
        <div class="hstack">
            <FluentIcon Value="@(new Icons.Regular.Size24.Info())" Color="Color.Info" Class="me-2" />
            <FluentLabel Typo="Typography.Header">@(Dialog.Options.Header.Title ?? "Help")</FluentLabel>
        </div>
    </TitleTemplate>
    <ChildContent>
        <div class="my-2">
            <FluentMarkdownSection FromAsset="@Url" />
        </div>
    </ChildContent>
    <ActionTemplate>
        <div class="hstack gap-2 justify-content-end">
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="CancelAsync">
                @AppRes.Ok
            </FluentButton>
        </div>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public string Content { get; set; } = default!;

    private string Url => Content;

    private Task OkAsync() => Dialog.CloseAsync();

    private Task CancelAsync() => Dialog.CancelAsync();
}
