@using Mars.Media.Contracts.Files
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody>
    <ChildContent>
        <d-media-folder-select-dialog>

            <div class="d-flex align-items-center gap-2 mb-2">
                <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Default" OnClick="SelectRoot">
                    По умолчанию (папка года)
                </FluentButton>
                @if (_breadcrumbs.Count > 0)
                {
                    <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle" OnClick="GoUp">.. вверх</FluentButton>
                }
                <span class="text-secondary small">@CurrentPath</span>
            </div>

            @if (_loading)
            {
                <FluentSpinner />
            }
            else if (_folders.Count == 0)
            {
                <FluentText Color="Color.Default">— нет вложенных папок —</FluentText>
            }
            else
            {
                <div class="vstack gap-1">
                    @foreach (var folder in _folders)
                    {
                        var item = folder;
                        <div class="d-flex align-items-center gap-2">
                            <FluentButton Class="flex-fill" Style="text-align:start;" Appearance="ButtonAppearance.Default" OnClick="@(() => OpenFolder(item))">
                                📁 @item.Name
                            </FluentButton>
                            <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Primary" OnClick="@(() => Select(item))">Выбрать</FluentButton>
                        </div>
                    }
                </div>
            }

        </d-media-folder-select-dialog>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Default" OnClick="CancelAsync">@AppRes.Cancel</FluentButton>
    </ActionTemplate>
</FluentDialogBody>
