@using Mars.Media.Contracts.Files
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialog aria-label="Select media file dialog"
              Modal=true
              @ref=Dialog
              Class="ModalMediaSelect"
              OnStateChange="@(e => { if (e.State == DialogState.Closed) _visible = false; })">
    <FluentDialogBody>
        <TitleTemplate>
            <FluentText Size="TextSize.Size500">Выбор файла</FluentText>
        </TitleTemplate>
        <ChildContent>
        @if (_visible)
        {
            <div class="@(_multiSelect ? "d-media-select-multi" : "")">
                <FluentMediaFilesList ReadOnly=ReadOnly @ref=refMediaFilesList>
                    <ItemActionBottom Context="file">
                        @if (_multiSelect)
                        {
                            @* stopPropagation не нужен: клика по строке нет *@
                            <FluentCheckbox Value="_selectedIds.Contains(file.Id)"
                                            ValueChanged="@(_ => ToggleSelected(file))"
                                            Label="выбрать" />
                        }
                        else
                        {
                            <FluentButton Appearance="ButtonAppearance.Primary" Class="w-100" OnClick="e=>OnFileSelect(file)">выбрать</FluentButton>
                        }
                    </ItemActionBottom>
                </FluentMediaFilesList>
            </div>
        }
        </ChildContent>
        <ActionTemplate>
            @if (_multiSelect)
            {
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="CancelMultiSelect">@AppRes.Cancel</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="ConfirmMultiSelect" Disabled="@(_selectedIds.Count == 0)">
                    Добавить выбранные (@_selectedIds.Count)
                </FluentButton>
            }
        </ActionTemplate>
    </FluentDialogBody>
</FluentDialog>


@code {
    [Inject] IAppMediaService service { get; set; } = default!;

    FluentMediaFilesList? refMediaFilesList;
    FluentDialog Dialog = default!;
    bool _dialogShown;


    [Parameter] public bool ReadOnly { get; set; } = false;


    bool _visible = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_visible && !_dialogShown)
        {
            await Dialog.ShowAsync();
            _dialogShown = true;
        }
        else if (!_visible && _dialogShown)
        {
            await Dialog.HideAsync();
            _dialogShown = false;
        }
    }


    public async Task<FileListItemResponse?> ShowModalForSelect()
    {
        _file = null;

        if (Q.User.IsAuth == false) return null;
        _visible = true;
        StateHasChanged();

        while (_visible == true)
        {
            await Task.Delay(25);
        }

        return _file;

    }

    FileListItemResponse? _file = null;

    void OnFileSelect(FileListItemResponse file)
    {
        //Value = file.Id;
        _file = file;
        _visible = false;
    }

    //-------------------------------------------
    // Мультивыбор: чекбоксы на плитках и кнопка «Добавить выбранные»

    bool _multiSelect;
    readonly HashSet<Guid> _selectedIds = [];
    readonly Dictionary<Guid, FileListItemResponse> _selectedFiles = [];
    IReadOnlyCollection<FileListItemResponse>? _files;

    public async Task<IReadOnlyCollection<FileListItemResponse>> ShowModalForSelectMany()
    {
        _multiSelect = true;
        _selectedIds.Clear();
        _selectedFiles.Clear();
        _files = null;

        if (Q.User.IsAuth == false)
        {
            _multiSelect = false;
            return [];
        }

        _visible = true;
        StateHasChanged();

        while (_visible == true)
        {
            await Task.Delay(25);
        }

        _multiSelect = false;
        return _files ?? [];
    }

    void ToggleSelected(FileListItemResponse file)
    {
        if (!_selectedIds.Remove(file.Id))
        {
            _selectedIds.Add(file.Id);
            _selectedFiles[file.Id] = file;
        }
    }

    void ConfirmMultiSelect()
    {
        _files = _selectedIds.Select(id => _selectedFiles[id]).ToList();
        _visible = false;
    }

    void CancelMultiSelect()
    {
        _files = [];
        _visible = false;
    }
}

<style>
    /* в режиме мультивыбора галочка выбора видна всегда, а не только при наведении
       (по умолчанию нижние действия плитки скрыты до :hover) */
    .d-media-select-multi .d-document-uploader .d-file-list .d-file-item .d-file-item-actions-bottom {
        opacity: 1 !important;
    }

    fluent-dialog.ModalMediaSelect::part(dialog) {
        /* v5: --dialog-width мёртв (max-width 600px в shadow-стилях) — ширина здесь;
           z-index на host не нужен — модальный dialog живёт в top layer */
        width: 80vw;
        max-width: 80vw;
    }
</style>
