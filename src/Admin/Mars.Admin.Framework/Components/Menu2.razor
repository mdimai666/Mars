@using Microsoft.FluentUI.AspNetCore.Components
@inherits FluentComponentBase
@using MenuItem = Mars.Admin.Framework.Models.MenuItem;

<FluentNav Class="@Class" Style="@Style" Id="@Id"
           AdditionalAttributes="@AdditionalAttributes">
    @foreach (var item in Items)
    {
        @if (item.IsDivider)
        {
            <FluentDivider />
        }
        else if (item.menuType == MenuItem.MenuType.Header)
        {
            <FluentNavSectionHeader Title="@item.Title" />
        }
        else if (item.SubItemFlag)
        {
            <FluentNavCategory Title="@item.Title">
                @foreach (var subitem in item.SubItems)
                {
                    @if (subitem.IsDivider)
                    {
                        <FluentDivider />
                    }
                    else
                    {
                        <FluentNavItem Href="@subitem.Url" Match="@subitem.navLinkMatch">@subitem.Title</FluentNavItem>
                    }
                }
            </FluentNavCategory>
        }
        else
        {
            <FluentNavItem Href="@item.Url" Match="@item.navLinkMatch">@item.Title</FluentNavItem>
        }
    }
</FluentNav>

@code {
    public Menu2(LibraryConfiguration configuration) : base(configuration)
    {
    }

    [Parameter] public List<MenuItem> Items { get; set; } = default!;
}
