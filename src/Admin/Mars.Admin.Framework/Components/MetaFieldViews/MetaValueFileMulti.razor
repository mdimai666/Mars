@using Mars.Admin.Framework.Components.MediaViews
@using Mars.Cms.Contracts.MetaFields
@using Microsoft.FluentUI.AspNetCore.Components
@inherits FluentComponentBase

@{
    // превью файла в квадратном контейнере (общее для таблицы и карточек)
    RenderFragment<MetaValueEditModel> preview = row => @<text>
        @if (IsLoading(row))
        {
            <SharedLoader2 />
        }
        else if (PreviewOf(row) is null)
        {
            <span>нет превью</span>
        }
        else
        {
            var file = PreviewOf(row)!;
            if (file.IsImage)
            {
                <Image2 Src="@(file.PreviewIcon)" PreviewSrc="@(file.Url)" Title="@file.Name" Class="d-file-preview-img" />
            }
            else
            {
                <div class="d-file-preview-icon" style="background-image:url('@(file.PreviewIcon)')"></div>
            }
        }
    </text>;
}

<d-metavalue-file-multi class="@Class" style=@Style>

    @if (_rows.Count > 0)
    {
        <FluentSortableList Id=@_sortableId Items="_rows" OnUpdate="OnSort" Context="row"
                            ListItemHeight="auto"
                            Class="@(IsCardsView ? "d-file-cards" : "")">
            <ItemTemplate>
                @{
                    var file = PreviewOf(row);
                }
                @if (IsCardsView)
                {
                    <div class="d-file-card" @key="row">
                        <div class="d-file-preview-box d-file-preview-box-card">
                            @preview(row)
                        </div>
                        <div class="d-file-card-title text-truncate" title="@(file?.Name ?? "…")">@(file?.Name ?? "…")</div>
                        @if (file is not null)
                        {
                            <div class="text-secondary small">@file.Size.ToHumanizedSize()</div>
                        }
                        <div class="d-file-card-actions">
                            <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => RemoveAsync(row))" Title="Убрать из списка">
                                <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                            </FluentButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-file-tile d-flex align-items-start gap-2 py-1" @key="row">
                        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSort())" Style="cursor:grab; margin-top:40px;" />
                        <div class="d-file-preview-box">
                            @preview(row)
                        </div>
                        <div class="vstack gap-1 flex-fill" style="min-width:0;">
                            @if (file is not null)
                            {
                                <div class="text-truncate" title="@file.Name">@file.Name</div>
                                <div class="text-secondary small">@file.Size.ToHumanizedSize()</div>
                                <div class="d-flex gap-1">
                                    <a href="@file.Url" target="_blank">
                                        <FluentButton Size="small" Appearance="Appearance.Neutral">открыть</FluentButton>
                                    </a>
                                    <FluentButton Size="small" Appearance="Appearance.Stealth" OnClick="@(() => RemoveAsync(row))" Title="Убрать из списка">
                                        <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                                    </FluentButton>
                                </div>
                            }
                            else
                            {
                                <span>…</span>
                            }
                        </div>
                    </div>
                }
            </ItemTemplate>
        </FluentSortableList>
    }
    else
    {
        <FluentLabel Color="Color.Neutral">-⚪ Не выбрано-</FluentLabel>
    }

    @if (Meta.DropZoneEnabled)
    {
        <div class="mt-1">
            <DropTileZone FolderPath="@Meta.UploadFolder"
                          Accept="@(Meta.Type == MetaFieldType.Image ? "image/*" : "*")"
                          TileClass="@(IsCardsView ? "d-drop-tile-card" : "d-drop-tile-row")"
                          OnFilesUploaded="OnFilesUploadedAsync" />
        </div>
    }

    <div class="mt-1 d-flex gap-2 align-items-center">
        <FluentButton OnClick="AddFromMediaAsync" IconStart="@(new Icons.Regular.Size16.Add())">Выбрать из медиа…</FluentButton>
    </div>

</d-metavalue-file-multi>

<style>
    /* квадратное превью: картинки любой пропорции не сдвигают раскладку */
    .d-file-preview-box {
        width: 102px;
        height: 102px;
        flex: none;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ededed;
        border-radius: 2px;
    }

        .d-file-preview-box .d-file-preview-icon {
            width: 100%;
            height: 100%;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
        }

        .d-file-preview-box mars-image2,
        .d-file-preview-box mars-image2 a,
        .d-file-preview-box mars-image2 img {
            width: 100%;
            height: 100%;
            display: block;
        }

        .d-file-preview-box mars-image2 img {
            object-fit: cover;
        }

    /* вид карточек — сетка, как у списков объектов */
    .d-file-cards.fluent-sortable-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        border: none;
        padding: 0;
        background: transparent;
        min-height: unset;
    }

        .d-file-cards.fluent-sortable-list .sortable-item {
            height: auto !important;
            align-items: stretch;
            background: transparent;
            border: none;
            border-radius: 0;
            padding: 0;
            margin-bottom: 0;
        }

    .d-file-card {
        position: relative;
        width: 140px;
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 6px;
        padding: 6px;
        background: var(--neutral-layer-2);
    }

        .d-file-card:hover {
            border-color: var(--accent-fill-rest);
        }

        .d-file-card .d-file-preview-box {
            width: 100%;
            height: 100px;
        }

    .d-file-card-title {
        margin-top: 4px;
        font-size: 13px;
    }

    .d-file-card-actions {
        position: absolute;
        top: 2px;
        right: 2px;
    }
</style>
