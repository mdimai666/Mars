@using Mars.Cms.Contracts.MetaFields
@using Microsoft.FluentUI.AspNetCore.Components
@inherits FluentComponentBase

<d-metavalue-relation-single class="@Class" style=@Style>

    @if (_busy)
    {
        <FluentProgressRing />
    }
    else if (_model is not null)
    {
        <div class="d-flex align-items-center gap-2 py-1">
            @if (!string.IsNullOrEmpty(_model.ImageUrl))
            {
                <img src="@_model.ImageUrl" alt="" class="d-relation-thumb" />
            }
            <div class="flex-fill text-truncate">
                @_model.Title
                @if (!string.IsNullOrEmpty(_model.Description))
                {
                    <span class="text-secondary small ms-2">@_model.Description</span>
                }
            </div>
            <FluentButton Appearance="Appearance.Neutral" OnClick="SelectAsync">Заменить…</FluentButton>
            <FluentButton Appearance="Appearance.Stealth" OnClick="ClearAsync" Title="Очистить">
                <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
            </FluentButton>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-2 py-1">
            <FluentLabel Color="Color.Neutral">-⚪ Не выбрано-</FluentLabel>
            <FluentButton OnClick="SelectAsync" IconStart="@(new Icons.Regular.Size16.Add())">Выбрать…</FluentButton>
        </div>
    }

</d-metavalue-relation-single>

<style>
    .d-relation-thumb {
        width: 36px;
        height: 36px;
        object-fit: cover;
        border-radius: 4px;
        flex: none;
    }
</style>
