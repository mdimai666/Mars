@using System.Linq.Expressions
@using Mars.Core.Exceptions
@using Mars.Cms.Contracts.Posts
@using Mars.Contracts.Models.Interfaces
@using MarsCodeEditor2
@using Microsoft.FluentUI.AspNetCore.Components
@inject IStringLocalizer<AppRes> L

@typeparam TModel

<section class="@("edit-container " + Class)" style="@(Style)">
    <ErrorBoundary>
        <ChildContent>

            <div class="edit-container__header">
                @if (!HidePublishCard)
                {
                    <DBackButton />
                    <div>
                        <h4 class="edit-container__title">
                            @if (TitleText is null)
                            {
                                @(L[typeof(TModel).Name])
                            }
                            else
                            {
                                @TitleText
                            }
                        </h4>
                        @if (SectionSubtitle is not null)
                        {
                            <p class="edit-container__subtitle">@SectionSubtitle(model)</p>
                        }
                    </div>
                }
                <div class="edit-container__tools">
                    @if (isEditJsonMode)
                    {
                        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="CancelJsonEditMode">
                            Отмена
                        </FluentButton>
                    }
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ToggleEditMode">
                        <FluentIcon Value=@(new Icons.Regular.Size24.CodeBlock()) Color="Microsoft.FluentUI.AspNetCore.Components.Color.Default" />
                    </FluentButton>
                    @if (SectionActions is not null)
                    {
                        @SectionActions(model)
                    }
                    else if (GeneralSectionActions is not null)
                    {
                        <DynamicComponent Type="GeneralSectionActions" />
                    }
                </div>
            </div>

            @if (isEditJsonMode)
            {
                <div class="edit-container__json">
                    <MarsCodeEditor2.CodeEditor2 @ref=codeEditor
                                                 Lang=@CodeEditor2.Language.json
                                                 OnSave="OnSaveFromCodeEditor"
                                                 Value=@GetModelAsJson() />
                </div>
            }
            else
            {
                <EditForm EditContext="@_editContext"
                          @ref=_editForm
                          OnSubmit="@OnSubmit"
                          FormName="@($"edit-{ID}")"
                          novalidate>
                    <ObjectGraphDataAnnotationsValidator />
                    <div class="edit-container__body">

                        @if (OperationError is not null)
                        {
                            <ExceptionMessage Exception="OperationError" />
                        }
                        else
                        {
                            <div class="edit-container__main">
                                @if (IsBusy)
                                {
                                    <SkeletonContent />
                                    <div class="spacer-2"></div>
                                    <SharedLoader1 />
                                }
                                else
                                {
                                    <section class="edit-container__fields">
                                        <FluentMessageBar Title="@AppRes.ValidationErrorsOccurredTitle" Intent="@MessageBarIntent.Warning" Visible="_isInvalidState" Class="edit-container__alert">
                                            <FluentValidationSummary />
                                        </FluentMessageBar>
                                        @ChildContent?.Invoke(model)
                                    </section>
                                }
                            </div>
                            <aside class="edit-container__aside">
                                <div class="edit-container__aside-inner">

                                    @if (IsBusy)
                                    {
                                        <div class="edit-container__skeleton">
                                            <FluentSkeleton Width="160px" Height="25px" Shimmer="true" />
                                            <div class="edit-container__skeleton-lines">
                                                <FluentSkeleton Class="edit-container__skeleton-line" Height="16px" Shimmer="true" />
                                                <FluentSkeleton Class="edit-container__skeleton-line" Height="16px" Shimmer="true" />
                                            </div>
                                            <FluentSkeleton Width="120px" Height="30px" Shimmer="true" Class="edit-container__skeleton-button" />
                                        </div>
                                    }
                                    else
                                    {
                                        @if (HidePublishCard)
                                        {
                                            <div class="edit-container__save-row">
                                                <FluentButton Appearance="ButtonAppearance.Primary" Loading="saveButtonBusy" Type="@ButtonType.Submit">
                                                    @AppRes.Save
                                                </FluentButton>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="edit-container__card">
                                                <div class="edit-container__card-body">
                                                    <h4 class="edit-container__card-title">Публикация</h4>

                                                    @if (!HideDatesSection && model is IBasicEntity basicEntity)
                                                    {
                                                        @if (!_addNewItem)
                                                        {
                                                            <h6 class="edit-container__card-meta">Создана: @basicEntity.CreatedAt.LocalDateTime.ToString("g")</h6>
                                                        }
                                                        else
                                                        {
                                                            <h6 class="edit-container__card-meta">Создание</h6>
                                                        }

                                                        @if (basicEntity.ModifiedAt != null)
                                                        {
                                                            <h6 class="edit-container__card-meta">Изменено: @basicEntity.ModifiedAt.Value.LocalDateTime.ToString("g")</h6>
                                                        }
                                                    }

                                                    @if (SectionSidePublish is not null)
                                                    {
                                                        <div class="edit-container__card-section">
                                                            @SectionSidePublish(model)
                                                        </div>
                                                    }

                                                    <div class="edit-container__card-actions">
                                                        @if (CanDelete)
                                                        {
                                                            <DFluentDeleteButton OnConfirm=OnDeleteClick Disabled=saveButtonBusy />
                                                        }

                                                        <FluentButton Appearance="ButtonAppearance.Primary" Loading="saveButtonBusy" Type="@ButtonType.Submit">
                                                            @AppRes.Save
                                                        </FluentButton>

                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <div class="edit-container__extra">
                                            @SectionExtraSidebar?.Invoke(model)
                                        </div>
                                    }

                                </div>
                            </aside>
                        }
                    </div>
                </EditForm>
            }
        </ChildContent>
        <ErrorContent>
            <ExceptionMessage Exception="context" />
        </ErrorContent>
    </ErrorBoundary>
</section>
