@using MarsCodeEditor2
@using Microsoft.FluentUI.AspNetCore.Components

<div class="WysiwygEditor shadow-sm @Class" style="@Style">
    @if (_isViewSource)
    {
        <FluentButton @onclick=HideSource Class="float-end">Показать редактор</FluentButton>
        <br />

        <br />

        <MarsCodeEditor2.CodeEditor2 @ref=HtmlEditor
                                      Lang=@CodeEditor2.Language.html
                                      OnSave="OnSaveFromCodeEditor"
                                      Value="@_content" />
    }
    else
    {
        <ErrorBoundary>
            <ChildContent>
                <div @ref="_toolbarElement" class="d-flex">
                    <select class="ql-header">
                        <option selected=""></option>
                        <option value="1"></option>
                        <option value="2"></option>
                        <option value="3"></option>
                        <option value="4"></option>
                        <option value="5"></option>
                    </select>
                    <span class="ql-formats">
                        <button class="ql-bold"></button>
                        <button class="ql-italic"></button>
                        <button class="ql-underline"></button>
                        <button class="ql-strike"></button>
                    </span>
                    <span class="ql-formats">
                        <select class="ql-align">
                            <option selected=""></option>
                            <option value="center"></option>
                            <option value="right"></option>
                            <option value="justify"></option>
                        </select>
                        <select class="ql-color"></select>
                        <select class="ql-background"></select>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-list" value="ordered"></button>
                        <button class="ql-list" value="bullet"></button>
                        <button class="ql-indent" value="-1"></button>
                        <button class="ql-indent" value="+1"></button>
                    </span>
                    <span class="ql-formats d-flex">
                        <button class="ql-link"></button>
                        <button class="ql-insert-image" @onclick=InsertImage>
                            <i class="bi bi-image"></i>
                        </button>
                        <div class="dropdown ql-html d-inline-block xcenter float-left">
                            <button class="btn btn-light dropdown-toggle rounded-0 py-0"
                                    style="width:unset;"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Выравнивание картинки">
                                <i class="bi bi-bounding-box"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li><h6 class="dropdown-header">Размер</h6></li>
                                <li><span role="button" class="dropdown-item" @onclick=@(e=>ModifyImages(ImageCollectionModify.ByFirst))>По первому</span></li>
                                <li><span role="button" class="dropdown-item" @onclick=@(e=>ModifyImages(ImageCollectionModify.ByMax))>По макс</span></li>
                                <li><span role="button" class="dropdown-item" @onclick=@(e=>ModifyImages(ImageCollectionModify.ByMin))>По мин</span></li>
                            </ul>
                        </div>
                    </span>
                    <span class="ql-formats">
                        <button class="ql-html p-0" @onclick=ViewSource><i class="bi bi-filetype-html"></i></button>
                    </span>
                </div>
                <div @ref="_editorElement"></div>
            </ChildContent>
            <ErrorContent>
                <p class="alert alert-danger container">
                    @context.Message
                    <pre>@context.StackTrace</pre>
                </p>
            </ErrorContent>
        </ErrorBoundary>
    }
</div>


@code {
    [Inject] IAppMediaService mediaService { get; set; } = default!;
    [Inject] WysiwygQuillJs WysiwygQuillJs { get; set; } = default!;

    CodeEditor2? HtmlEditor;
    ElementReference _toolbarElement;
    ElementReference _editorElement;

    [Parameter] public string Content { get; set; } = default!;

    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    string _content = default!;
    bool _isViewSource = false;
    bool _quillInitialized = false;

    protected override void OnInitialized()
    {
        _content = Content;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isViewSource || _quillInitialized) return;

        _quillInitialized = true;
        await WysiwygQuillJs.InitAsync(_editorElement, _toolbarElement);
        await WysiwygQuillJs.LoadHtmlAsync(_editorElement, _content);
    }

    public async Task<string> GetHTML()
    {
        if (_isViewSource)
            return await HtmlEditor!.GetValue();
        if (!_quillInitialized)
            return _content;
        return (await WysiwygQuillJs.GetHtmlAsync(_editorElement)) ?? _content;
    }

    /// <summary>Записать контент в редактор программно</summary>
    public async Task LoadContent(string html)
    {
        _content = html;
        _isViewSource = false;
        if (_quillInitialized)
            await WysiwygQuillJs.LoadHtmlAsync(_editorElement, html);
        else
            StateHasChanged();
    }

    async Task InsertImage()
    {
        var file = await mediaService.OpenSelectMedia();

        if (file is not null && _quillInitialized)
            await WysiwygQuillJs.InsertImageAsync(_editorElement, file.UrlRelative);
    }

    private async Task ViewSource()
    {
        _content = await GetHTML();
        _isViewSource = true;
        _quillInitialized = false;
        StateHasChanged();
    }

    private async Task HideSource()
    {
        _content = await HtmlEditor!.GetValue();
        _isViewSource = false;
        StateHasChanged();
    }

    private async Task OnSaveFromCodeEditor()
    {
        _content = await HtmlEditor!.GetValue();
    }

    async Task ModifyImages(ImageCollectionModify mode)
    {
        var html = await GetHTML();
        var result = WysiwygEditorHelper.ModifyImages(html, mode);
        if (result is not null)
        {
            _content = result;
            if (_quillInitialized)
                await WysiwygQuillJs.LoadHtmlAsync(_editorElement, result);
        }
    }
}


<style>
    .ql-editor {
        min-height: 300px;
        max-height: 85vh;
    }

    .WysiwygEditor {
        background-color: white;
    }

    .ql-insert-image {
        position: relative;
        top: -3px;
    }
</style>
