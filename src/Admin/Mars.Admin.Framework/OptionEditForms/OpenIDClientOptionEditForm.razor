@using Mars.Admin.Framework.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using MarsCodeEditor2
@using Mars.SSO.Contracts.Options

@attribute [OptionEditFormForOptionAttribute(typeof(OpenIDClientOption))]
@attribute [Display(Name = "OpenID Connect")]
@attribute [AutoShowFormOnSettingsPage]

<EditOptionForm @ref=form TModel="OpenIDClientOption">

    <h3>Настройки OpenID Connect</h3>

    <div class="vstack gap-3">
        @foreach (var _sso in context.OpenIDClientConfigs)
        {
            var sso = _sso;
            <FluentCard>
                <FormItem2 For="() => sso.Enable" Class="col">
                    <FluentSwitch @bind-Value="@sso.Enable" />
                </FormItem2>

                <FluentDivider Class="my-4" />

                <div class="row row-cols-3 g-2">
                    <FormItem2 For="() => sso.Slug" Class="col">
                        <FluentTextInput @bind-Value="@sso.Slug" Class="w-100" />
                    </FormItem2>
                    <FormItem2 For="() => sso.Title" Class="col">
                        <FluentTextInput @bind-Value="@sso.Title" Class="w-100" />
                    </FormItem2>
                    <FormItem2 For="() => sso.Driver" Class="col">
                        <FluentSelect TOption="KeyValuePair<string, string>"
                                      TValue="string"
                                      @bind-Value="@sso.Driver"
                                      OptionValue=@(s => s.Key)
                                      OptionText=@(s => s.Value)
                                      Items="OpenIDClientOption.DriverList"
                                      Style="width: 250px;" />
                    </FormItem2>
                </div>

                <div class="d-flex align-items-end mb-3">
                    <FormItem2 For="() => sso.IconUrl" Class="col 1mb-3 flex-fill">
                        <FluentTextInput @bind-Value="@sso.IconUrl" Class="w-100" />
                    </FormItem2>
                    <FluentButton OnClick=@(e => InsertImage(sso)) Class="mb-2">
                        <i class="bi bi-file-earmark-richtext"></i>
                    </FluentButton>
                </div>

                <FormItem2 For="() => sso.AuthEndpoint" Class="col">
                    <FluentTextInput @bind-Value="@sso.AuthEndpoint" Class="w-100" />
                </FormItem2>

                <FormItem2 For="() => sso.TokenEndpoint" Class="col">
                    <FluentTextInput @bind-Value="@sso.TokenEndpoint" Class="w-100" />
                </FormItem2>

                <div class="row row-cols-3 g-2">
                    <FormItem2 For="() => sso.ClientId" Class="col">
                        <FluentTextInput @bind-Value="@sso.ClientId" Class="w-100" autocomplete="off" />
                    </FormItem2>

                    <FormItem2 For="() => sso.ClientSecret" Class="col">
                        <FluentTextInput @bind-Value="@sso.ClientSecret" Class="w-100" TextInputType="@TextInputType.Password" autocomplete="new-password" />
                    </FormItem2>
                </div>

                <FormItem2 For="() => sso.CallbackPath" Class="col">
                    <FluentTextInput @bind-Value="@sso.CallbackPath" Class="w-100" />
                </FormItem2>

                <FormItem2 For="() => sso.Issuer" Class="col">
                    <FluentTextInput @bind-Value="@sso.Issuer" Class="w-100" />
                </FormItem2>

                @* <FormItem2 For="()=>sso.SignedOutCallbackPath" Class="col">
            <FluentTextField @bind-Value="@sso.SignedOutCallbackPath" Class="w-100" />
            </FormItem2>

            <FormItem2 For="()=>sso.SignedOutRedirectUri" Class="col">
            <FluentTextField @bind-Value="@sso.SignedOutRedirectUri" Class="w-100" />
            </FormItem2> *@

                <FormItem2 For="() => sso.Scopes" Class="col">
                    <FluentTextInput @bind-Value="@sso.Scopes" />
                </FormItem2>

                <div class="spacer-2"></div>

                <div class="hstack gap-3">
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick=@(e => DeleteSSOClick(sso))>Delete</FluentButton>
                    <div class="ms-auto">
                        @if (OpenIDClientOption.Documentations.TryGetValue(sso.Driver, out var url))
                        {
                            <HelpDocButton Url="@url" Label="@($"Как сделать для {sso.Driver}")" />
                        }
                    </div>
                </div>

            </FluentCard>
        }
    </div>

    <div class="py-3 d-flex justify-content-end gap-3">
        <div>
            <FluentButton Id="@_addProviderButtonId">Add provider</FluentButton>
            <FluentMenu Trigger="@_addProviderButtonId" OnClick="OnAddProviderMenuClick">
                <FluentMenuList>
                    @foreach (var (key, title) in OpenIDClientOption.DriverList)
                    {
                        <FluentMenuItem Id="@key">@title</FluentMenuItem>
                    }
                </FluentMenuList>
            </FluentMenu>
        </div>

        <FluentButton OnClick="AddSSOClick">Add blank</FluentButton>
    </div>

</EditOptionForm>

@code {
    EditOptionForm<OpenIDClientOption> form = default!;
    [Inject] IAppMediaService mediaService { get; set; } = default!;

    readonly string _addProviderButtonId = "addprov-" + Guid.NewGuid().ToString();

    void OnAddProviderMenuClick(MenuItemEventArgs args)
    {
        if (args.Item?.Id is { } id)
            AddProviderExample(id);
    }

    void AddSSOClick()
    {
        form.Model.OpenIDClientConfigs.Add(new() { Enable = true });
    }

    void DeleteSSOClick(OpenIDClientConfig sso)
    {
        form.Model.OpenIDClientConfigs.Remove(sso);
    }

    async void InsertImage(OpenIDClientConfig sso)
    {
        var file = await mediaService.OpenSelectMedia();

        if (file is not null)
        {
            sso.IconUrl = file.UrlRelative;
            StateHasChanged();
        }
    }

    void AddProviderExample(string driver)
    {
        if (OpenIDClientOption.Examples().TryGetValue(driver, out var config))
        {
            form.Model.OpenIDClientConfigs.Add(config);
        }
    }
}
