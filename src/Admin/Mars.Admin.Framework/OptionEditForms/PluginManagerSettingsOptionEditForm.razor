@using Microsoft.FluentUI.AspNetCore.Components
@using Mars.Plugin.Contracts.Options
@attribute [OptionEditFormForOptionAttribute(typeof(PluginManagerSettingsOption))]
@attribute [Display(Name = "Plugins")]
@attribute [AutoShowFormOnSettingsPage]

<EditOptionForm @ref=form TModel="PluginManagerSettingsOption">
    <h3>Настройки менеджера плагинов</h3>

    <FluentCheckbox @bind-Value="@context.AllowUploadZipManually">
        <AutoInputLabel For="@(() => context.AllowUploadZipManually)" />
    </FluentCheckbox>

    <FormItem2 For="() => context.NugetSources" Class="col">
        <FluentTextInput @bind-Value="@context.NugetSources" Class="w-100" />
    </FormItem2>

    <FormItem2 For="() => context.BlockedPackageIds" Class="col">
        <FluentTextInput @bind-Value="@context.BlockedPackageIds" Class="w-100" />
    </FormItem2>

</EditOptionForm>

@code {
    EditOptionForm<PluginManagerSettingsOption>? form;

}
