@page "/Post"
@page "/Post/{POSTTYPE}"
@using AppAdmin.Pages.PageViews
@inject IStringLocalizer<AppRes> L
@inject Mars.Shared.Interfaces.IActAppService actApp
@attribute [Authorize(Roles = "Admin")]

<ContentWrapper Title="@(postType?.Title)" WrapperClass="vstack">
    <SectionActions>
        <FluentButton Appearance="Appearance.Stealth" Title="Перегенерировать значения полей-генераторов"
                      @onclick="@(() => actApp.Inject(AppAdmin.Shared.RegenerateGeneratedMetaValuesForm.CommandId))">
            <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSync())" />
        </FluentButton>
        <XActionsDropDown ContextPart="@POSTTYPE" AlsoShowRootContext="true" />
    </SectionActions>
    <ChildContent>

        @if (postType?.Presentation.ListViewTemplate == null)
        {
            @if (POSTTYPE == "page")
            {
                <div class="p-2 d-flex position-relative">
                    <AppFrontInfoBadge />
                    <a href="template/view" class="stretched-link"></a>
                </div>
            }
        }
        @if (POSTTYPE == "NONE-gallery")
        {
            <div>
                @* <AppAdmin.Pages.PostsViews.SpecialViews.GalleryManageView POSTTYPE=@POSTTYPE /> *@
                gallery
            </div>
        }
        else
        {
            <ManagePostView @ref=_managePostView PostType=@postType />
        }

    </ChildContent>
</ContentWrapper>
