@page "/Settings/Front"
@using AppFront.Main.Extensions
@using Mars.Shared.Contracts.WebSite.Dto
@using Mars.Shared.Options
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@attribute [Authorize(Roles = "Admin")]
@attribute [Display(Name = "Фронты")]
@inject IMarsWebApiClient client
@inject NavigationManager nav

<SettingsPageWrapper>

    <h1>Фронты</h1>

    <div class="card mb-3">
        <div class="card-body">
            <div class="hstack gap-2 flex-wrap align-items-end">
                <div style="min-width:180px;">
                    <label class="form-label">Slug</label>
                    <input class="form-control" @bind="newSlug" placeholder="my-front" autocomplete="off" />
                </div>
                <div style="min-width:180px;">
                    <label class="form-label">Url</label>
                    <input class="form-control" @bind="newUrl" placeholder="/my-front" autocomplete="off" />
                </div>
                <FluentButton Appearance="Appearance.Accent" OnClick="CreateFront" Disabled=@creating>
                    Создать фронт
                </FluentButton>
            </div>
            <div class="text-secondary small mt-2">
                Фронт создаётся из стартового шаблона в папку <mark>data/fronts/&lt;slug&gt;</mark>.
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="hstack gap-2 flex-wrap">
                <span class="fs-5 fw-semibold">admin</span>
                <span class="badge text-bg-info">специальный фронт админки</span>
                <span class="text-secondary small">data/admin/front · только в админ-панели</span>
                <div class="ms-auto">
                    <FluentButton Appearance="Appearance.Neutral" OnClick=@(() => nav.NavigateTo("front/editor/admin"))>
                        Редактор
                    </FluentButton>
                </div>
            </div>
        </div>
    </div>

    <EditOptionForm @ref=form TModel="FrontsOption">

        <div class="vstack gap-3">

            <div class="card d-card-glow">
                <div class="card-body">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="warmupRenderOnStartup" @bind="context.WarmupRenderOnStartup" />
                        <label class="form-check-label" for="warmupRenderOnStartup">Прогревать рендер после запуска</label>
                    </div>
                    <div class="text-secondary small mt-1">
                        Первый фронт собирается сразу после старта, чтобы первый запрос был быстрее.
                    </div>
                </div>
            </div>

            @foreach (var _front in context.Fronts)
            {
                var front = _front;
                <div class="card d-card-glow">
                    <div class="card-body vstack gap-2">

                        <div class="hstack gap-2">
                            <span class="fs-5 fw-semibold">@front.Slug</span>
                            <span class="badge text-bg-secondary">@front.EngineId</span>
                            @if (!front.Enabled)
                            {
                                <span class="badge text-bg-warning">выключен</span>
                            }
                            <div class="ms-auto hstack gap-2">
                                <FluentButton Appearance="Appearance.Neutral" OnClick=@(() => OpenEditor(front))>
                                    Редактор
                                </FluentButton>
                                <div class="form-check align-self-center small">
                                    <input class="form-check-input" type="checkbox" id=@($"delFolder_{front.Slug}")
                                           checked=@GetDeleteFlag(front.Slug)
                                           @onchange=@(e => SetDeleteFlag(front.Slug, e.Value)) />
                                    <label class="form-check-label" for=@($"delFolder_{front.Slug}")>удалить с папкой</label>
                                </div>
                                <DFluentDeleteButton OnConfirm=@(() => DeleteFront(front)) />
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label">Title</label>
                                <input class="form-control" @bind="front.Title" autocomplete="off" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Url</label>
                                <input class="form-control" @bind="front.Url" placeholder="/" autocomplete="off" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Path</label>
                                <input class="form-control" @bind="front.Path" placeholder="пусто = data/fronts/@front.Slug" autocomplete="off" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Движок</label>
                                <select class="form-select" @bind="front.EngineId">
                                    @foreach (var engine in engines)
                                    {
                                        <option value="@engine.Id" title="@engine.Description">@engine.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-1 form-check mt-4 ms-2">
                                <input class="form-check-input" type="checkbox" id=@($"enabled_{front.Slug}") @bind="front.Enabled" />
                                <label class="form-check-label" for=@($"enabled_{front.Slug}")>вкл</label>
                            </div>
                        </div>

                    </div>
                </div>
            }

            @if (context.Fronts.Count == 0)
            {
                <SharedContentNoRecords />
            }
        </div>

    </EditOptionForm>
</SettingsPageWrapper>

@code {
    EditOptionForm<FrontsOption> form = default!;

    IReadOnlyCollection<FFrontEngineResponse> engines = [];

    string newSlug = "";
    string newUrl = "";
    bool creating;

    readonly Dictionary<string, bool> deleteFolderFlags = new();

    protected override async Task OnInitializedAsync()
    {
        engines = await client.Front.Engines();
    }

    bool GetDeleteFlag(string slug)
        => deleteFolderFlags.TryGetValue(slug, out var flag) && flag;

    void SetDeleteFlag(string slug, object? value)
        => deleteFolderFlags[slug] = value is bool b && b;

    async Task CreateFront()
    {
        creating = true;
        StateHasChanged();

        var result = await client.Front.CreateFront(new FCreateFrontRequest
        {
            Slug = newSlug.Trim(),
            Url = newUrl.Trim(),
            UseTemplate = true,
        }).SmartActionResult();

        if (result.Ok)
        {
            newSlug = "";
            newUrl = "";
            await form.Load();
        }

        creating = false;
        StateHasChanged();
    }

    async Task DeleteFront(FrontItem front)
    {
        var withFolder = GetDeleteFlag(front.Slug);
        var result = await client.Front.DeleteFront(front.Slug, withFolder).SmartActionResult();

        if (result.Ok)
        {
            deleteFolderFlags.Remove(front.Slug);
            await form.Load();
        }
    }

    void OpenEditor(FrontItem front)
    {
        nav.NavigateTo($"front/editor/{front.Slug}");
    }
}
