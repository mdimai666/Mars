@using Mars.Shared.Contracts.Files
@using Microsoft.FluentUI.AspNetCore.Components
@inherits FluentComponentBase

<MediaUploadZone Class="d-drop-tile-zone"
                 FolderPath="@FolderPath"
                 Accept="@Accept"
                 Multiple="true"
                 ShowResults="false"
                 ZoneClickable="true"
                 ZoneStyle="min-height:unset; width:max-content; height:max-content; padding:0; background:transparent; grid-gap:0;"
                 OnFilesUploaded="OnFilesUploaded">
    <ZoneContent>
        <div class="d-drop-tile @TileClass" title="Загрузить файлы">
            <FluentIcon Value="@(new Icons.Regular.Size24.Add())" />
        </div>
    </ZoneContent>
</MediaUploadZone>

<style>
    /* плитка-дроп «+»: без текста, размером как элемент списка; пунктирный контур и
       его сплошная реакция при наведении файла — библиотечные (fluent-inputfile-container) */
    d-media-upload-zone.d-drop-tile-zone input[type='file'] {
        width: 0 !important;
        height: 0 !important;
    }

    d-media-upload-zone.d-drop-tile-zone .inputfile-progress {
        display: none;
    }

    .d-drop-tile {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent-fill-rest);
        cursor: pointer;
    }

    .d-drop-tile-row {
        width: 102px;
        height: 102px;
    }

    .d-drop-tile-card {
        width: 140px;
        height: 140px;
    }
</style>

@code {
    /// <summary>Папка загрузки (пусто = папка года)</summary>
    [Parameter] public string? FolderPath { get; set; }

    /// <summary>Фильтр файлов</summary>
    [Parameter] public string Accept { get; set; } = "*";

    /// <summary>Размер плитки: d-drop-tile-row (таблица) / d-drop-tile-card (карточки)</summary>
    [Parameter] public string TileClass { get; set; } = "d-drop-tile-row";

    /// <summary>Успешно загруженные файлы</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<FileDetailResponse>> OnFilesUploaded { get; set; }
}
