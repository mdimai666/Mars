@using Mars.Shared.Contracts.Files
@using Microsoft.FluentUI.AspNetCore.Components

@implements IDialogContentComponent<string>

<FluentDialogBody>
    <d-media-folder-select-dialog>

        <div class="d-flex align-items-center gap-2 mb-2">
            <FluentButton Size="small" Appearance="Appearance.Neutral" OnClick="SelectRoot">
                По умолчанию (папка года)
            </FluentButton>
            @if (_breadcrumbs.Count > 0)
            {
                <FluentButton Size="small" Appearance="Appearance.Stealth" OnClick="GoUp">.. вверх</FluentButton>
            }
            <span class="text-secondary small">@CurrentPath</span>
        </div>

        @if (_loading)
        {
            <FluentProgressRing />
        }
        else if (_folders.Count == 0)
        {
            <FluentLabel Color="Color.Neutral">— нет вложенных папок —</FluentLabel>
        }
        else
        {
            <div class="vstack gap-1">
                @foreach (var folder in _folders)
                {
                    var item = folder;
                    <div class="d-flex align-items-center gap-2">
                        <FluentButton Class="flex-fill" Style="text-align:start;" Appearance="Appearance.Neutral" OnClick="@(() => OpenFolder(item))">
                            📁 @item.Name
                        </FluentButton>
                        <FluentButton Size="small" Appearance="Appearance.Accent" OnClick="@(() => Select(item))">Выбрать</FluentButton>
                    </div>
                }
            </div>
        }

    </d-media-folder-select-dialog>
</FluentDialogBody>
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Neutral" OnClick="CancelAsync">@AppRes.Cancel</FluentButton>
</FluentDialogFooter>
