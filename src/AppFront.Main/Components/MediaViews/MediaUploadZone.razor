@using Mars.Shared.Contracts.Files
@using Microsoft.FluentUI.AspNetCore.Components
@inherits FluentComponentBase

<d-media-upload-zone class="@Class" style="@Style">

    @* ВАЖНО: в авто-режиме не задаём OnInputFileChange — при заданном делегате
       FluentInputFile полностью пропускает свою обработку (нет ни
       OnFileUploaded, ни OnCompleted) и загрузка ломается. *@
    @if (AutoUpload)
    {
        <FluentInputFile Mode="InputFileMode.Stream"
                         Id="@_inputFileId"
                         Multiple="@Multiple"
                         MaximumFileCount="@MaximumFileCount"
                         MaximumFileSize="@MaximumFileSize"
                         Accept="@Accept"
                         @bind-ProgressPercent="@_progressPercent"
                         OnCompleted="@OnCompletedHandler"
                         OnFileUploaded="@OnFileUploadedHandler"
                         Style="@ZoneStyle">
            <ChildContent>
                <label for="@_inputFileId" class="p-3">
                    <FluentIcon Value="@(new Icons.Regular.Size24.ArrowUpload())" />
                    <div>
                        @Label
                    </div>
                </label>
            </ChildContent>
        </FluentInputFile>
    }
    else
    {
        <FluentInputFile Mode="InputFileMode.Stream"
                         Id="@_inputFileId"
                         Multiple="@Multiple"
                         MaximumFileCount="@MaximumFileCount"
                         MaximumFileSize="@MaximumFileSize"
                         Accept="@Accept"
                         OnInputFileChange="@OnFilesSelected"
                         Style="@ZoneStyle">
            <ChildContent>
                <label for="@_inputFileId" class="p-3">
                    <FluentIcon Value="@(new Icons.Regular.Size24.ArrowUpload())" />
                    <div>
                        @Label
                    </div>
                </label>
            </ChildContent>
        </FluentInputFile>
    }

    @if (AutoUpload && _results.Count > 0)
    {
        <div>
            <strong>Список загруженного: </strong>
            <a @onclick="@(_ => _results.Clear())">@AppRes.Clear.ToLower()</a>
        </div>
        <ul>
            @foreach (var file in _results)
            {
                var _class = file.ErrorMessage != null ? "text-danger" : "";

                <li class="@_class">
                    <span>@file.Name</span> 🔹
                    @(file.Size.ToHumanizedSize()) 🔹

                    @if (file.ErrorMessage != null)
                    {
                        <span class="text-danger"> @file.ErrorMessage </span>
                    }
                </li>
            }
        </ul>
    }

</d-media-upload-zone>
