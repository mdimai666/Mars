@using AppFront.Shared.Components.MediaViews
@using Mars.Shared.Contracts.MetaFields
@using Mars.Shared.Contracts.Posts
@using Microsoft.FluentUI.AspNetCore.Components
@inherits FluentComponentBase

<d-metavalue-children-list class="@Class" style=@Style>

    @if (_busy)
    {
        <FluentProgressRing />
    }
    else if (_unsupported)
    {
        <FluentLabel Color="Color.Neutral">Список объектов: цель поля должна быть типом поста</FluentLabel>
    }
    else
    {
        @if (_items.Count > 0)
        {
            <FluentDataGrid Items="_items.AsQueryable()"
                            TGridItem="PostListItemResponse"
                            ShowHover="true"
                            OnRowClick="OnRowClick"
                            GridTemplateColumns="@GridColumns">
                <PropertyColumn Property="@(f => f.Title)" Title="@AppRes.Title" />
                @foreach (var col in _metaColumns)
                {
                    var key = col.Key;
                    var isImage = col.Type == MetaFieldType.Image;
                    <TemplateColumn Title="@col.Title">
                        @if (isImage)
                        {
                            var url = context.MetaColumns?.GetValueOrDefault(key)?.Split(", ").FirstOrDefault();
                            @if (!string.IsNullOrEmpty(url))
                            {
                                <img src="@url" alt="" class="d-children-thumb" />
                            }
                        }
                        else
                        {
                            @context.MetaColumns?.GetValueOrDefault(key)
                        }
                    </TemplateColumn>
                }
                <PropertyColumn Property="@(f => f.CreatedAt)" Title="@AppRes.CreatedAt" Format="d" Align="Align.End" />
                <TemplateColumn Title="">
                    @* stopPropagation: клик по удалению не должен открывать строку (OnRowClick) *@
                    <div class="d-inline-block" @onclick="@(_ => {})" @onclick:stopPropagation>
                        <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => RemoveAsync(context.Id))">
                            <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                        </FluentButton>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
        }
        else
        {
            <FluentLabel Color="Color.Neutral">— пусто —</FluentLabel>
        }

        <div class="mt-2 d-flex gap-2">
            <FluentButton OnClick="OpenCreateAsync" IconStart="@(new Icons.Regular.Size16.Add())">Добавить</FluentButton>
            <FluentButton OnClick="OpenSelectAsync" Appearance="Appearance.Neutral">Привязать существующий…</FluentButton>
        </div>

        @if (_dropField is not null)
        {
            <div class="mt-2">
                <MediaUploadZone FolderPath="@_dropField.Options.GetUploadFolder()"
                                 Accept="@(_dropField.Type == MetaFieldType.Image ? "image/*" : "*")"
                                 Label="Загрузить файлы — создастся объект на каждый файл"
                                 ZoneStyle="min-height: 60px;"
                                 OnFilesUploaded="OnFilesUploadedAsync" />
            </div>
        }
    }

</d-metavalue-children-list>

<style>
    .d-children-thumb {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 4px;
    }
</style>
