@using Microsoft.FluentUI.AspNetCore.Components
@using Mars.Contracts.MetaFields

@implements IDialogContentComponent<MetaValueRelationSelectDialogData>

<FluentDialogBody>
    <d-metavalue-relation-select-dialog>

        <div class="d-flex">
            <div class="flex-fill d-flex gap-2">
                <FluentSearch @bind-Value=_searchText
                              @bind-Value:after=HandleSearchInput
                              Immediate
                              ImmediateDelay="300"
                              Autofocus
                              Appearance="FluentInputAppearance.Filled"
                              AriaLabel="Search" />

                <FluentSelect TOption=@(KeyValuePair<string, string>)
                              @bind-Value=_sortValue
                              SelectedOptionChanged="SelectSortOption"
                              Width="unset"
                              Items="SortOptions"
                              Style="height:32px"
                              OptionText="@(f=>f.Value)"
                              OptionValue="@(f=>f.Key)" />

                <FluentButton IconStart="sortButtonIcon" OnClick="OnClickSortDirectionChange" />
            </div>
            <div class="d-flex gap-3">
                <div class="dropdown">
                    <a class="btn btn-light dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Действия
                    </a>

                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                        <li><a class="dropdown-item">Test</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="spacer-1"></div>

        <div style="height: 534px; overflow:auto;">
            <FluentDataGrid ItemsProvider="dataProvider"
                            @ref=table
                            ShowHover="true"
                            AutoFit
                            Virtualize
                            ItemSize="66"
                            GenerateHeader="GenerateHeaderOption.None"
                            OnRowClick="OnRowClick"
                            GridTemplateColumns="@GridColumns"
                            TGridItem="MetaValueRelationModelSummaryResponse">
                @if (Content.MultiSelect)
                {
                    <TemplateColumn Title="">
                        @* stopPropagation: клик по чекбоксу не должен дополнительно срабатывать как клик по строке *@
                        <div class="d-inline-block" @onclick="@(_ => {})" @onclick:stopPropagation>
                            <FluentCheckbox Value="_selectedIds.Contains(context.Id)"
                                            ValueChanged="@(_ => ToggleSelected(context.Id))" />
                        </div>
                    </TemplateColumn>
                }
                <TemplateColumn Title="@AppRes.Title">

                    @{
                        var isActive = Content.MultiSelect
                            ? _selectedIds.Contains(context.Id)
                            : Content.ValueId == context.Id;
                        var _class = isActive ? "active" : "";
                    }

                    <div class="d-metavalue-relation-select-dialog__list-item position-relative">
                        <div class="d-flex align-items-center gap-2 @($"{_class}")">
                            @if (!string.IsNullOrEmpty(context.ImageUrl))
                            {
                                <img src="@context.ImageUrl" alt="" class="d-relation-select-thumb" />
                            }
                            <div class="text-truncate">
                                <div class="fz18px">@context.Title</div>
                                <div class="text-secondary small">@context.Description</div>
                            </div>
                        </div>
                        @* <a href="@urlEditPage/@context.Id" class="stretched-link"></a> *@
                    </div>

                </TemplateColumn>
                <PropertyColumn Property=@(f=>f.CreatedAt) Title="@AppRes.CreatedAt" Format="d" Sortable="true" Align="Align.End" />

            </FluentDataGrid>
        </div>


    </d-metavalue-relation-select-dialog>
</FluentDialogBody>
@if (Content.MultiSelect)
{
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Neutral" OnClick="CancelAsync">@AppRes.Cancel</FluentButton>
        <FluentButton Appearance="Appearance.Accent" OnClick="AddSelectedAsync" Disabled="@(_selectedIds.Count == 0)">
            Добавить выбранные (@_selectedIds.Count)
        </FluentButton>
    </FluentDialogFooter>
}
else
{
    <FluentDialogFooter Visible=false />
}

<style>
    .d-metavalue-relation-select-dialog__list-item.active {
        background-color: var(--bs-primary);
    }

    .d-relation-select-thumb {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 4px;
        flex: none;
    }
</style>
