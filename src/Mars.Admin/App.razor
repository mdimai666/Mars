@using Microsoft.FluentUI.AspNetCore.Components

@if (Q.Site is not null)
{
    <div style="flex: 1 0;display:flex;flex-direction:column;--bs-primary: var(--accent-base-color);">
        <CascadingAuthenticationState>
            <Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="AdditionalAssemblies">
                <Found Context="routeData">
                    <CascadingValue Name="RouteData" Value="trackRouteData = routeData">
                        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(AdminLayout)">
                            <Authorizing>
                                <text> Пожалуйста, подождите, мы авторизуем пользователя... </text>
                            </Authorizing>
                            <NotAuthorized>

                                <ContentWrapper>
                                    <AccessDenied />
                                </ContentWrapper>

                            </NotAuthorized>
                        </AuthorizeRouteView>
                    </CascadingValue>
                </Found>
                <NotFound>

                    <LayoutView Layout="@typeof(AdminLayout)">
                        <Mars.Admin.Shared.DevErrors.Error404 />
                    </LayoutView>

                </NotFound>
            </Router>
            <AuthorizeView>
                <Mars.Admin.Framework.AdminSharedContainer />
                <Mars.SemanticKernel.Front.Components.MarsAITools.AIToolsContainer />
                <Mars.AiChat.Front.Components.AiChatContainer />
            </AuthorizeView>
        </CascadingAuthenticationState>
    </div>
}
else
{
    <ContentWrapper>
        <div class="h-100 xcenter">
            <SharedLoader1 />
        </div>
    </ContentWrapper>
}

<FluentProviders />
