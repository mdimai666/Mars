@page "/builder/styledesigner"
@using Mars.Admin.Contracts.Options
@using Mars.Options.Contracts.Dto.Options;
@using Microsoft.FluentUI.AspNetCore.Components
@using System.Text.Json
@inject IThemeService ThemeService

<ContentWrapper Title="Style Designer">
    <div class="row">
        <div class="col-9">
            <div class="me-4">
                <h5>Components</h5>
                <FluentCard>
                    @* JS-тема (SetThemeToElementAsync) пишет полный набор токенов inline на внешний div;
                       геометрия стайлера — на внутренний: он ближе к компонентам и перебивает
                       унаследованные JS-дефолты radius/shadow/stroke. *@
                    <div @ref="previewElement">
                    <div style="@PreviewStyle">

                        <FluentStack VerticalGap="20" Orientation="@Orientation.Vertical">

                            <h4>Buttons</h4>

                            <FluentStack HorizontalGap="10" Wrap>
                                <FluentButton>Button</FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Primary">Accent</FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Transparent">Lightweight</FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Outline">Outline</FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Subtle">Stealth</FluentButton>
                                <FluentButton IconStart="@(new Icons.Regular.Size16.ArrowClockwise())"
                                              Appearance="ButtonAppearance.Primary">
                                    Refresh
                                </FluentButton>
                                <FluentButton Loading="@true" Appearance="ButtonAppearance.Primary">Loading</FluentButton>
                            </FluentStack>

                            <StyleSampleForm />

                            <h4>Card</h4>

                            <FluentCard Width="400px">
                                <p>Just some content in a card (with a button that does not do anything).</p>
                                <FluentButton Appearance="ButtonAppearance.Primary">Hello</FluentButton>
                            </FluentCard>

                            <h4>Typography</h4>

                            <div class="card card-body">
                                <FluentText Size="TextSize.Size300"> Example 'Body' label </FluentText>
                                <FluentText Size="TextSize.Size400"> Example 'Subject' label </FluentText>
                                <FluentText Size="TextSize.Size500"> Example 'Header' label </FluentText>
                                <FluentText Size="TextSize.Size600"> Example 'PaneHeader' label </FluentText>
                                <FluentText Size="TextSize.Size700"> Example 'EmailHeader' label </FluentText>
                                <FluentText Size="TextSize.Size800"> Example 'PageTitle' label </FluentText>
                                <FluentText Size="TextSize.Size900"> Example 'HeroTitle' label </FluentText>
                                <FluentText As="TextTag.H1" Size="TextSize.Size800"> Example 'H1' label </FluentText>
                                <FluentText As="TextTag.H2" Size="TextSize.Size700"> Example 'H2' label </FluentText>
                                <FluentText As="TextTag.H3" Size="TextSize.Size600"> Example 'H3' label </FluentText>
                                <FluentText As="TextTag.H4" Size="TextSize.Size500"> Example 'H4' label </FluentText>
                                <FluentText As="TextTag.H5" Size="TextSize.Size400"> Example 'H5' label </FluentText>
                                <FluentText As="TextTag.H6" Size="TextSize.Size300"> Example 'H6' label </FluentText>
                            </div>

                        </FluentStack>

                    </div>
                    </div>
                </FluentCard>
            </div>
        </div>
        <div class="col-3">
            <div class="ms-4 sticky-top" style="top:100px">
                <h5>Control</h5>
                <EditOptionForm @ref=form TModel="DevAdminStyleOption" OnLoadData="OnLoadData" AfterSave="AfterSave">

                    <FluentButton OnClick="ResetStyle">Reset</FluentButton>

                    <div class="d-block" style="min-height:300px">

                        <div>
                            <label>BrandColor</label>
                            <input type="color" @bind-value=@context.StylerStyle.BrandColor @bind-value:event="oninput" @bind-value:after="PreviewThemeAsync" />
                        </div>
                        <div>
                            <label>Mode</label>
                            <select class="form-select" @bind=@context.StylerStyle.Mode @bind:after="PreviewThemeAsync">
                                <option>Light</option>
                                <option>Dark</option>
                                <option>System</option>
                            </select>
                        </div>
                        <div>
                            <label>IsExact</label>
                            <FluentSwitch @bind-Value=@context.StylerStyle.IsExact @bind-Value:after="PreviewThemeAsync" />
                        </div>
                        <div>
                            <FluentSlider TValue="double" Label="HueTorsion" Min="-0.5" Max="0.5" Step="0.05" @bind-Value=@context.StylerStyle.HueTorsion @bind-Value:after="PreviewThemeAsync" />
                            <FluentSlider TValue="double" Label="Vibrancy" Min="-0.5" Max="0.5" Step="0.05" @bind-Value=@context.StylerStyle.Vibrancy @bind-Value:after="PreviewThemeAsync" />
                        </div>

                        <div>
                            <FluentSlider TValue="int" Label="Radius" Min="0" Max="12" Step="1" @bind-Value=@context.StylerStyle.Radius @bind-Value:after="PreviewThemeAsync" />
                            <FluentSlider TValue="int" Label="StrokeWidth" Min="1" Max="3" Step="1" @bind-Value=@context.StylerStyle.StrokeWidth @bind-Value:after="PreviewThemeAsync" />
                            <FluentSlider TValue="double" Label="ShadowIntensity" Min="0" Max="2" Step="0.1" @bind-Value=@context.StylerStyle.ShadowIntensity @bind-Value:after="PreviewThemeAsync" />
                        </div>

                    </div>
                </EditOptionForm>
            </div>
        </div>
    </div>
</ContentWrapper>

@code {
    EditOptionForm<DevAdminStyleOption>? form;

    ElementReference previewElement;

    string PreviewStyle => form?.Model is null ? "" : StylerCssVars.PreviewVars(form.Model.StylerStyle);

    // Скоуп-превью: тема применяется только к контейнеру компонентов, глобальная — после Save.
    async Task PreviewThemeAsync()
    {
        if (form?.Model is null) return;
        var s = form.Model.StylerStyle;
        var mode = Enum.TryParse<ThemeMode>(s.Mode, true, out var m) ? m : ThemeMode.System;
        await ThemeService.SetThemeToElementAsync(previewElement, new ThemeSettings(s.BrandColor, s.HueTorsion, s.Vibrancy, mode, s.IsExact));
    }

    async Task ResetStyle()
    {
        form!.Model.StylerStyle = new();
        await PreviewThemeAsync();
    }

    void OnLoadData()
    {
        // EditOptionForm._model стартует как new() (не null) и грузится асинхронно,
        // поэтому тему превью надо применять ЗДЕСЬ (реальная модель готова), а не по
        // firstRender — иначе превью залипает на дефолтном BrandColor до первого контроля.
        StateHasChanged();
        _ = PreviewThemeAsync();
    }

    void AfterSave(DevAdminStyleOption value)
    {
        var key = value.GetType().Name;
        var opt = new OptionSummaryResponse
        {
            Key = key,
            Type = value.GetType().FullName!,
            Value = JsonSerializer.Serialize(value)
        };
        Q.Site.Options = [.. Q.Site.Options.Where(s => s.Key != key), opt];

        Q.Root.Emit("App.SetupTheme");
    }
}
