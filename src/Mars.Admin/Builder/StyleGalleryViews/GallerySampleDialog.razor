@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody Class="text-start">
    <TitleTemplate>
        <FluentText Size="TextSize.Size500">@(Dialog.Options.Header.Title ?? "Диалог")</FluentText>
    </TitleTemplate>
    <ChildContent>
        <div class="vstack gap-2">
            <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">
                Диалог открыт через DialogServiceCompatExtensions.ShowDialogAsync&lt;T&gt; (шим v4-вызовов поверх v5).
            </FluentMessageBar>
            <FluentText>@Content</FluentText>
        </div>
    </ChildContent>
    <ActionTemplate>
        <div class="d-flex justify-content-end gap-2">
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OkAsync">OK</FluentButton>
            <FluentButton OnClick="CancelAsync">Отмена</FluentButton>
        </div>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public string Content { get; set; } = default!;

    Task OkAsync() => Dialog.CloseAsync($"OK ({Content})");

    Task CancelAsync() => Dialog.CancelAsync();
}
