@using Mars.Core.Extensions
@using Mars.Media.Contracts.Files

<div class="cloudy-tile @(File.IsImage || File.IsSvg ? "cloudy-tile--image" : "cloudy-tile--file") @(Selected ? "cloudy-tile--selected" : null)"
     id="@(Selectable ? null : $"media-file-{File.Id}")" title="@File.Name" @onclick="() => OnClick.InvokeAsync(File)">
    @if (!Selectable)
    {
        <div class="cloudy-tile__actions" @onclick:stopPropagation="true">
            <button type="button" class="cloudy-tile__action" title="Move to folder" @onclick="() => OnMove.InvokeAsync(File)">
                <i class="bi bi-folder-symlink"></i>
            </button>
            <button type="button" class="cloudy-tile__action" title="Delete" @onclick="() => OnDelete.InvokeAsync(File)">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    }
    @if (MultiSelect)
    {
        <span class="cloudy-tile__check @(Selected ? "on" : null)">
            <i class="bi bi-check-lg"></i>
        </span>
    }
    @if ((File.IsImage || File.IsSvg) && !Selectable)
    {
        <a class="cloudy-tile__open spotlight" href="@File.Url" data-media="image" data-title="@File.Name">
            @Thumb
            <span class="cloudy-tile__name">@File.Name</span>
        </a>
    }
    else if (File.IsImage || File.IsSvg)
    {
        <div class="cloudy-tile__open">
            @Thumb
            <span class="cloudy-tile__name">@File.Name</span>
        </div>
    }
    else
    {
        <div class="cloudy-tile__open">
            <i class="bi @(MediaTextPreview.IsPreviewable(File) ? "bi-filetype-txt" : "bi-file-earmark") cloudy-tile__icon"></i>
            <span class="cloudy-tile__name">@File.Name</span>
        </div>
    }
    <span class="cloudy-tile__meta">@File.Size.ToHumanizedSize()</span>
</div>

@code {
    [Parameter] public FileListItemResponse File { get; set; } = default!;

    /// <summary>Select-режим: клик = выбор файла (без spotlight и hover-действий).</summary>
    [Parameter] public bool Selectable { get; set; }
    [Parameter] public bool MultiSelect { get; set; }
    [Parameter] public bool Selected { get; set; }

    [Parameter] public EventCallback<FileListItemResponse> OnClick { get; set; }
    [Parameter] public EventCallback<FileListItemResponse> OnMove { get; set; }
    [Parameter] public EventCallback<FileListItemResponse> OnDelete { get; set; }

    RenderFragment Thumb =>
        @<text>
            @if (!string.IsNullOrEmpty(File.PreviewIcon))
            {
                <img class="cloudy-tile__thumb" src="@File.PreviewIcon" alt="@File.Name" loading="lazy" />
            }
            else
            {
                <i class="bi bi-file-image cloudy-tile__icon"></i>
            }
        </text>;
}
