@using Mars.Cms.Contracts.MetaFields
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody>
    <ChildContent>
        <d-post-image-select-dialog>
            <div class="vstack gap-2">
                <FluentButton Class="w-100" Appearance="ButtonAppearance.Primary" OnClick="@(() => Dialog.CloseAsync(CreateNewMarker))">
                    Создать новое поле «@FeatureFieldsCatalog.PostImageFieldKey»
                </FluentButton>

                @foreach (var option in Content.Options)
                {
                    var item = option;
                    <FluentButton Class="w-100" Appearance="ButtonAppearance.Default" OnClick="@(() => Dialog.CloseAsync(item.Key))">
                        @item.Title <span class="text-secondary">(@item.Key)</span>
                    </FluentButton>
                }
            </div>
        </d-post-image-select-dialog>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Default" OnClick="CancelAsync">@AppRes.Cancel</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    /// <summary>Результат-маркер: создать новое поле фичи</summary>
    public const string CreateNewMarker = "__create_new__";

    [CascadingParameter] public IDialogInstance Dialog { get; set; } = default!;

    [Parameter] public PostImageSelectDialogData Content { get; set; } = default!;

    Task CancelAsync() => Dialog.CancelAsync();
}
