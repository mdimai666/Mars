@using Mars.Admin.Pages.PostsViews.Forms
@using Mars.Forms.Front

@* Автор поста: только чтение — пикера пользователя пока нет *@

<div class="text-secondary">@(Author)</div>

@code {
    [CascadingParameter] public PostFormContext Context { get; set; } = default!;

    [Parameter] public FormFieldBinding Binding { get; set; } = default!;
    [Parameter] public int Index { get; set; } = -1;

    string Author
    {
        get
        {
            var author = Context.Post.Author;
            return string.IsNullOrWhiteSpace(author?.DisplayName)
                ? author?.UserName ?? "—"
                : author!.DisplayName!;
        }
    }
}
