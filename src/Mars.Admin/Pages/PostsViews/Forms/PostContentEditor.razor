@using System.Text.Json
@using EditorJsBlazored
@using EditorJsBlazored.Blocks
@using EditorJsBlazored.Core
@using Mars.AiChat.Front.Services
@using Mars.Cms.Contracts.MetaFields
@using Mars.Forms.Front
@using Microsoft.FluentUI.AspNetCore.Components
@using MarsCodeEditor2
@implements IDisposable

@* Тяжёлые редакторы слота контента — общие редакторы поля формы: ветку выбирает ключ
   редактора (WYSIWYG, код, блочный), значение пишется через привязку. WYSIWYG и код отдают
   его при коммите перед сохранением (FormCommitHooks), блочный — сразу. Обычный текст (ключ не
   задан) рисует встроенный редактор типа, поэтому сюда не попадает. *@

@if (EditorKey == MetaFieldEditorCatalog.Wysiwyg)
{
    <WysiwygEditor @ref=_wysiwyg Content="@Content" />
}
else if (EditorKey == MetaFieldEditorCatalog.Code)
{
    <div>
        <div class="text-end mb-1">
            <FluentSelect Value="@(string.IsNullOrEmpty(_lang) ? CodeLang : _lang)"
                          TOption="string"
                          Style="width: 180px;"
                          Items="CodeEditor2.Language.Array"
                          ValueChanged="v => { _lang = v; _code?.SetModelLanguage(v); }">
            </FluentSelect>
        </div>

        <MarsCodeEditor2.CodeEditor2 @ref=_code
                                     Lang=@(string.IsNullOrEmpty(_lang) ? CodeLang : _lang)
                                     OnSave="OnCodeEditorSave"
                                     Value="@Content" />
        <HandlebarsHintsText />
    </div>
}
else if (EditorKey == MetaFieldEditorCatalog.BlockEditor)
{
    <div class="text-end">
        <FluentButton id="@_blockMenuButtonId"
                      Appearance="Appearance.Stealth"
                      @onclick="@(() => _blockMenuOpen = !_blockMenuOpen)">
            Действия
            <span slot="end">
                <i class="bi bi-chevron-down"></i>
            </span>
        </FluentButton>
    </div>

    <FluentMenu Anchor="@_blockMenuButtonId" @bind-Open="_blockMenuOpen">
        <FluentMenuItem Label="@AppRes.Clear" OnClick=@((e) => _block?.Clear()) />
        <FluentMenuItem Label="AI suggest" OnClick=@(() => aiTool.Open()) />
    </FluentMenu>

    <EditorJsBlazored.BlockEditor1 @bind-ContentJson=Content
                                   @ref=_block
                                   OnImageFileRequest="OnImageFileRequest"
                                   OnAttachmentFileRequest="OnImageFileRequest" />
}

@code {
    [Parameter, EditorRequired] public FormFieldBinding Binding { get; set; } = default!;

    [CascadingParameter] public PostFormContext Context { get; set; } = default!;

    [Inject] IAppMediaService mediaService { get; set; } = default!;
    [Inject] IAIToolAppService aiTool { get; set; } = default!;

    WysiwygEditor? _wysiwyg;
    CodeEditor2? _code;
    BlockEditor1? _block;

    /// <summary>Значение слота — в модели поста. Блочный редактор пишет сразу (<c>@bind</c>),
    /// WYSIWYG и код отдают значение при коммите: пока печатают, модель не трогается.</summary>
    string Content
    {
        get => Binding.Value as string ?? "";
        set => Binding.Value = value;
    }

    string _lang = "";
    readonly string _blockMenuButtonId = "blockEditorMenuButton-" + Guid.NewGuid();
    bool _blockMenuOpen;

    string EditorKey => Binding.Editor ?? "";

    /// <summary>Язык редактора кода: из параметров слота (<c>Options.codeLang</c>) — тот же ключ, что у метаполя</summary>
    string CodeLang => Binding.Field.Options.GetCodeLang();

    protected override void OnInitialized()
    {
        Context.ContentHolder.Current = this;
        Context.Commits.Register(CommitAsync);
    }

    /// <summary>Забрать значение тяжёлого редактора в модель (форма вызывает перед сохранением)</summary>
    public async Task CommitAsync()
    {
        if (_wysiwyg is not null) Content = await _wysiwyg.GetHTML();
        else if (_code is not null) Content = await _code.GetValue();
    }

    /// <summary>Запись значения инструментом ИИ; возвращает текст ошибки или null.
    /// Обычный текст правит встроенный редактор типа — сюда такой ключ не приходит.</summary>
    public async Task<string?> TrySetContentAsync(string value)
    {
        if (EditorKey == MetaFieldEditorCatalog.Wysiwyg)
            return "Изменение WYSIWYG-контента агентом пока не поддерживается. Предложите пользователю отредактировать текст вручную.";

        if (EditorKey == MetaFieldEditorCatalog.BlockEditor)
        {
            if (_block is null) return "Редактор блоков ещё не инициализирован.";

            var json = BuildBlockEditorJson(value);
            _block.Content = EditorJsContent.FromJson(json);
            await _block.SetContent();
            Content = json; // страховка, если JS onChange запаздывает
            return null;
        }

        if (_code is null) return "Редактор кода ещё не инициализирован.";

        await _code.SetValue(value);
        Content = value;
        return null;
    }

    Task OnCodeEditorSave(string value)
    {
        Content = value;
        return Context.ContentHolder.RequestSave?.Invoke() ?? Task.CompletedTask;
    }

    async Task<BlockImage.ImageFileData?> OnImageFileRequest()
    {
        var mediaFile = await mediaService.OpenSelectMedia();

        if (mediaFile is null) return null;

        return new BlockImage.ImageFileData
        {
            Url = mediaFile.Url,
            FileName = mediaFile.Name,
            Size = (long)mediaFile.Size,
        };
    }

    /// <summary>Editor.js JSON из обычного текста: каждая непустая строка — абзац</summary>
    static string BuildBlockEditorJson(string text)
    {
        var blocks = text.Split('\n')
            .Select(line => line.Trim())
            .Where(line => line.Length > 0)
            .Select(line => new { type = "paragraph", data = new { text = line } })
            .Cast<object>()
            .ToList();

        if (blocks.Count == 0)
            blocks.Add(new { type = "paragraph", data = new { text = "" } });

        return JsonSerializer.Serialize(new
        {
            time = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
            blocks,
            version = "2.31.0",
        }, JsonOptions);
    }

    static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = false };

    public void Dispose()
    {
        Context.Commits.Unregister(CommitAsync);
        if (ReferenceEquals(Context.ContentHolder.Current, this)) Context.ContentHolder.Current = null;
        _code?.Dispose();
    }
}
