@using Mars.Admin.Framework.Components.MetaFieldViews
@using Mars.Cms.Contracts.MetaFields
@using Mars.Forms.Contracts
@using Mars.Forms.Front

@* Лист дерева формы поста: контент — свой редактор (пять веток тяжёлых редакторов и мост
   ИИ-агента), всё остальное — общий рендерер слоя Mars.Forms; редакторы значений метаполей
   зарегистрированы в общем реестре (MetaFormEditors), поэтому ветвления по происхождению
   поля здесь больше нет. *@

@if (IsContent)
{
    <PostContentEditor Holder="@Holder" />
}
else
{
    <FormFieldRow Item="@Item" />
}

@code {
    [CascadingParameter] public PostContentEditorHolder Holder { get; set; } = default!;

    [Parameter, EditorRequired] public FormItem Item { get; set; } = default!;

    bool IsContent => Item.Field?.Options.GetFeatureKey() == FeatureFieldsCatalog.Content;
}
