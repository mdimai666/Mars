@using Mars.Admin.Pages.PostsViews.Forms
@using Mars.Forms.Front

@* Зона формы поста: каскадирует мета-контекст (значения + определения полей) и контекст формы
   (модель, хуки записи, редактор контента), затем рендерит свою часть дерева. *@

<CascadingValue Value="@Context.Meta">
    <CascadingValue Value="@Context">
        <FormRenderer Definition="@Context.Definition" Values="@Context.Values" Commits="@Context.Commits"
                      Zone="@Zone" TitleResolver="@TitleResolver">
            <FieldTemplate Context="item">
                <PostFormField Item="@item" />
            </FieldTemplate>
        </FormRenderer>
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter, EditorRequired] public PostFormContext Context { get; set; } = default!;

    /// <summary>Ключ зоны из <c>SystemFieldsCatalog.Zones</c></summary>
    [Parameter, EditorRequired] public string Zone { get; set; } = default!;

    [Parameter] public Func<string, string>? TitleResolver { get; set; }
}
