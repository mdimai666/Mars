@using Mars.Admin.Pages.PostCategoryViews
@using Mars.Contracts.Interfaces
@using Microsoft.FluentUI.AspNetCore.Components
@using Mars.Contracts.MetaFields;
@using Mars.Contracts.Posts;
@using Mars.Contracts.PostTypes;

@inject IAIToolAppService _aiTool

<d-manage-post-view class="flex-fill d-flex flex-column">
    @if (!string.IsNullOrEmpty(PostType.Presentation.ListViewTemplate))
    {
        var source = PostType.Presentation.ListViewTemplate;
        <Mars.Admin.Framework.Pages.RemotePageViewer Url=@($"/api/AdminFront/Render?file={Uri.EscapeDataString(source)}") />
    }
    else
    {
        <div class="hstack gap-1">
            <FluentSearch @bind-Value=_searchText
                          @bind-Value:after=HandleSearchInput
                          Immediate
                          ImmediateDelay="300"
                          Appearance="FluentInputAppearance.Filled"
                          AriaLabel="Search" />
            <FluentButton aria-label="refresh" IconEnd="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="Refresh" />
            <FluentButton aria-label="filters" Title="Фильтры"
                          Appearance="@(_filtersVisible ? Appearance.Accent : Appearance.Neutral)"
                          IconEnd="@(new Icons.Regular.Size16.Filter())"
                          OnClick="ToggleFilters" />
            <FluentButton aria-label="grid settings" Title="Настроить колонки"
                          IconEnd="@(new Icons.Regular.Size16.Settings())"
                          OnClick="OpenSettingsDialog" />
            @if (PostType.EnabledFeatures.Contains(PostTypeConstants.Features.Category))
            {
                <SelectCategoryForFilterDropDown @bind-Value="_filterCategoryId"
                                                 @bind-Value:after=HandleCategoryFilterChanged
                                                 PostType="@PostType.TypeName"
                                                 Style="height:32px;"
                                                 Width="150px" />
            }
            <div class="ms-auto hstack gap-2">
                <FluentButton OnClick="@(e => _aiTool.Open(text: "покажи список доступных инструментов", scenarioName: "cms_agent"))">
                    <i class="bi bi-stars"></i>
                    AI help
                </FluentButton>
                <a href="@urlEditPage/@PostType.TypeName">
                    <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.Add())">@AppRes.Create</FluentButton>
                </a>
            </div>
        </div>

        @if (_filtersVisible)
        {
            <ManagePostFiltersPanel @ref="_filtersPanel"
                                    @key="PostType.TypeName"
                                    Columns="_filterColumns"
                                    MetaFields="_metaFields"
                                    PostStatuses="_postStatuses"
                                    Changed="Refresh" />
        }

        <div class="mt-4 flex-fill d-flex flex-column">
            <div style="height: 534px; overflow:auto; flex: 1 1 auto;">
                <FluentDataGrid ItemsProvider="dataProvider"
                                @ref=table
                                @key="_gridVersion"
                                ItemSize="76"
                                Virtualize
                                GridTemplateColumns="@GridTemplateColumns"
                                GenerateHeader="GenerateHeaderOption.Sticky"
                                OverscanCount="10"
                                Class="data-table--adaptive"
                                TGridItem="PostListItemResponse">
                    @foreach (var col in _columns)
                    {
                        @switch (col.Kind)
                        {
                            case GridColumnKind.Title:
                                <TemplateColumn SortBy="@(GridSort<PostListItemResponse>.ByDescending(f => f.Title))"
                                                Title="@col.Title"
                                                Sortable="true"
                                                IsDefaultSortColumn="@col.IsDefaultSort"
                                                InitialSortDirection="@col.DefaultSortDirection">
                                    <div class="position-relative d-block d-lg-none">
                                        <div class="fs-6">@context.Title</div>
                                        <div class="hstack gap-4">
                                            <div class="text-secondary small">@context.CreatedAt.ToString("d")</div>
                                            @if (PostType.EnabledFeatures.Contains(PostTypeConstants.Features.Tags))
                                            {
                                                <FluentOverflow Style="width: 100%;">
                                                    @foreach (var tag in context.Tags)
                                                    {
                                                        <FluentOverflowItem><FluentBadge>@tag</FluentBadge></FluentOverflowItem>
                                                    }
                                                </FluentOverflow>
                                            }
                                        </div>
                                        <a href="@urlEditPage/@PostType.TypeName/@context.Id" class="stretched-link"></a>
                                    </div>
                                    <div class="position-relative d-none d-lg-block">
                                        <div class="">
                                            <div class="fs-6">
                                                <a href="@urlEditPage/@PostType.TypeName/@context.Id">
                                                    @context.Title
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    @if (PostType.EnabledFeatures.Contains(PostTypeConstants.Features.Tags))
                                    {
                                        <div class="mt-1">
                                            <FluentOverflow Style="width: 100%;">
                                                @foreach (var tag in context.Tags)
                                                {
                                                    <FluentOverflowItem><FluentBadge>@tag</FluentBadge></FluentOverflowItem>
                                                }
                                            </FluentOverflow>
                                        </div>
                                    }
                                </TemplateColumn>
                                break;

                            case GridColumnKind.Categories:
                                <TemplateColumn Title="@col.Title"
                                                SortBy="@(GridSort<PostListItemResponse>.ByDescending(f => f.Categories))"
                                                Sortable="true"
                                                IsDefaultSortColumn="@col.IsDefaultSort"
                                                InitialSortDirection="@col.DefaultSortDirection">
                                    <FluentOverflow Style="width: 100%;">
                                        @foreach (var cat in context.Categories ?? [])
                                        {
                                            <FluentOverflowItem>
                                                <FluentBadge OnClick="@(() => ClickPostItemCategory(cat.Id))">@cat.Title</FluentBadge>
                                            </FluentOverflowItem>
                                        }
                                    </FluentOverflow>
                                </TemplateColumn>
                                break;

                            case GridColumnKind.Status:
                                <TemplateColumn Title="@col.Title"
                                                SortBy="@(GridSort<PostListItemResponse>.ByDescending(f => f.Status))"
                                                Sortable="true"
                                                IsDefaultSortColumn="@col.IsDefaultSort"
                                                InitialSortDirection="@col.DefaultSortDirection">
                                    @context.Status?.Value
                                </TemplateColumn>
                                break;

                            case GridColumnKind.Author:
                                <TemplateColumn Title="@col.Title"
                                                SortBy="@(GridSort<PostListItemResponse>.ByDescending(f => f.Author))"
                                                Sortable="true"
                                                IsDefaultSortColumn="@col.IsDefaultSort"
                                                InitialSortDirection="@col.DefaultSortDirection">
                                    @context.Author.UserName
                                </TemplateColumn>
                                break;

                            case GridColumnKind.CreatedAt:
                                <PropertyColumn Property=@(f => f.CreatedAt)
                                                Title="@col.Title"
                                                Format="d"
                                                IsDefaultSortColumn="@col.IsDefaultSort"
                                                InitialSortDirection="@col.DefaultSortDirection"
                                                Sortable="true" Align="Align.End" />
                                break;

                            case GridColumnKind.Meta:
                                <TemplateColumn Title="@col.Title" Sortable="false">
                                    @if (IsImageMetaColumn(col.Key))
                                    {
                                        var url = FirstOf(MetaDisplay(context, col.Key));
                                        @if (!string.IsNullOrEmpty(url))
                                        {
                                            <img src="@url" alt="" class="d-manage-post-thumb" />
                                        }
                                    }
                                    else
                                    {
                                        @MetaDisplay(context, col.Key)
                                    }
                                </TemplateColumn>
                                break;
                        }
                    }
                    <TemplateColumn Title="@AppRes.Actions" Align="@Align.End">
                        <div class="hstack">
                            <DFluentDeleteButton OnConfirm=@(e => Delete(context.Id))>
                                <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                            </DFluentDeleteButton>
                        </div>
                    </TemplateColumn>
                </FluentDataGrid>
            </div>
            <br />
            <div class="hstack">
                <TotalResultsFound TotalCount="@data.TotalCount" />
                <div class="ms-auto">
                </div>
            </div>
        </div>
    }

    <FluentDialog Hidden="@(!_settingsDialogVisible)" aria-label="grid settings dialog"
                  Modal=true
                  Width="520"
                  PreventScroll=true
                  @ondialogdismiss="CancelSettingsDialog">
        <FluentDialogHeader ShowDismiss="false" ShowDismissTooltip="false">
            <FluentLabel Typo="Typography.Header">Колонки списка</FluentLabel>
        </FluentDialogHeader>
        <FluentDialogBody>
            <PostTypeGridSettingsEditor @bind-Value="_gridDraft"
                                        EnabledFeatures="PostType.EnabledFeatures"
                                        MetaFields="_metaFields" />
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton OnClick="CancelSettingsDialog">@AppRes.Cancel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="SaveSettingsAsync">@AppRes.Save</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
</d-manage-post-view>

<style>
    .d-manage-post-thumb {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 4px;
    }
</style>
