@using Mars.Identity.Contracts.Roles
@using Mars.Identity.Contracts.UserTypes
@using Microsoft.FluentUI.AspNetCore.Components
@inject IMarsWebApiClient client

<FluentDialog @ref=Dialog aria-label="Create user dialog"
              Modal=true
              Class="CreateUserModal"
              OnStateChange="@(e => { if (e.State == DialogState.Closed) { Visible = false; _dialogShown = false; } })">
    <FluentDialogBody>
        <TitleTemplate>
            <div class="hstack">
                <FluentLabel Typo="Typography.Header">@AppRes.Create</FluentLabel>
            </div>
        </TitleTemplate>
        <ChildContent>
            <StandardEditForm1 TModel="CreateUserModel"
                               @ref=_editForm1
                               GetAction="@(()=>Task.FromResult(model))"
                               AfterSave="AfterSave"
                               SaveAction="@((model, isCreate)=>CreateUserModel.SaveAction(client, model, isCreate))">

                <FormItem2 For="() => model.UserName">
                    <FluentTextInput @bind-Value="model.UserName" AutoComplete="off" />
                </FormItem2>

                <FormItem2 For="() => model.FirstName">
                    <FluentTextInput @bind-Value="model.FirstName" AutoComplete="off" />
                </FormItem2>

                <FormItem2 For="() => model.LastName">
                    <FluentTextInput @bind-Value="model.LastName" AutoComplete="off" />
                </FormItem2>

                <FormItem2 For="() => model.Email">
                    <FluentTextInput @bind-Value="model.Email" TextInputType="@TextInputType.Email" AutoComplete="no" />
                </FormItem2>

                <FormItem2 For="() => model.Password">
                    <div class="hstack gap-2">
                        <FluentTextInput @bind-Value="model.Password" TextInputType="@passwordFieldType" AutoComplete="new-password" />
                        <FluentButton OnClick="TogglePassword" IconStart="@passwordShowButtonIcon" Title="show password" />
                        <FluentButton OnClick="GeneratePassword" IconStart="@(new Icons.Regular.Size16.Password())" Title="generate password" />
                    </div>
                </FormItem2>

                <FormItem2 For="() => model.Type">
                    <FluentSelect TOption="UserTypeListItemResponse" TValue="UserTypeListItemResponse"
                                  Items="@Content.UserTypes"
                                  OptionText="@(s=>s.Title)"
                                  Placeholder="user type"
                                  @bind-Value="@SelUserType" />
                </FormItem2>

                <FormItem2 For="() => model.Roles">
                    <FluentAutocomplete TOption="RoleSummaryResponse" TValue="RoleSummaryResponse"
                                        Items="@Content.Roles"
                                        OptionText="@(s=>s.Name)"
                                        Placeholder="Select"
                                        IconSearch="@(new Icons.Regular.Size16.PersonQuestionMark())"
                                        @bind-SelectedItems="@SelRoles" />
                </FormItem2>
            </StandardEditForm1>
        </ChildContent>
    </FluentDialogBody>
</FluentDialog>
