@page "/Users"
@using Mars.Admin.Pages.Settings
@inject IStringLocalizer<AppRes> L
@using Mars.Identity.Contracts.Users
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@attribute [Authorize(Roles = "Admin")]
@attribute [Display(Name = "Пользователи")]
@attribute [DParentPage(typeof(SettingsPage))]
@layout AdminLayout

<ContentWrapper Title="@AppRes.Users">

    <div class="hstack">
        <FluentTextInput @bind-Value=_searchText
                      @bind-Value:after=HandleSearchInput
                      Immediate
                      ImmediateDelay="300"
                      Appearance="TextInputAppearance.FilledDarker"
                      AriaLabel="Search" />
        <div class="ms-auto">
            <FluentButton Appearance="ButtonAppearance.Primary"
                          OnClick="OnClickCreateUser"
                          IconStart="@(new Icons.Regular.Size16.Add())">@AppRes.Create</FluentButton>
            @* <a href="@urlEditPage">
                <FluentButton IconStart="@(new Icons.Regular.Size16.Add())">@AppRes.Create</FluentButton>
            </a> *@
        </div>
    </div>

    <div class="mt-4">
        <div style="height: 534px; overflow:auto;">
            <FluentDataGrid ItemsProvider="dataProvider"
                            @ref=table
                            ItemSize="46"
                            Virtualize
                            ShowHover="false"
                            GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                            OnRowClick="OnRowClick"
                            GridTemplateColumns="2fr 2fr 1fr 1fr 1fr"
                            Class="data-table--adaptive"
                            TGridItem="UserDetailResponse">
                <TemplateColumn SortBy="@(GridSort<UserDetailResponse>.ByDescending(f => f.LastName))"
                                Title="FullName"
                                InitialSortDirection="DataGridSortDirection.Ascending"
                                IsDefaultSortColumn="true"
                                Sortable="true">
                    <div class="vstack">
                        <a href="@urlEditPage/@context.Id" class="text-primary">
                            <FluentAvatar Name="@context.FullName"
                                          Image="@context.AvatarUrl"
                                          Size="AvatarSize.Size32" />
                        </a>
                    </div>
                </TemplateColumn>
                <PropertyColumn Property="@(f => f.Email)" Title="@AppRes.Email" Sortable="true" />
                <TemplateColumn SortBy="@(GridSort<UserDetailResponse>.ByDescending(f => f.Roles))"
                                Sortable="false"
                                Title="@AppRes.Roles"
                                Filtered="_roleFilter.Any()">
                    <ChildContent>
                        <FluentOverflow TItem="string" Style="width: 100%;">
                            @foreach (var role in context.Roles)
                            {
                                <FluentBadge>@role</FluentBadge>
                            }
                        </FluentOverflow>
                    </ChildContent>
                    <ColumnOptions>
                        <div class="search-box">
                            <FluentAutocomplete TOption="string" TValue="string"
                                                Label="@AppRes.Roles"
                                                Items="@_availRoles.Select(s=>s.Name)"
                                                Placeholder="Select"
                                                IconSearch="@(new Icons.Regular.Size16.PersonQuestionMark())"
                                                ValueChanged="HandleSearchInput"
                                                @bind-SelectedItems="@_roleFilter" />
                        </div>
                    </ColumnOptions>
                </TemplateColumn>
                <PropertyColumn Property="@(f => f.CreatedAt)" Title="@AppRes.CreatedAt" Format="d" Sortable="true" />
                <TemplateColumn Title="@AppRes.Actions" Align="DataGridCellAlignment.End">
                    <div class="hstack">
                        <DFluentDeleteButton OnConfirm=@(e => Delete(context.Id))>
                            <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                        </DFluentDeleteButton>
                        <FluentButton Id="@($"useractions-{context.Id}")" Appearance="ButtonAppearance.Subtle">@AppRes.Action</FluentButton>
                        <FluentMenu Trigger="@($"useractions-{context.Id}")" OnClick="@(e => OnUserMenuClick(e, context))">
                            <FluentMenuItem Id="changepassword">@AppRes.ChangePassword</FluentMenuItem>
                            <FluentMenuItem Id="sendinvitation">send invation</FluentMenuItem>
                        </FluentMenu>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
        </div>
        <br />
        <div class="hstack">
            <TotalResultsFound TotalCount="@data.TotalCount" />
        </div>
    </div>

    <CreateUserModal @bind-Visible="visibleCreateUserModal" Content="createFormData" AfterCreate="HandleSearchInput" />
    <ChangePasswordModal @bind-Visible="visibleChangeUserPasswordModal" Content="changeUserPasswordFormData" />

</ContentWrapper>
