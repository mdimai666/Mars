@page "/Users"
@using Mars.Admin.Pages.Settings
@using Mars.Admin.Shared.Cloudy
@inject IStringLocalizer<AppRes> L
@using Mars.Identity.Contracts.Users
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@attribute [Authorize(Roles = "Admin")]
@attribute [Display(Name = "Пользователи")]
@attribute [DParentPage(typeof(SettingsPage))]

<CloudyPageHead Title="@AppRes.Users" Subtitle="Manage accounts, roles and access." KpiCols="2">
    <Kpis>
        <CloudyKpi Label="@KpiLabel(UserKpiKeys.Total)" Value="@KpiValue(UserKpiKeys.Total)" Icon="bi-people" />
        <CloudyKpi Label="@KpiLabel(UserKpiKeys.NewThisMonth)" Value="@KpiValue(UserKpiKeys.NewThisMonth)" Icon="bi-person-plus" />
    </Kpis>
</CloudyPageHead>

<CloudyBrowser Scrollable>
    <HeadLeft>
        <CloudyChips Items="RoleNames" Selected="_roleFilter" SelectedChanged="SetRoleFilter" />
    </HeadLeft>
    <HeadRight>
        <CloudySearchBox Placeholder="Search users…" ValueChanged="OnSearchChanged" />
        <button type="button" class="cloudy-btn-primary" @onclick="OnClickCreateUser">@AppRes.Create</button>
    </HeadRight>

    <ChildContent>
        <FluentDataGrid TGridItem="UserDetailResponse"
                        @ref="_grid"
                        ItemsProvider="_dataProvider"
                        Virtualize
                        ItemSize="67"
                        GridTemplateColumns="minmax(0,1fr) minmax(120px,150px) 120px 92px"
                        GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                        OverscanCount="10"
                        Class="cloudy-grid">
            <ChildContent>
            <TemplateColumn Title="Member" Sortable="true"
                            SortBy="@(GridSort<UserDetailResponse>.ByAscending(p => p.LastName))">
                <div class="cloudy-grid-member">
                    <CloudyAvatar Name="@context.FullName" ImageUrl="@context.AvatarUrl" Tint="@TintFor(context.Id)" />
                    <div class="cloudy-stack">
                        <a class="cloudy-stack__title" href="@urlEditPage/@context.Id" title="@context.FullName">@context.FullName</a>
                        <span class="cloudy-stack__sub" title="@context.Email">@context.Email</span>
                    </div>
                </div>
            </TemplateColumn>
            <TemplateColumn Title="@AppRes.Roles">
                <div class="cloudy-tags">
                    @foreach (var r in context.Roles.Take(2))
                    {
                        <CloudyTag Text="@r" Tint="@RoleTint(r)" />
                    }
                    @if (context.Roles.Count > 2)
                    {
                        <CloudyTag Text="@($"+{context.Roles.Count - 2}")" Muted />
                    }
                </div>
            </TemplateColumn>
            <TemplateColumn Title="@AppRes.CreatedAt" Sortable="true"
                            SortBy="@(GridSort<UserDetailResponse>.ByDescending(p => p.CreatedAt))"
                            IsDefaultSortColumn="true" Align="DataGridCellAlignment.End">
                <time class="cloudy-time" title="@context.CreatedAt.ToString("g")">@context.CreatedAt.ToString("dd.MM.yy")</time>
            </TemplateColumn>
            <TemplateColumn Align="DataGridCellAlignment.End">
                <div class="cloudy-row-actions">
                    <DFluentDeleteButton OnConfirm=@(e => Delete(context.Id))>
                        <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                    </DFluentDeleteButton>
                    <FluentButton Id="@($"useractions-{context.Id}")" Appearance="ButtonAppearance.Subtle"
                                  IconStart="@(new Icons.Regular.Size20.MoreHorizontal())"
                                  aria-label="More actions" />
                    <FluentMenu Trigger="@($"useractions-{context.Id}")" OnClick="@(e => OnUserMenuClick(e, context))">
                        <FluentMenuList>
                            <FluentMenuItem Id="changepassword">@AppRes.ChangePassword</FluentMenuItem>
                            <FluentMenuItem Id="sendinvitation">send invation</FluentMenuItem>
                        </FluentMenuList>
                    </FluentMenu>
                </div>
            </TemplateColumn>
            </ChildContent>
            <EmptyContent>
                <p class="cloudy-empty">No users match your search.</p>
            </EmptyContent>
        </FluentDataGrid>
    </ChildContent>

    <Foot>
        <TotalResultsFound TotalCount="@_total" />
    </Foot>
</CloudyBrowser>
