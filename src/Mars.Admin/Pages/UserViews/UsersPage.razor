@page "/Users"
@using Mars.Admin.Pages.Settings
@inject IStringLocalizer<AppRes> L
@using Mars.Identity.Contracts.Users
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@attribute [Authorize(Roles = "Admin")]
@attribute [Display(Name = "Пользователи")]
@attribute [DParentPage(typeof(SettingsPage))]

<CloudyPageHead Title="@AppRes.Users" Subtitle="Manage accounts, roles and access." KpiCols="2">
    <Kpis>
        <CloudyKpi Label="Total users" Value="@Fmt(_totalAll)" Icon="bi-people" />
        <CloudyKpi Label="New this month" Value="@Fmt(_newThisMonth)" Icon="bi-person-plus" />
    </Kpis>
</CloudyPageHead>

<CloudyBrowser>
    <HeadLeft>
        <CloudyChips Items="RoleNames" Selected="_roleFilter" SelectedChanged="SetRoleFilter" />
    </HeadLeft>
    <HeadRight>
        <CloudySearchBox Placeholder="Search users…" ValueChanged="OnSearchChanged" />
        <button type="button" class="cloudy-btn-primary" @onclick="OnClickCreateUser">@AppRes.Create</button>
    </HeadRight>

    <ChildContent>
        <div class="cloudy-list users-list">
            <div class="cloudy-list__head">
                <span></span>
                <span>Member</span>
                <span>@AppRes.Roles</span>
                <span class="u-hide-1100">@AppRes.CreatedAt</span>
                <span></span>
            </div>

            @if (_users.Count > 0)
            {
                <ul class="cloudy-list__items">
                    @{
                        var idx = 0;
                    }
                    @foreach (var user in _users)
                    {
                        var rowIdx = idx++;
                        <li class="cloudy-list__row">
                            <CloudyAvatar Name="@user.FullName" ImageUrl="@user.AvatarUrl" Tint="@rowIdx" />
                            <div class="cloudy-stack">
                                <a class="cloudy-stack__title" href="@urlEditPage/@user.Id" title="@user.FullName">@user.FullName</a>
                                <span class="cloudy-stack__sub" title="@user.Email">@user.Email</span>
                            </div>
                            <div class="cloudy-tags u-hide-900">
                                @foreach (var r in user.Roles.Take(2))
                                {
                                    <CloudyTag Text="@r" Tint="@RoleTint(r)" />
                                }
                                @if (user.Roles.Count > 2)
                                {
                                    <CloudyTag Text="@($"+{user.Roles.Count - 2}")" Muted />
                                }
                            </div>
                            <time class="cloudy-time u-hide-1100" title="@user.CreatedAt.ToString("g")">@user.CreatedAt.ToString("dd.MM.yy")</time>
                            <div class="cloudy-row-actions">
                                <DFluentDeleteButton OnConfirm=@(e => Delete(user.Id))>
                                    <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                                </DFluentDeleteButton>
                                <FluentButton Id="@($"useractions-{user.Id}")" Appearance="ButtonAppearance.Subtle"
                                              IconStart="@(new Icons.Regular.Size20.MoreHorizontal())"
                                              aria-label="More actions" />
                                <FluentMenu Trigger="@($"useractions-{user.Id}")" OnClick="@(e => OnUserMenuClick(e, user))">
                                    <FluentMenuList>
                                        <FluentMenuItem Id="changepassword">@AppRes.ChangePassword</FluentMenuItem>
                                        <FluentMenuItem Id="sendinvitation">send invation</FluentMenuItem>
                                    </FluentMenuList>
                                </FluentMenu>
                            </div>
                        </li>
                    }
                </ul>
            }
            else if (_loaded)
            {
                <p class="cloudy-empty">No users match your search.</p>
            }
        </div>
    </ChildContent>

    <Foot>
        <TotalResultsFound TotalCount="@_total" />
        <CloudyPager Skip="_skip" Total="_total" PageSize="PageSize" SkipChanged="OnSkipChanged" />
    </Foot>
</CloudyBrowser>

<CreateUserModal @bind-Visible="visibleCreateUserModal" Content="createFormData" AfterCreate="HandleSearchInput" />
<ChangePasswordModal @bind-Visible="visibleChangeUserPasswordModal" Content="changeUserPasswordFormData" />
