@using Mars.Admin.Pages.PostsViews
@using Mars.Admin.Framework.Services
@using Microsoft.FluentUI.AspNetCore.Components

@if (_visible)
{
    <div class="d-child-post-drawer-backdrop" @onclick="Close"></div>
    <div class="d-child-post-drawer">
        <div class="d-child-post-drawer__header d-flex align-items-center px-3 py-2">
            <div class="flex-fill fz18px">@(_postId == Guid.Empty ? "Новый объект" : "Редактирование объекта")</div>
            <FluentButton Appearance="Appearance.Stealth" OnClick="Close">
                <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" />
            </FluentButton>
        </div>
        <div class="d-child-post-drawer__body">
            <EditPostView @key="_drawerKey" ID="@_postId" PostTypeName="@_postTypeName" OnSaved="OnSaved" NavigateAfterCreate="false" />
        </div>
    </div>
}

<style>
    /* пока дровер открыт, все модалки/пикеры (медиа, выбор связей) — поверх него */
    fluent-dialog {
        z-index: 1100 !important;
    }

    .d-child-post-drawer-backdrop {
        position: fixed;
        inset: 0;
        background: var(--mars-bg-overlay, rgba(0,0,0,.35));
        z-index: 1040;
    }

    .d-child-post-drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(1000px, 95vw);
        background: var(--mars-bg-surface, #fff);
        z-index: 1041;
        display: flex;
        flex-direction: column;
        box-shadow: -8px 0 24px rgba(0,0,0,.25);
    }

    .d-child-post-drawer__header {
        border-bottom: 1px solid var(--mars-border, rgba(128,128,128,.25));
    }

    .d-child-post-drawer__body {
        flex: 1;
        overflow-y: auto;
        padding: 12px 16px;
    }
</style>

@code {
    bool _visible;
    Guid _postId;
    string _postTypeName = "";
    Action<Guid>? _onSaved;
    string _drawerKey = "";

    protected override void OnInitialized()
    {
        ChildPostEditorService.Opener = Show;
    }

    public void Show(Guid postId, string postTypeName, Action<Guid>? onSaved)
    {
        _postId = postId;
        _postTypeName = postTypeName;
        _onSaved = onSaved;
        _drawerKey = Guid.NewGuid().ToString("N");
        _visible = true;
        StateHasChanged();
    }

    void Close()
    {
        _visible = false;
        _onSaved = null;
        StateHasChanged();
    }

    void OnSaved(PostEditModel model)
    {
        var callback = _onSaved;
        _visible = false;
        _onSaved = null;
        callback?.Invoke(model.Id);
        StateHasChanged();
    }
}
