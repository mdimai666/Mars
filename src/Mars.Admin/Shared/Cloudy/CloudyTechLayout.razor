@using Microsoft.FluentUI.AspNetCore.Components
@using Mars.Admin.Shared.ActionCenter
@inherits LayoutComponentBase

<AuthorizeView Roles="Admin">
    <Authorized>
        <CascadingValue Value=this>
            <div class="cloudy-tech">
                <div class="cloudy-tech-backdrop" aria-hidden="true"></div>

                <CloudyTechTopBar />

                <div class="cloudy-tech-body">
                    <CloudyTechSideBar />

                    <main class="cloudy-tech-page">
                        @Body
                    </main>
                </div>

                <CloudyTechDock />
            </div>

            <ActionCenter />
        </CascadingValue>
    </Authorized>
    <Authorizing>
        <SharedLoader1 />
    </Authorizing>
    <NotAuthorized>
        <div class="cloudy-tech">
            <AccessDenied />
        </div>
    </NotAuthorized>
</AuthorizeView>
<AuthorizeView>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>
