@using Microsoft.FluentUI.AspNetCore.Components
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using System.Web
@using Mars.Admin.Contracts.Options
@using Mars.Admin.Framework.Features
@using Mars.Options.Contracts.Dto.Options

@if (Q.User is null || !Q.User.IsAuth)
{
    <ul class="navbar-nav navbar-nav-right flex-row">

        <li class="nav-item d-flex">
            <a class="nav-link btn btn-outline-light px-4 cursor-pointer" href="/dev/login">Вход</a>
        </li>

        @if (Q.Site.SiteSettings.AllowUsersSelfRegister)
        {
            <li class="nav-item d-flex ms-2">
                <a class="nav-link btn btn-outline-light px-4 cursor-pointer" href="/Register">Регистрация</a>
            </li>
        }

    </ul>
}
else
{
    <div class="dropdown cloudy-userbar">
        <a type="button" class="cloudy-userbar__trigger" data-bs-toggle="dropdown" aria-expanded="false" title="@Q.User.Email">
            <FluentAvatar Initials="@Q.User.Initials()"
                          Image="@Q.User.AvatarUrl"
                          Color="AvatarColor.Brand"
                          Size="AvatarSize.Size40" />
        </a>
        <div class="dropdown-menu dropdown-menu-end cloudy-user-menu">
            <a class="cloudy-user-menu__item" href="EditUser/@Q.User.Id">Профиль</a>
            <a class="cloudy-user-menu__item" href="/dev/ApiKeys">API-ключи</a>
            <a class="cloudy-user-menu__item" href="/dev/Passkeys">Пасскеи</a>

            @if (Q.User.IsAdmin)
            {
                <a class="cloudy-user-menu__item" href="/dev/builder">Builder</a>
            }

            <a class="cloudy-user-menu__item" href="#" @onclick="ToggleTheme" @onclick:preventDefault>
                @(isDark ? "Светлая тема" : "Тёмная тема")
            </a>

            <div class="cloudy-user-menu__sep"></div>
            <a class="cloudy-user-menu__item cloudy-user-menu__item--danger" href="/dev/logout">Выйти</a>
        </div>
    </div>
}

@code {
    [Inject] IMarsWebApiClient client { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    bool isDark;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Q.Root.On(Q.User.GetType(), EmitTypeMode.All, OnUpdateProfile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isDark = await JS.InvokeAsync<bool>("marsIsDarkTheme");
            StateHasChanged();
        }
    }

    void OnUpdateProfile()
    {
        StateHasChanged();
    }

    async Task ToggleTheme()
    {
        var opt = Q.Site.GetOption<DevAdminStyleOption>() ?? new DevAdminStyleOption();
        opt.StylerStyle.Mode = isDark ? "Light" : "Dark";

        await client.Option.SaveOption(opt).SmartSave();

        var key = nameof(DevAdminStyleOption);
        var summary = new OptionSummaryResponse
        {
            Key = key,
            Type = typeof(DevAdminStyleOption).FullName!,
            Value = JsonSerializer.Serialize(opt)
        };
        Q.Site.Options = [.. Q.Site.Options.Where(s => s.Key != key), summary];

        isDark = !isDark;
        Q.Root.Emit("App.SetupTheme");
    }
}
