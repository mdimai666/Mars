@using Mars.Cms.Contracts.PostTypes
@using Mars.WebApiClient.Interfaces
@using Mars.XActions.Contracts
@using Microsoft.FluentUI.AspNetCore.Components

@inject Mars.Admin.Framework.Interfaces.IMessageService _messageService
@inject IMarsWebApiClient _client
@inject NavigationManager _navigationManager

@* Кастомная форма экшена «Перегенерировать значения полей-генераторов»:
    тип поста → статусы этого типа (мультивыбор), режим перенумерации.
    Перекрывает генерик-форму по схеме (реестр IXActionFormProvider). *@

<FluentDialogBody Class="text-start">
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" Gap="12">
            <FluentSelect TOption="PostTypeListItemResponse" TValue="PostTypeListItemResponse" Label="Тип записи"
                          Items="_postTypes" OptionText="@(t => t.Title)"
                          Value="_selectedType" ValueChanged="@(v => OnTypeChanged(v))" Class="w-100" />

            <FluentSelect TOption="string" TValue="string" Label="Режим" Value="_mode" ValueChanged="@(v => _mode = v)" Class="w-100">
                <FluentOption TValue="string" Value="@("all")">Перенумеровать с первого</FluentOption>
                <FluentOption TValue="string" Value="@("today")">Перенумеровать за сегодня</FluentOption>
                <FluentOption TValue="string" Value="@("fromLast")">Дозаполнить пустые (продолжить с последнего)</FluentOption>
            </FluentSelect>

            @if (_statuses.Count > 0)
            {
                <div class="vstack">
                    <FluentText>Статусы <span class="text-secondary small">(ничего не отмечено — все)</span></FluentText>
                    @foreach (var status in _statuses)
                    {
                        <FluentCheckbox Label="@status.Title" Value="@_selectedStatuses.Contains(status.Slug)"
                                        ValueChanged="@(v => ToggleStatus(status.Slug, v))" />
                    }
                </div>
            }
        </FluentStack>
    </ChildContent>
    <ActionTemplate>
        <div class="hstack gap-2 justify-content-end">
            <FluentButton Appearance="ButtonAppearance.Default" @onclick="Cancel">Отмена</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="Submit" Disabled="@(_selectedType is null)">Выполнить</FluentButton>
        </div>
    </ActionTemplate>
</FluentDialogBody>

@code {
    /// <summary>Id экшена (совпадает с RegenerateGeneratedMetaValuesAct.CommandId в Mars.WebApp)</summary>
    public const string CommandId = "mars.content.regenerateGeneratedMetaValues";

    [Parameter]
    public XActionCommand Content { get; set; } = default!;

    [CascadingParameter]
    public IDialogInstance? Dialog { get; set; }

    List<PostTypeListItemResponse> _postTypes = [];
    PostTypeListItemResponse? _selectedType;
    string _mode = "all";
    List<PostStatusResponse> _statuses = [];
    readonly HashSet<string> _selectedStatuses = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var list = await _client.PostType.List(new ListPostTypeQueryRequest());
            _postTypes = list.Items.ToList();
        }
        catch (Exception ex)
        {
            _ = _messageService.Error($"не удалось загрузить типы записей: {ex.Message}");
            return;
        }

        // предвыбор типа со страницы списка постов (/dev/Post/{тип})
        var segments = _navigationManager.ToBaseRelativePath(_navigationManager.Uri)
                                         .Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length >= 2 && segments[0].Equals("Post", StringComparison.OrdinalIgnoreCase))
        {
            _selectedType = _postTypes.FirstOrDefault(t => t.TypeName == segments[1]);
            if (_selectedType is not null) await LoadStatusesAsync(_selectedType.Id);
        }
    }

    async Task OnTypeChanged(PostTypeListItemResponse? type)
    {
        _selectedType = type;
        _selectedStatuses.Clear();
        if (type is null)
        {
            _statuses = [];
            return;
        }
        await LoadStatusesAsync(type.Id);
    }

    async Task LoadStatusesAsync(Guid postTypeId)
    {
        try
        {
            var detail = await _client.PostType.Get(postTypeId);
            _statuses = detail?.PostStatusList.OrderBy(s => s.Order).ToList() ?? [];
        }
        catch (Exception ex)
        {
            _ = _messageService.Error($"не удалось загрузить статусы: {ex.Message}");
            _statuses = [];
        }
    }

    void ToggleStatus(string slug, bool isChecked)
    {
        if (isChecked) _selectedStatuses.Add(slug);
        else _selectedStatuses.Remove(slug);
    }

    void Cancel() => Dialog?.CancelAsync();

    void Submit()
    {
        if (_selectedType is null) return;

        Dialog?.CloseAsync(new Dictionary<string, string>
        {
            ["postType"] = _selectedType.TypeName,
            ["mode"] = _mode,
            ["statuses"] = string.Join(',', _selectedStatuses),
        });
    }
}
