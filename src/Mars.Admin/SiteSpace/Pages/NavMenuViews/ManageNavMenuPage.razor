@page "/NavMenu"
@using Mars.Cms.Contracts.NavMenus
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components

@attribute [Authorize(Roles = "Admin")]

<CloudyPageHead Title="@AppRes.NavMenus" Subtitle="Site navigation menus." />

<CloudyBrowser Scrollable>
    <HeadRight>
        <CloudySearchBox Placeholder="Search menus…" ValueChanged="OnSearchChanged" />
        <a class="cloudy-btn-primary" href="@urlEditPage">@AppRes.Create</a>
    </HeadRight>

    <ChildContent>
        <FluentDataGrid TGridItem="NavMenuSummaryResponse"
                        @ref="_grid"
                        ItemsProvider="_dataProvider"
                        Virtualize
                        ItemSize="67"
                        GridTemplateColumns="minmax(0,2fr) minmax(0,1.5fr) 172px 56px"
                        GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                        OverscanCount="10"
                        Class="cloudy-grid">
            <ChildContent>
                <TemplateColumn Title="@AppRes.Title" Sortable="true"
                                SortBy="@(GridSort<NavMenuSummaryResponse>.ByAscending(f => f.Title))">
                    <div class="cloudy-stack">
                        <a class="cloudy-stack__title" href="@urlEditPage/@context.Id" title="@context.Title">@context.Title</a>
                        <span class="cloudy-stack__sub" title="@context.Slug">@context.Slug</span>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="@AppRes.Tags">
                    <div class="cloudy-tags">
                        @foreach (var tag in context.Tags)
                        {
                            <CloudyTag Text="@tag" Tint="@tag.StableTint()" />
                        }
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="@AppRes.CreatedAt" Sortable="true"
                                SortBy="@(GridSort<NavMenuSummaryResponse>.ByDescending(f => f.CreatedAt))"
                                IsDefaultSortColumn="true"
                                Align="DataGridCellAlignment.End">
                    <time class="cloudy-time" title="@context.CreatedAt.ToString("g")">@context.CreatedAt.FormatTime()</time>
                </TemplateColumn>
                <TemplateColumn Align="DataGridCellAlignment.End">
                    <div class="cloudy-row-actions">
                        <DFluentDeleteButton OnConfirm=@(e => Delete(context.Id))>
                            <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                        </DFluentDeleteButton>
                    </div>
                </TemplateColumn>
            </ChildContent>
            <EmptyContent>
                <p class="cloudy-empty">No menus match your search.</p>
            </EmptyContent>
        </FluentDataGrid>
    </ChildContent>

    <Foot>
        <TotalResultsFound TotalCount="@_total" />
    </Foot>
</CloudyBrowser>
