@page "/Plugins"
@attribute [Authorize(Roles = "Admin")]

@using Mars.Cms.Contracts.Feedbacks
@using Mars.Plugin.Contracts.Plugins
@using Microsoft.FluentUI.AspNetCore.Components

<ContentWrapper Title="@AppRes.Plugins" WrapperClass="vstack">
    <SectionActions>
        <XActionsDropDown>
            <FluentMenuItem Label="Upload from zip-file" OnClick="OnClickUploadFromZipFile" />
            <FluentMenuItem Label="Install from NuGet" OnClick="OnClickInstallFromNuget" />
            <FluentMenuItem Label="Маркетплейс" OnClick="OnClickMarketplace" />
        </XActionsDropDown>
    </SectionActions>
    <ChildContent>

        <div class="hstack">
            <FluentTextInput @bind-Value=_searchText
                          @bind-Value:after=HandleSearchInput
                          Immediate
                          ImmediateDelay="300"
                          Appearance="TextInputAppearance.FilledDarker"
                          AriaLabel="Search">
                <StartTemplate>
                    <FluentIcon Value="@(new Icons.Regular.Size16.Search())" />
                </StartTemplate>
            </FluentTextInput>
            <FluentSpacer />
        </div>

        <div class="mt-4 vstack flex-fill">
            <div class="flex-fill" style="height: 534px; overflow:auto;">
                <FluentDataGrid ItemsProvider="dataProvider"
                                @ref=table
                                ItemSize="100"
                                Virtualize
                                EmptyContent="DataGrid_EmptyContent"
                                GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                                OnRowClick="OnRowClick"
                                GridTemplateColumns="* 0.1fr 0.1fr"
                                TGridItem="PluginInfoResponse">
                    <TemplateColumn SortBy="@(GridSort<PluginInfoResponse>.ByDescending(f => f.Title))"
                                    Title="@AppRes.Title"
                                    Sortable="true">
                        <div class="hstack">
                            <div class="plugin_icon " style="flex: 0 0 80px; height:80px;">
                                @if (context.PackageIconUrl != null)
                                {
                                    <img src="@context.PackageIconUrl" alt="icon" style="object-fit:contain;width:64px;height:64px;" />
                                }
                                else
                                {
                                    <i class="bi bi-plugin text-secondary p-2 d-inline-block" style="font-size:48px;"></i>
                                }
                            </div>
                            <div class="vstack">
                                <FluentText Size="TextSize.Size500">@context.Title</FluentText>
                                <div class="hstack gap-2">
                                    <label class="text-secondary">@context.PackageId</label>
                                    @if (!string.IsNullOrEmpty(context.RepositoryUrl))
                                    {
                                        <div class="vr"></div>
                                        <a class="text-black" href="@context.RepositoryUrl" target="_blank">
                                            <i class="bi bi-github"></i>
                                        </a>
                                    }
                                    <div class="vr"></div>
                                    <FluentRatingDisplay Max="5" Value="0"
                                                          Style="zoom:0.5"
                                                          Color="@RatingDisplayColor.Neutral" />
                                </div>
                                <div class="d-flex gap-3">
                                    <FluentText Color="Color.Default">@context.Version</FluentText>
                                    <div class="__tags d-flex gap-1">
                                        @foreach (var tag in context.PackageTags)
                                        {
                                            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Informative">
                                                @tag
                                            </FluentBadge>
                                        }
                                    </div>
                                </div>
                                <div class="mt-1" title="@context.Description">
                                    @context.Description?.TextEllipsis(100)
                                </div>
                                <div class="hstack gap-2 mt-2">
                                    @if (context.Locked)
                                    {
                                        <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning">Locked (config)</FluentBadge>
                                    }
                                    else
                                    {
                                        <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Informative">
                                            @(context.Source == PluginSource.NuGet ? "NuGet" : "Zip")
                                        </FluentBadge>
                                    }
                                    @if (context.PendingDelete)
                                    {
                                        <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning">Will be removed on restart</FluentBadge>
                                    }
                                    else if (context.Enabled)
                                    {
                                        <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Enabled</FluentBadge>
                                    }
                                    else
                                    {
                                        <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Informative">Disabled</FluentBadge>
                                    }
                                </div>
                            </div>
                        </div>
                    </TemplateColumn>
                    <TemplateColumn SortBy="@(GridSort<PluginInfoResponse>.ByDescending(f => f.InstalledAt))"
                                    Title="Installed at"
                                    InitialSortDirection="DataGridSortDirection.Descending"
                                    IsDefaultSortColumn="true"
                                    Sortable="true"
                                    Tooltip
                                    TooltipText="@(f => f.InstalledAt.LocalDateTime.ToString())"
                                    Align="DataGridCellAlignment.End">
                        @context.InstalledAt.ToString("d")
                    </TemplateColumn>
                    <TemplateColumn Title="@AppRes.Actions" Align="DataGridCellAlignment.End">
                        <div class="hstack gap-2">
                            <FluentButton Appearance="ButtonAppearance.Transparent" Disabled="@(context.Locked || context.PendingDelete)" OnClick="@((MouseEventArgs e) => ToggleEnabled(context))">
                                @(context.Enabled ? "Disable" : "Enable")
                            </FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Transparent" Disabled="@(context.Locked || context.Source != PluginSource.NuGet)" OnClick="@((MouseEventArgs e) => Update(context))">
                                Update
                            </FluentButton>
                            <DFluentDeleteButton OnConfirm=@(e => Delete(context)) Disabled="@(context.Locked || context.PendingDelete)" />
                        </div>
                    </TemplateColumn>
                    @*
                <div class="card shadow">
                    <div class="card-body">
                        <h3 class="fw-bold fz20px" title="@plugin.AssemblyName">@plugin.Title</h3>
                        <div>@plugin.Version</div>
                        <div class="text-secondary">@plugin.Description</div>
                    </div>
                </div>
                *@

                </FluentDataGrid>
            </div>
            <br />
            <div class="hstack">
                <TotalResultsFound TotalCount="@data.TotalCount" />
            </div>
        </div>
    </ChildContent>
</ContentWrapper>
