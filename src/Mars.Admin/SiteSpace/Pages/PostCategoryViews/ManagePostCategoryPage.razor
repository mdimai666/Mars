@page "/PostCategory"
@page "/PostCategory/{POSTTYPE}"
@using Mars.Admin.SiteSpace.Pages.PostTypeViews
@using Mars.Cms.Contracts.PostCategories
@using Microsoft.FluentUI.AspNetCore.Components
@inject IStringLocalizer<AppRes> L
@attribute [Authorize(Roles = "Admin")]

<div class="flex-fill d-flex flex-column">
    <div class="container mb-3">
        <NavbarEditPostType ID="postType.Id" />
    </div>

    <CloudyPageHead Title="@postType.Title" Subtitle="Organize posts into hierarchical categories." KpiCols="1">
        <Kpis>
            <CloudyKpi Label="@KpiLabel(PostCategoryKpiKeys.TotalFor(postType.TypeName))"
                       Value="@KpiValue(PostCategoryKpiKeys.TotalFor(postType.TypeName))"
                       Icon="bi-folder2-open" />
        </Kpis>
    </CloudyPageHead>

    <CloudyBrowser Scrollable HideActionsButton="true">
        <HeadLeft>
            <CloudySearchBox Placeholder="Search categories…" ValueChanged="OnSearchChanged" />
        </HeadLeft>
        <HeadRight>
            <button type="button" class="cloudy-icon-btn" title="Обновить" @onclick="Refresh">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <XActionsDropDown ContextPart="@postType.TypeName" />
            <a class="cloudy-btn-primary" href="@urlEditPage/@postType.TypeName">@AppRes.Create</a>
        </HeadRight>

        <ChildContent>
            <FluentDataGrid TGridItem="PostCategoryListItemResponse"
                            ItemsProvider="_dataProvider"
                            @ref="_grid"
                            ItemSize="67"
                            Virtualize
                            GridTemplateColumns="minmax(0,3fr) minmax(0,2fr) 172px 56px"
                            GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                            OverscanCount="10"
                            Class="cloudy-grid">
                <ChildContent>
                    <TemplateColumn Title="@AppRes.Title"
                                    SortBy="@(GridSort<PostCategoryListItemResponse>.ByAscending(f => f.SlugPath))"
                                    InitialSortDirection="DataGridSortDirection.Ascending"
                                    IsDefaultSortColumn="true"
                                    Sortable="true">
                        @* отступ иерархии: (LevelsCount-1)*20, как в старом гриде — сохраняет порядок дерева *@
                        <div class="cloudy-stack" style="padding-left:@(IndentPx(context))px">
                            <a class="cloudy-stack__title" href="@urlEditPage/@postType.TypeName/@context.Id" title="@context.Title">@context.Title</a>
                            <span class="cloudy-stack__sub" title="@context.SlugPath">@context.SlugPath</span>
                        </div>
                    </TemplateColumn>
                    <TemplateColumn Title="@AppRes.Tags">
                        <div class="cloudy-tags">
                            @foreach (var tag in context.Tags)
                            {
                                <CloudyTag Text="@tag" Tint="@tag.StableTint()" />
                            }
                        </div>
                    </TemplateColumn>
                    <TemplateColumn Title="@AppRes.CreatedAt"
                                    SortBy="@(GridSort<PostCategoryListItemResponse>.ByDescending(f => f.CreatedAt))"
                                    Sortable="true"
                                    Align="DataGridCellAlignment.End">
                        <time class="cloudy-time" title="@context.CreatedAt.ToString("g")">@context.CreatedAt.FormatTime()</time>
                    </TemplateColumn>
                    <TemplateColumn Title="@AppRes.Actions" Align="DataGridCellAlignment.End">
                        <div class="cloudy-row-actions">
                            <DFluentDeleteButton OnConfirm=@(e => Delete(context.Id))>
                                <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                            </DFluentDeleteButton>
                        </div>
                    </TemplateColumn>
                </ChildContent>
                <EmptyContent>
                    <p class="cloudy-empty">No categories match your search.</p>
                </EmptyContent>
            </FluentDataGrid>
        </ChildContent>

        <Foot>
            <TotalResultsFound TotalCount="@_total" />
        </Foot>
    </CloudyBrowser>
</div>
