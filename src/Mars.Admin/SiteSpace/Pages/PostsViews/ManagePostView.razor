@using Mars.Admin.SiteSpace.Pages.PostCategoryViews
@using Microsoft.FluentUI.AspNetCore.Components
@using Mars.Cms.Contracts.MetaFields;
@using Mars.Cms.Contracts.Posts;
@using Mars.Cms.Contracts.PostTypes;

@if (!string.IsNullOrEmpty(PostType.Presentation.ListViewTemplate))
{
    var source = PostType.Presentation.ListViewTemplate;
    <Mars.Admin.Framework.Pages.RemotePageViewer Url=@($"/api/AdminFront/Render?file={Uri.EscapeDataString(source)}") />
}
else
{
    <CloudyBrowser Scrollable SubHeadVisible="_filtersVisible" HideActionsButton="true">
        <HeadLeft>
            <CloudySearchBox Placeholder="Search posts…" ValueChanged="OnSearchChanged" />

            <button type="button" class="cloudy-icon-btn @(_filtersVisible ? "cloudy-icon-btn--active" : null)"
                    title="Фильтры" @onclick="ToggleFilters">
                <i class="bi bi-funnel"></i>
            </button>
            <button type="button" class="cloudy-icon-btn" title="Настроить колонки" @onclick="OpenSettingsDialog">
                <i class="bi bi-sliders"></i>
            </button>
            <button type="button" class="cloudy-icon-btn" title="Обновить" @onclick="Refresh">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            @if (PostType.EnabledFeatures.Contains(PostTypeConstants.Features.Category))
            {
                <SelectCategoryForFilterDropDown @bind-Value="_filterCategoryId"
                                                 @bind-Value:after=HandleCategoryFilterChanged
                                                 PostType="@PostType.TypeName"
                                                 Width="180px" />
            }
        </HeadLeft>
        <HeadRight>
            <XActionsDropDown ContextPart="@PostType.TypeName" AlsoShowRootContext="true" />
            <a class="cloudy-btn-primary" href="@urlEditPage/@PostType.TypeName">@AppRes.Create</a>
        </HeadRight>
        <SubHead>
            <ManagePostFiltersPanel @ref="_filtersPanel"
                                    @key="PostType.TypeName"
                                    Columns="_filterColumns"
                                    MetaFields="_metaFields"
                                    PostStatuses="_postStatuses"
                                    Changed="Refresh" />
        </SubHead>

        <ChildContent>
            @* v5: DataGrid запоминает ПОРЯДОК РЕГИСТРАЦИИ колонок — рендерим грид только
               когда динамические колонки построены, иначе статичная Actions окажется первой *@
            @if (_gridReady)
            {
                <FluentDataGrid TGridItem="PostListItemResponse"
                                ItemsProvider="dataProvider"
                                @ref=table
                                @key="_gridVersion"
                                ItemSize="76"
                                Virtualize
                                GridTemplateColumns="@GridTemplateColumns"
                                GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                                OverscanCount="10"
                                Class="cloudy-grid">
                    <ChildContent>
                        @foreach (var col in _columns)
                        {
                            @* when col.IsSystem — мета-поле с ключом базовой колонки не подменяет её шаблон *@
                            @switch (col.Key)
                            {
                                case SystemFieldsCatalog.Title when col.IsSystem:
                                    <TemplateColumn SortBy="@(GridSort<PostListItemResponse>.ByDescending(f => f.Title))"
                                                    Title="@col.Title"
                                                    Sortable="true"
                                                    IsDefaultSortColumn="@col.IsDefaultSort"
                                                    InitialSortDirection="@col.DefaultSortDirection">
                                        <div class="cloudy-stack">
                                            <a class="cloudy-stack__title" href="@urlEditPage/@PostType.TypeName/@context.Id" title="@context.Title">@context.Title</a>
                                            @if (PostType.EnabledFeatures.Contains(PostTypeConstants.Features.Tags) && context.Tags.Count > 0)
                                            {
                                                <div class="cloudy-tags">
                                                    @foreach (var tag in context.Tags)
                                                    {
                                                        <CloudyTag Text="@tag" />
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </TemplateColumn>
                                    break;

                                case SystemFieldsCatalog.Categories when col.IsSystem:
                                    <TemplateColumn Title="@col.Title"
                                                    SortBy="@(GridSort<PostListItemResponse>.ByDescending(f => f.Categories))"
                                                    Sortable="true"
                                                    IsDefaultSortColumn="@col.IsDefaultSort"
                                                    InitialSortDirection="@col.DefaultSortDirection">
                                        <div class="cloudy-tags">
                                            @foreach (var cat in context.Categories ?? [])
                                            {
                                                <span style="cursor: pointer;" @onclick="@(() => ClickPostItemCategory(cat.Id))">
                                                    <CloudyTag Text="@cat.Title" />
                                                </span>
                                            }
                                        </div>
                                    </TemplateColumn>
                                    break;

                                case SystemFieldsCatalog.Status when col.IsSystem:
                                    <TemplateColumn Title="@col.Title"
                                                    SortBy="@(GridSort<PostListItemResponse>.ByDescending(f => f.Status))"
                                                    Sortable="true"
                                                    IsDefaultSortColumn="@col.IsDefaultSort"
                                                    InitialSortDirection="@col.DefaultSortDirection">
                                        @if (context.Status is { } status)
                                        {
                                            <div class="cloudy-tags">
                                                <CloudyTag Text="@status.Value" Tint="@CloudyTint.PostStatus(status.Key)" />
                                            </div>
                                        }
                                    </TemplateColumn>
                                    break;

                                case SystemFieldsCatalog.Author when col.IsSystem:
                                    <TemplateColumn Title="@col.Title"
                                                    SortBy="@(GridSort<PostListItemResponse>.ByDescending(f => f.Author))"
                                                    Sortable="true"
                                                    IsDefaultSortColumn="@col.IsDefaultSort"
                                                    InitialSortDirection="@col.DefaultSortDirection">
                                        <div class="cloudy-grid-member">
                                            <CloudyAvatar Name="@AuthorName(context)" Tint="@TintFor(context.Author.Id)"    Title="@AuthorName(context)" />
                                            @* <div class="cloudy-stack">
                                                <span class="cloudy-stack__title" title="@AuthorName(context)">@AuthorName(context)</span>
                                            </div> *@
                                        </div>
                                    </TemplateColumn>
                                    break;

                                case SystemFieldsCatalog.CreatedAt when col.IsSystem:
                                    <TemplateColumn Title="@col.Title"
                                                    SortBy="@(GridSort<PostListItemResponse>.ByDescending(f => f.CreatedAt))"
                                                    Sortable="true"
                                                    IsDefaultSortColumn="@col.IsDefaultSort"
                                                    InitialSortDirection="@col.DefaultSortDirection"
                                                    Align="DataGridCellAlignment.End">
                                        <time class="cloudy-time" title="@context.CreatedAt.ToString("g")">@context.CreatedAt.ToString("dd.MM.yy")</time>
                                    </TemplateColumn>
                                    break;

                                default:
                                    <TemplateColumn Title="@col.Title" Sortable="false">
                                        @if (IsImageMetaColumn(col.Key))
                                        {
                                            var url = FirstOf(MetaDisplay(context, col.Key));
                                            @if (!string.IsNullOrEmpty(url))
                                            {
                                                <img src="@url" alt="" class="manage-post-thumb" />
                                            }
                                        }
                                        else
                                        {
                                            @MetaDisplay(context, col.Key)
                                        }
                                    </TemplateColumn>
                                    break;
                            }
                        }
                        <TemplateColumn Title="@AppRes.Actions" Align="DataGridCellAlignment.End">
                            <div class="cloudy-row-actions">
                                <DFluentDeleteButton OnConfirm=@(e => Delete(context.Id))>
                                    <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                                </DFluentDeleteButton>
                            </div>
                        </TemplateColumn>
                    </ChildContent>
                    <EmptyContent>
                        <p class="cloudy-empty">No posts match your search.</p>
                    </EmptyContent>
                </FluentDataGrid>
            }
        </ChildContent>

        <Foot>
            <TotalResultsFound TotalCount="@_total" />
        </Foot>
    </CloudyBrowser>
}
