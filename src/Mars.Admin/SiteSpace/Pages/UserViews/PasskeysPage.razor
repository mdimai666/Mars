@page "/Profile/Passkeys"
@page "/Passkeys"
@using Mars.Admin.Shared.Cloudy
@using Mars.Identity.Contracts.Passkeys
@using Microsoft.FluentUI.AspNetCore.Components
@attribute [Authorize]
@attribute [Display(Name = "Пасскеи")]

<ProfileNav />

<CloudyPageHead Title="Пасскеи"
                Subtitle="Пасскеи позволяют входить без пароля — через Windows Hello, Touch ID, Face ID или аппаратный ключ безопасности." />

@if (!_passkeysEnabled)
{
    <div class="mb-3">
        <FluentMessageBar Intent="@MessageBarIntent.Warning" AllowDismiss="false">
            Пасскеи отключены администратором.
        </FluentMessageBar>
    </div>
}
else if (!_passkeyAvailable)
{
    <div class="mb-3">
        <FluentMessageBar Intent="@MessageBarIntent.Warning" AllowDismiss="false">
            Браузер не поддерживает WebAuthn — добавление пасскеев недоступно.
        </FluentMessageBar>
    </div>
}

<CloudyBrowser Scrollable HideActionsButton>
    <HeadRight>
        <button type="button" class="cloudy-btn-primary" @onclick="OnClickAdd"
                disabled="@(!_passkeyAvailable || !_passkeysEnabled)">Добавить пасскей</button>
    </HeadRight>

    <ChildContent>
        <FluentDataGrid ItemsProvider="dataProvider"
                        @ref=table
                        TGridItem="PasskeySummaryResponse"
                        ShowHover="false"
                        GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                        GridTemplateColumns="2fr 1fr 1fr auto"
                        Class="cloudy-grid">
            <ChildContent>
            <TemplateColumn Title="Название">
                @(string.IsNullOrWhiteSpace(context.Name) ? "— без названия —" : context.Name)
            </TemplateColumn>
            <PropertyColumn Property="@(f => f.CreatedAt)" Title="Создан" Format="d" />
            <TemplateColumn Title="Резервная копия">
                @(context.IsBackedUp ? "да" : context.IsBackupEligible ? "возможна" : "нет")
            </TemplateColumn>
            <TemplateColumn Title="@AppRes.Actions" Align="DataGridCellAlignment.End">
                <div class="cloudy-row-actions">
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick=@(() => OnClickRename(context)) Title="Переименовать">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" />
                    </FluentButton>
                    <DFluentDeleteButton OnConfirm=@(e => Delete(context.CredentialId))>
                        <FluentIcon Color="Color.Error" Value="@(new Icons.Regular.Size16.Delete())" />
                    </DFluentDeleteButton>
                </div>
            </TemplateColumn>
            </ChildContent>
            <EmptyContent>
                <p class="cloudy-empty">Пасскеев пока нет.</p>
            </EmptyContent>
        </FluentDataGrid>
    </ChildContent>
</CloudyBrowser>

<FluentDialog @ref="_addDialog" aria-label="Add passkey dialog"
              Modal="true"
              OnStateChange="@(e => { if (e.State == DialogState.Closed) { addVisible = false; _addDialogShown = false; } })">
    <FluentDialogBody Class="text-start">
        <TitleTemplate>
            <CloudyDialogHead Title="Новый пасскей" />
        </TitleTemplate>
        <ChildContent>
            <div class="vstack gap-2">
                <FluentTextInput @bind-Value="newName" Label="Название (необязательно)" AutoComplete="off" MaxLength="64" />
                <FluentText>Браузер покажет запрос на создание пасскея (Windows Hello, Touch ID или ключ безопасности).</FluentText>
            </div>
        </ChildContent>
        <ActionTemplate>
            <div class="hstack gap-2 justify-content-end">
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="AddPasskey">Добавить</FluentButton>
                <FluentButton OnClick="@(() => addVisible = false)">Отмена</FluentButton>
            </div>
        </ActionTemplate>
    </FluentDialogBody>
</FluentDialog>

<FluentDialog @ref="_renameDialog" aria-label="Rename passkey dialog"
              Modal="true"
              OnStateChange="@(e => { if (e.State == DialogState.Closed) { renameVisible = false; _renameDialogShown = false; } })">
    <FluentDialogBody Class="text-start">
        <TitleTemplate>
            <CloudyDialogHead Title="Переименовать пасскей" />
        </TitleTemplate>
        <ChildContent>
            <div class="vstack gap-2">
                <FluentTextInput @bind-Value="renameValue" Label="Название" AutoComplete="off" MaxLength="64" />
            </div>
        </ChildContent>
        <ActionTemplate>
            <div class="hstack gap-2 justify-content-end">
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="RenamePasskey">Сохранить</FluentButton>
                <FluentButton OnClick="@(() => renameVisible = false)">Отмена</FluentButton>
            </div>
        </ActionTemplate>
    </FluentDialogBody>
</FluentDialog>
