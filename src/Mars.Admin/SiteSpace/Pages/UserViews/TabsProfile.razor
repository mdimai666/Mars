<div class="TabsProfile">
    <ul class="nav nav-pills Montserrat __nav-fill mt-2 gap-2 p-1 1small rounded-5"
        style="--bs-nav-pills-link-active-color: var(--bs-white);--bs-nav-link-color: var(--bs-black);--bs-nav-pills-link-active-bg: var(--bs-primary);">
        <li class="nav-item">
            <NavLink href=@($"EditUser/{ID}") class="nav-link rounded-5">EditUser</NavLink>
        </li>
        @if (ID == Guid.Empty)
        {
            <li class="nav-item">
                <NavLink href=@($"ApiKeys") class="nav-link rounded-5">ApiKeys</NavLink>
            </li>
            <li class="nav-item">
                <NavLink href=@($"Passkeys") class="nav-link rounded-5">Passkeys</NavLink>
            </li>
        }
    </ul>
    <div class="spacer-1"></div>
</div>

<div class="spacer-1"></div>

@code {
    [CascadingParameter] public Guid ID { get; set; }

    string q => ID == Guid.Empty ? "" : $"/{ID}";
}
