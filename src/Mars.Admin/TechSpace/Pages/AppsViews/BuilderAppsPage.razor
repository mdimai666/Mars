@page "/tech"

<ContentWrapper>
    <div class="spacer-3"></div>
    <section id="apps" class="vstack gap-3">
        @foreach (var category in _items)
        {
            <div class="">
                <h2>@category.Title</h2>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var item in category.Items)
                    {
                        <div class="col">
                            <div class="card d-card-glow">
                                <div class="hstack ms-4">
                                    <div class="vstack flex-grow-0 my-3">
                                        <i class="@item.Icon fs-1 color-accent"></i>
                                    </div>
                                    <div class="card-body">
                                        <h4 class="mb-0">
                                            @item.Title
                                        </h4>
                                        <p class="">@item.Subtitle</p>

                                        <a href="@item.Url" class="stretched-link"></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </section>
    <div class="row">
        <div class="col">
        </div>
    </div>
</ContentWrapper>

@code {
    private record AppMenuItem(string Title, string Url, string Icon, string Subtitle);
    private record AppMenuCategory(string Title, AppMenuItem[] Items);

    private AppMenuCategory[] _items = [
        new("Main", [
            new("Automation", "tech/automation", "bi bi-diagram-2 rotate-n90", "Визуальное программирование"),
            new("Логи", "tech/logs", "bi bi-bug", "Визуальное программирование"),
            new("DevPages", "tech/devtest", "bi bi-ladder", "pages on dev"),
            new("Scheduler", "tech/scheduler", "bi bi-journal-check", "фоновые задачи"),
            new("Style Designer", "tech/styledesigner", "bi bi-brilliance", "fluent design UI edit"),
            new("Plugins", "Plugins", "bi bi-plugin", "list of plugins"),
            new("Маркетплейс", "marketplace", "bi bi-shop", "каталог плагинов"),
            new("Playbooks", "tech/playbooks", "bi bi-file-earmark-code", "functions coding")
        ]),
        new("Users", [
            new("Пользователи", "Users", "bi bi-people", "управление пользователями"),
            new("Типы пользователя", "UserType", "bi bi-person-badge", "настройка ролей"),
        ]),
        new("Other", [
            new("Типы категорий", "PostCategoryType", "bi bi-tags", "категории публикаций"),
            new("Меню навигации", "NavMenu", "bi bi-list-nested", "структура меню")
        ])
    ];

}
