@page "/tech/models/classmodels"
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using System.Reflection
@using Mars.Cms.Contracts.Posts
@using Mars.Server.Contracts.Options

<PageTitle>Class Models</PageTitle>

<div class="classmodels-page">
    <header class="classmodels-page__hero">
        <div class="classmodels-page__hero-text">
            <h1>Class Models</h1>
            <p>
                C# class models registered in the platform — inspect their properties and open
                the source file in the IDE.
            </p>
        </div>
    </header>

    <section class="classmodels-page__section">
        <header class="classmodels-page__section-head">
            <h2>Models</h2>
            <span class="classmodels-page__count">@Models.Count()</span>
            <span class="classmodels-page__line"></span>
        </header>

        <div class="classmodels-page__masonry">
            @foreach (var model in Models)
            {
                <article class="classmodels-page__card">
                    <header class="classmodels-page__card-head">
                        <span class="classmodels-page__name">@model.Name</span>
                        @if (model.ModelType.BaseType is not null)
                        {
                            <span class="classmodels-page__base">: @model.ModelType.BaseType.Name</span>
                        }
                    </header>

                    <a class="classmodels-page__source" href="@model.SourceFilePath"
                       title="Open source file in the IDE"
                       @onclick:preventDefault
                       @onclick="() => OpenModelFile(model)">
                        <i class="bi bi-file-earmark-code"></i>
                        Source file
                    </a>

                    <div class="classmodels-page__props">
                        @foreach (var field in model.Properties.Where(s => s.DeclaringType!.Name == model.ModelType.Name))
                        {
                            @drawField(field, model)
                        }
                    </div>

                    <button class="classmodels-page__nested-toggle" type="button"
                            aria-expanded="@(_expanded.Contains(model.Name) ? "true" : "false")"
                            @onclick="() => ToggleNested(model.Name)">
                        <span>Nested props</span>
                        <i class="bi bi-chevron-down classmodels-page__chevron @(_expanded.Contains(model.Name) ? "classmodels-page__chevron--open" : null)"></i>
                    </button>

                    @if (_expanded.Contains(model.Name))
                    {
                        <div class="classmodels-page__nested">
                            @foreach (var field in model.Properties.Where(s => s.DeclaringType!.Name != model.ModelType.Name))
                            {
                                @drawField(field, model)
                            }
                        </div>
                    }
                </article>
            }
        </div>
    </section>
</div>

@code {
    [Inject] ModelInfoService modelService { get; set; } = default!;
    [Inject] ILogger<ClassModelListPage> _logger { get; set; } = default!;
    [Inject] NavigationManager navigationManager { get; set; } = default!;

    IEnumerable<ModelInfo> Models = new List<ModelInfo>();
    readonly HashSet<string> _expanded = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Models = modelService.ModelList();
    }

    void ToggleNested(string name)
    {
        if (!_expanded.Add(name))
        {
            _expanded.Remove(name);
        }
    }

    void OpenModelFile(ModelInfo model)
    {

        string path = Q.Site.GetOption<ServerWorkDirectoryOption>()?.WorkDirectory ?? "";

        string ff = Path.GetFullPath(Path.Combine(path, model.SourceFilePath));

        ff = Regex.Replace(ff, "/+", "\\");
        ff = Regex.Replace(ff, @"\\{1,}", "\\");
        ff = Regex.Replace(ff, @"\\+", "/");
        ff = ff.Trim('/');

        _logger.LogWarning("ff=" + ff);

        navigationManager.NavigateTo($"vs2026://{ff}");

    }

    RenderFragment drawField(PropertyInfo field, ModelInfo model) => @<div class="classmodels-page__prop">
    <span class="classmodels-page__prop-name">@field.Name</span>
    <MTypeBadge Value=@field.PropertyType />
    @if (field.GetCustomAttributes(true).Count(s => s is RequiredAttribute) > 0)
    {
        <span class="classmodels-page__required" title="required">*</span>
    }
    @if (field.CanWrite == false)
    {
        <span class="classmodels-page__readonly" title="read only">(r)</span>
    }
    @if (field.DeclaringType!.Name != model.ModelType.Name)
    {
        <span class="classmodels-page__declaring">:@field.DeclaringType.Name</span>
    }
</div>;
}
