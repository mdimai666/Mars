@using Mars.Contracts.Resources
@using MarsCodeEditor2
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody Class="text-start">
    <TitleTemplate>
        <FluentLabel Typo="Typography.Header">@(Dialog.Options.Header.Title ?? "Значение ячейки")</FluentLabel>
    </TitleTemplate>
    <ChildContent>
        <div class="ds-cell-dialog">
            <CodeEditor2 @ref="_editor" Lang="@Content.Language" Value="@Content.Value"
                         ContainerCssStyle="height:100%;border:1px solid #dfdfdf;border-radius:4px;overflow:hidden;" />
        </div>
    </ChildContent>
    <ActionTemplate>
        <div class="hstack gap-2 justify-content-end">
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OkAsync">
                @(AppRes.Ok)
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="CancelAsync">
                @(AppRes.Cancel)
            </FluentButton>
        </div>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public CellValueDialogContent Content { get; set; } = default!;

    CodeEditor2? _editor;

    async Task OkAsync()
        => await Dialog.CloseAsync(await _editor!.GetValue());

    Task CancelAsync() => Dialog.CancelAsync();
}
