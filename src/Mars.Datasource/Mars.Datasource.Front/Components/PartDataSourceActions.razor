@using Mars.Datasource
@using Mars.Datasource.Abstractions.Models
@using Mars.Datasource.Dto
@using Mars.Datasource.Front.Services
@using Mars.WebApiClient.Interfaces
@using Microsoft.FluentUI.AspNetCore.Components

@inject IDatasourceServiceClient datasourceService;
@inject NavigationManager nav;
@inject Mars.Admin.Framework.Interfaces.IMessageService messageService

<div class="vstack gap-3">
    <div class="hstack">
        <FluentButton Loading=isTestLoading Disabled=isTestLoading
                      OnClick="ClickTestConnection">Test connection</FluentButton>
    </div>
    <div class="hstack">
        <FluentButton Disabled="@(string.IsNullOrWhiteSpace(Config.Slug) || slugError is not null)"
                      OnClick="OpenQueryTool">
            Query tool
        </FluentButton>
    </div>
    @if (slugError is not null)
    {
        <div class="text-danger fz14px">@slugError</div>
    }
</div>

@code {
    [Parameter]
    public DatasourceConfig Config { get; set; } = default!;

    bool isTestLoading;

    string? slugError => DatasourceConfig.ValidateSlug(Config.Slug);

    void OpenQueryTool()
    {
        nav.NavigateTo($"{nav.BaseUri}datasource/query?slug={Uri.EscapeDataString(Config.Slug)}");
    }

    async Task ClickTestConnection()
    {
        isTestLoading = true;
        StateHasChanged();

        try
        {
            var conn = new ConnectionStringTestDto { Driver = Config.Driver, ConnectionString = Config.ConnectionString };
            var res = await datasourceService.TestConnection(conn);

            if (res.Ok)
            {
                _ = messageService.Success(res.Message);
            }
            else
            {
                _ = messageService.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            _ = messageService.Error(ex.Message);
        }
        finally
        {
            isTestLoading = false;
            StateHasChanged();
        }
    }
}
