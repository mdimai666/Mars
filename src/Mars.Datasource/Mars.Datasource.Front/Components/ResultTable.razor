@using Mars.Datasource.Contracts.Sql

@using Mars.Datasource.Contracts.Catalog
@using Mars.Datasource.Contracts.Config
@using Mars.Datasource.Contracts.Document
@using Mars.Datasource.Contracts.Query
@using Mars.Datasource.Front.Services
@using Microsoft.AspNetCore.Components.Web

<div class="ds-scroll overflow-scroll" @ref="_root">
    <table class="table table-sm table-hover ds-result-table">
        <thead>
            <tr>
                @foreach (var column in Result.Fields)
                {
                    var headerKind = FieldTypeMapping.Kind(column.DataTypeName);

                    <th>
                        @if (column.IsKey)
                        {
                            <i class="bi bi-key-fill text-warning me-1" title="primary key"></i>
                        }
                        <span class="text-nowrap">@column.Name</span>
                        <span class="@(KindClass(headerKind) ?? "ds-type-text") fz14px ms-1">@FieldTypeMapping.ShortTypeName(column.DataTypeName)</span>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @for (var rowIndex = 0; rowIndex < Result.Rows.Length; rowIndex++)
            {
                var row = Result.Rows[rowIndex];
                <tr>
                    @for (var i = 0; i < Result.Fields.Length; i++)
                    {
                        var column = Result.Fields[i];
                        var cell = (Row: rowIndex, Column: column.Name);
                        string? pending = null;
                        var changed = Changes is not null && Changes.TryGetValue(cell, out pending);
                        var value = changed ? pending : i < row.Length ? row[i] : null;
                        var editing = IsEditing(cell);
                        var mid = MidParts(i, value);
                        var kind = FieldTypeMapping.Kind(column.DataTypeName);
                        var cellClass = changed ? "ds-cell-changed" : "";
                        var valueClass = KindClass(kind) ?? "";
                        var display = kind == FieldKind.DateTime ? QueryResultMapping.DisplayDateTime(value) : value;

                        @* rowIndex здесь нельзя: переменная for общая на все итерации, и к моменту
                            клика она равна Rows.Length — ячейка берётся из локального кортежа *@
                        <td class="@cellClass @valueClass"
                            @ondblclick="@(() => OnStartEdit.InvokeAsync(new CellEditRequest(cell.Row, cell.Column, value, kind)))">
                            @if (editing)
                            {
                                <CellEditInput @key="cell" Value="@EditValue" ValueChanged="EditValueChanged"
                                               OnKeyDown="OnEditKeyDown" OnBlur="OnCommitEdit" />
                            }
                            else if (mid is not null)
                            {
                                <span class="ds-mid" data-full="@value" title="@value">
                                    <span class="ds-mid-head">@mid.Value.Head</span><span
                                        class="ds-mid-dots">…</span><span class="ds-mid-tail">@mid.Value.Tail</span>
                                </span>
                            }
                            else if (column.IsJson && value is not null)
                            {
                                <details data-full="@value">
                                    <summary class="fz14px text-secondary" title="показать JSON">json</summary>
                                    <JsonViewer Json="@value" Expanded="0" ShowToolbar="false" />
                                </details>
                            }
                            else if (display != value)
                            {
                                <span class="ds-cell-text" data-full="@value" title="@value">@display</span>
                            }
                            else
                            {
                                <span class="ds-cell-text">@display</span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
