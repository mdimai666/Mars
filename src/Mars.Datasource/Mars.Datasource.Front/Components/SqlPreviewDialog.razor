@using Mars.Datasource.Contracts.Sql

@using Mars.Contracts.Resources
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody Class="text-start">
    <TitleTemplate>
        <FluentText Size="TextSize.Size500">@(Dialog.Options.Header.Title ?? "Изменение данных")</FluentText>
    </TitleTemplate>
    <ChildContent>
        <div class="mb-2 text-secondary fz14px">
            Будут выполнены запросы (значения передаются параметрами, а не подстановкой в текст):
        </div>
        @foreach (var plan in Content)
        {
            <pre class="ds-sql-preview">@plan.Sql</pre>
        }
    </ChildContent>
    <ActionTemplate>
        <div class="hstack gap-2 justify-content-end">
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OkAsync">
                @(AppRes.Ok)
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="CancelAsync">
                @(AppRes.Cancel)
            </FluentButton>
        </div>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public List<SqlUpdatePlan> Content { get; set; } = [];

    private Task OkAsync() => Dialog.CloseAsync();

    private Task CancelAsync() => Dialog.CancelAsync();
}
