@using Mars.Contracts.Resources
@using MarsCodeEditor2
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody Class="text-start">
    <TitleTemplate>
        <FluentLabel Typo="Typography.Header">@(Dialog.Options.Header.Title ?? "Определение вьюхи")</FluentLabel>
    </TitleTemplate>
    <ChildContent>
        @if (string.IsNullOrWhiteSpace(Content.Sql))
        {
            <div class="alert alert-warning mb-0 fz14px">Движок не отдал определение этого объекта.</div>
        }
        else
        {
            <div class="ds-view-definition">
                <CodeEditor2 @ref="_editor" Lang="@CodeEditor2.Language.sql" Value="@Content.Sql"
                             ContainerCssStyle="height:100%;border:1px solid #dfdfdf;border-radius:4px;overflow:hidden;" />
            </div>
        }
    </ChildContent>
    <ActionTemplate>
        <div class="hstack gap-2 justify-content-end">
            <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(string.IsNullOrWhiteSpace(Content.Sql))"
                          OnClick="LoadToEditorAsync">
                В редактор
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="CloseAsync">
                @AppRes.Cancel
            </FluentButton>
        </div>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public ViewDefinitionDialogContent Content { get; set; } = default!;

    CodeEditor2? _editor;

    /// <summary>
    /// Закрытие с текстом: рабочая область положит его в редактор, чтобы вьюху можно было поправить.
    /// </summary>
    async Task LoadToEditorAsync() => await Dialog.CloseAsync(await _editor!.GetValue());

    Task CloseAsync() => Dialog.CancelAsync();
}
