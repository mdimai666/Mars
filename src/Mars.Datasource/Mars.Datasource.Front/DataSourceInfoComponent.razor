@using Mars.Contracts.Common
@using Mars.Datasource.Contracts.Catalog
@using Mars.Datasource.Contracts.Config
@using Mars.Datasource.Contracts.Document
@using Mars.Datasource.Contracts.Query
@using Mars.Datasource.Front.Services;
@using Mars.WebApiClient.Interfaces

<div class="DataSourceInfoComponent">
    @if (actions is null)
    {
        <Mars.Admin.Framework.Components.SharedLoader2 />
    }
    else if (actions.Count == 0)
    {
        <div class="text-secondary">У этого источника нет действий</div>
    }
    else
    {
        <div class="d-flex gap-3 flex-wrap">
            @foreach (var action in actions)
            {
                <a class="btn btn-outline-primary" title="@action.Description"
                   @onclick=@(e => SendTextAction(action.Id))>@action.Label</a>
            }
        </div>
    }

    <hr />

    @if (Busy)
    {
        <Mars.Admin.Framework.Components.SharedLoader2 />
    }
    else if (lastAction != null)
    {
        <div class="p-5">
            @if (!lastAction.Ok)
            {
                <div class="alert alert-danger">
                    <pre>@lastAction.Message</pre>
                </div>
            }
            else
            {
                <div class="alert alert-success">
                    @if (!string.IsNullOrEmpty(lastAction.Message))
                    {
                        @lastAction.Message
                    }
                    else
                    {
                        <text>Ok</text>
                    }
                </div>

                if (lastAction.Data is not null)
                {
                    <div class="overflow-scroll 1custom-scroll1 h-100" style="width:calc(100vw - 270px - 20px)">
                        <table class="table table-hover">
                            <tbody>
                                @foreach (var row in lastAction.Data)
                                {
                                    <tr>
                                        @foreach (var col in row)
                                        {
                                            <td>
                                                <span class="text-nowrap">
                                                    @col
                                                </span>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Inject] public IDatasourceServiceClient service { get; set; } = default!;

    /// <summary>Источник, к которому применяются действия.</summary>
    [Parameter]
    public string Slug { get; set; } = DatasourceConfig.DefaultSlug;

    /// <summary>Действия берём из каталога источника: список объявляет провайдер, а не страница.</summary>
    IReadOnlyList<DatasourceActionDescriptor>? actions;

    bool Busy;

    UserActionResult<string[][]>? lastAction = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var catalog = await service.Catalog(Slug);
            actions = catalog.Actions;
        }
        catch (Exception ex)
        {
            actions = [];
            lastAction = new UserActionResult<string[][]> { Ok = false, Message = ex.Message, Data = [] };
        }
    }

    public async Task SendTextAction(string actionName)
    {
        Busy = true;
        StateHasChanged();

        try
        {
            lastAction = await service.ExecuteAction(Slug, new DatasourceActionRequest { ActionId = actionName, Arguments = [] });
        }
        catch (Exception ex)
        {
            lastAction = new UserActionResult<string[][]> { Ok = false, Message = ex.Message, Data = [] };
        }
        finally
        {
            Busy = false;
            StateHasChanged();
        }
    }

}
