@using Mars.Datasource.Abstractions.Models
@using Mars.Datasource.Dto
@using Mars.Datasource.Front.Components
@using Mars.Datasource.Front.Services
@using MarsCodeEditor2
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager nav

@if (errorMessage is not null)
{
    <div class="p-4">
        <div class="alert alert-danger">@errorMessage</div>
    </div>
}
else if (database is null)
{
    <div class="p-5 main-fill xcenter">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="ds-workspace d-flex flex-column flex-fill">
        <section class="ds-topmenu flex-shrink-0 hstack px-2">
            <div class="dropdown">
                <a class="btn btn-light btn-sm rounded-0 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-database-check"></i>
                    @DataSourceConfigSlug
                </a>
                <ul class="dropdown-menu rounded-0 shadow fz14px">
                    @foreach (var item in listDatasources)
                    {
                        if (item.Slug == DataSourceConfigSlug) continue;
                        <li><a class="dropdown-item" href="@($"{nav.BaseUri}datasource/query?slug={Uri.EscapeDataString(item.Slug)}")">@item.Title</a></li>
                    }
                    @if (listDatasources.Count > 1)
                    {
                        <li><hr class="dropdown-divider"></li>
                    }
                    <li><a class="dropdown-item" href="@datasourceConfigUrl"><i class="bi bi-gear"></i> Настроить</a></li>
                </ul>
            </div>
            <span class="ms-auto text-secondary fz14px">
                @database.DatabaseName · объектов: @database.Tables.Count
                @if (source is not null)
                {
                    <span>· @source.Driver</span>
                }
            </span>
        </section>

        <FluentMultiSplitter Class="ds-splitter">
            <FluentMultiSplitterPane Size="250px" Min="170px" Max="460px" Collapsible="true" Resizable="true">
                <div class="ds-pane h-100 d-flex flex-column">
                    <div class="flex-shrink-0 hstack gap-1 p-2">
                        <input class="form-control form-control-sm" placeholder="таблица…" @bind="tableFilter" @bind:event="oninput" />
                        <button class="btn btn-sm btn-light" title="Обновить структуру" disabled="@Busy" @onclick="RefreshStructureAsync">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="flex-fill overflow-scroll">
                        @if (Busy)
                        {
                            <div class="p-3 text-center">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var group in filteredTables.GroupBy(t => t.TableSchema.SchemaName))
                                {
                                    if (hasMultipleSchemas)
                                    {
                                        <li class="list-group-item px-2 py-1 fz14px text-secondary bg-light">@group.Key</li>
                                    }
                                    @foreach (var item in group)
                                    {
                                        var table = item;
                                        <li class="list-group-item list-group-item-action px-2 py-1 hstack @(table == activeTab?.Table ? "active" : "")"
                                            title="@table.TableSchema.Kind"
                                            @onclick="() => OpenTableAsync(table)">
                                            <span class="text-nowrap">@table.TableName</span>
                                            @if (table.TableSchema.IsView)
                                            {
                                                <span class="badge bg-secondary fz14px ms-1">@table.TableSchema.Kind</span>
                                            }
                                        </li>
                                    }
                                }
                            </ul>
                        }
                    </div>
                </div>
            </FluentMultiSplitterPane>

            <FluentMultiSplitterPane>
                <div class="ds-pane h-100 d-flex flex-column">
                    <div class="ds-tabs flex-shrink-0 hstack gap-1 px-2 pt-2">
                        @foreach (var item in tabs)
                        {
                            var tab = item;
                            <span class="ds-tab hstack gap-1 px-2 py-1 @(tab == activeTab ? "ds-tab-active" : "")"
                                  @onclick="() => SelectTabAsync(tab)">
                                <span class="text-nowrap fz14px">@tab.Title</span>
                                @if (tabs.Count > 1)
                                {
                                    <i class="bi bi-x" role="button" title="Закрыть" @onclick:stopPropagation="true"
                                       @onclick="() => CloseTabAsync(tab)"></i>
                                }
                            </span>
                        }
                        <button class="btn btn-sm btn-light ms-1" title="Новый запрос" @onclick="() => AddTab()">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>

                    <div class="flex-shrink-0 hstack gap-2 px-2 py-2">
                        <FluentButton Appearance="Appearance.Accent" Disabled="@(activeTab?.Loading == true)"
                                      OnClick="RunActiveTabAsync">
                            Выполнить
                        </FluentButton>
                        @if (activeTab?.Result?.Truncated == true)
                        {
                            <FluentButton Appearance="Appearance.Neutral" Disabled="@(activeTab?.Loading == true)"
                                          OnClick="RunMoreAsync">
                                Показать больше
                            </FluentButton>
                        }
                        <FluentButton Appearance="Appearance.Stealth"
                                      OnClick="@(e => _aiTool.Open(scenarioName: "MarsSQLQueryPromptHelper"))">
                            AI help
                        </FluentButton>
                        @if (activeTab?.Table is { } opened)
                        {
                            <span class="ms-auto text-secondary fz14px">@opened.TableSchema.SchemaName.@opened.TableName</span>
                        }
                    </div>

                    @if (activeTab?.Table is { } current)
                    {
                        <details class="flex-shrink-0 px-2 fz14px">
                            <summary class="text-secondary">структура: @current.Columns.Count колонок</summary>
                            <div class="overflow-scroll pt-1" style="max-height:120px">
                                @foreach (var column in current.Columns.Values.OrderBy(c => c.ColumnOrdinal))
                                {
                                    <span class="badge bg-light text-dark border me-1 mb-1">
                                        @if (column.IsKey == true)
                                        {
                                            <i class="bi bi-key-fill text-warning me-1" title="primary key"></i>
                                        }
                                        @column.ColumnName <span class="text-secondary">@column.DataTypeName</span>
                                    </span>
                                }
                            </div>
                        </details>
                    }

                    <div class="ds-editor px-2">
                        <CodeEditor2 @ref="_editor" Lang=@CodeEditor2.Language.sql Value="" OnInit="OnEditorInitAsync"
                                     ContainerCssStyle="height:100%;border:1px solid #dfdfdf;border-radius:4px;overflow:hidden;" />
                    </div>

                    <div class="ds-result px-2 pb-2">
                        @if (activeTab?.Loading == true)
                        {
                            <div class="p-4 text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else if (activeTab?.Error is not null)
                        {
                            <div class="alert alert-danger">@activeTab.Error</div>
                        }
                        else if (activeTab?.Result is { } result)
                        {
                            <QueryResultGrid Result="result" Tab="activeTab" Slug="@DataSourceConfigSlug"
                                             Source="source" OnSaved="RunActiveTabAsync" />
                        }
                        else
                        {
                            <div class="text-secondary p-2">Выберите таблицу слева или напишите запрос и нажмите «Выполнить».</div>
                        }
                    </div>
                </div>
            </FluentMultiSplitterPane>
        </FluentMultiSplitter>
    </div>
}
