@using Mars.Datasource.Abstractions.Models
@using Mars.Datasource.Contracts.Models
@using Mars.Datasource.Front.Components
@using Mars.Datasource.Front.Services
@using MarsCodeEditor2
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager nav

@if (errorMessage is not null)
{
    <div class="p-4">
        <div class="alert alert-danger">@errorMessage</div>
    </div>
}
else if (catalog is null)
{
    <div class="p-5 main-fill xcenter">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="ds-workspace d-flex flex-column flex-fill">
        <section class="ds-topmenu flex-shrink-0 hstack px-2">
            <div class="dropdown">
                <a class="btn btn-light btn-sm rounded-0 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-database-check"></i>
                    @DataSourceConfigSlug
                </a>
                <ul class="dropdown-menu rounded-0 shadow fz14px">
                    @foreach (var item in listDatasources)
                    {
                        if (item.Slug == DataSourceConfigSlug) continue;
                        <li><a class="dropdown-item" href="@($"{nav.BaseUri}datasource/query?slug={Uri.EscapeDataString(item.Slug)}")">@item.Title</a></li>
                    }
                    @if (listDatasources.Count > 1)
                    {
                        <li><hr class="dropdown-divider"></li>
                    }
                    <li><a class="dropdown-item" href="@datasourceConfigUrl"><i class="bi bi-gear"></i> Настроить</a></li>
                </ul>
            </div>
            <span class="ms-auto text-secondary fz14px">
                @catalog.SourceName · объектов: @objectCount
                @if (!string.IsNullOrEmpty(SourceLabel))
                {
                    <span>· @SourceLabel</span>
                }
            </span>
        </section>

        <FluentMultiSplitter>
            <FluentMultiSplitterPane Size="250px" Min="170px" Max="460px" Collapsible="true" Resizable="true">
                <div class="ds-pane h-100 d-flex flex-column">
                    <div class="flex-shrink-0 hstack gap-1 p-2">
                        <input class="form-control form-control-sm" placeholder="объект…" @bind="tableFilter" @bind:event="oninput" />
                        @if (CanManageViews)
                        {
                            <button class="btn btn-sm btn-light text-nowrap" title="Новая вьюха" disabled="@Busy" @onclick="CreateViewAsync">
                                <i class="bi bi-plus-lg"></i> вьюха
                            </button>
                        }
                        <button class="btn btn-sm btn-light" title="Обновить" disabled="@Busy" @onclick="RefreshCatalogAsync">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="flex-fill overflow-scroll">
                        @if (Busy)
                        {
                            <div class="p-3 text-center">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var group in filteredGroups)
                                {
                                    if (hasMultipleGroups)
                                    {
                                        <li class="list-group-item px-2 py-1 fz14px text-secondary ds-schema"
                                            @onclick="() => ToggleSchema(group.Name)">
                                            <i class="bi @(IsSchemaExpanded(group.Name) ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>
                                            <span>@group.Name</span>
                                        </li>
                                    }
                                    @if (!hasMultipleGroups || IsSchemaExpanded(group.Name))
                                    {
                                        @foreach (var item in group.Objects)
                                        {
                                            var entry = new CatalogEntry(group.Name, item);
                                            <li class="list-group-item list-group-item-action px-2 py-1 hstack @(item == activeTab?.Object ? "active" : "")"
                                                title="@item.ObjectType"
                                                @onclick="() => OpenObjectAsync(entry)">
                                                <span class="text-nowrap">@item.Name</span>
                                                @if (item.ObjectType is DatasourceObjectType.View or DatasourceObjectType.MaterializedView)
                                                {
                                                    <span class="badge bg-secondary fz14px ms-1">@item.ObjectType</span>
                                                }
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                        }
                    </div>
                </div>
            </FluentMultiSplitterPane>

            <FluentMultiSplitterPane>
                <div class="ds-pane h-100 d-flex flex-column">
                    <div class="ds-tabs flex-shrink-0 hstack gap-1 px-2 pt-2">
                        @foreach (var item in tabs)
                        {
                            var tab = item;
                            <span class="ds-tab hstack gap-1 px-2 py-1 @(tab == activeTab ? "ds-tab-active" : "")"
                                  @onclick="() => SelectTabAsync(tab)">
                                <span class="text-nowrap fz14px">@tab.Title</span>
                                @if (tabs.Count > 1)
                                {
                                    <i class="bi bi-x" role="button" title="Закрыть" @onclick:stopPropagation="true"
                                       @onclick="() => CloseTabAsync(tab)"></i>
                                }
                            </span>
                        }
                        <button class="btn btn-sm btn-light ms-1" title="Новый запрос" @onclick="() => AddTab()">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>

                    <div class="flex-shrink-0 hstack gap-2 px-2 py-2">
                        <FluentButton Appearance="Appearance.Accent" Disabled="@(activeTab?.Loading == true)"
                                      OnClick="RunActiveTabAsync">
                            Выполнить
                        </FluentButton>
                        @if (activeTab?.CanLoadMore == true)
                        {
                            <FluentButton Appearance="Appearance.Neutral" Disabled="@(activeTab?.Loading == true)"
                                          OnClick="RunMoreAsync">
                                Показать больше
                            </FluentButton>
                        }
                        @if (IsSql)
                        {
                            <FluentButton Appearance="Appearance.Stealth"
                                          OnClick="@(e => _aiTool.Open(scenarioName: "MarsSQLQueryPromptHelper"))">
                                AI help
                            </FluentButton>
                        }
                        @if (activeTab is { Object: { } opened } current)
                        {
                            @if (CanManageViews && opened.ObjectType == DatasourceObjectType.View)
                            {
                                <FluentButton Appearance="Appearance.Neutral" Disabled="@Busy" OnClick="ShowViewDefinitionAsync">
                                    определение
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Neutral" Disabled="@Busy" OnClick="DropViewAsync">
                                    удалить
                                </FluentButton>
                            }
                            <span class="ms-auto text-secondary fz14px">@DisplayName(new CatalogEntry(current.Schema, opened))</span>
                        }
                    </div>

                    @if (activeTab?.Object is { Columns.Count: > 0 } currentObject)
                    {
                        <details class="flex-shrink-0 px-2 fz14px">
                            <summary class="text-secondary">структура: @currentObject.Columns.Count колонок</summary>
                            <div class="overflow-scroll pt-1" style="max-height:120px">
                                @foreach (var column in currentObject.Columns.OrderBy(c => c.Ordinal))
                                {
                                    <span class="badge bg-light text-dark border me-1 mb-1">
                                        @if (column.IsKey)
                                        {
                                            <i class="bi bi-key-fill text-warning me-1" title="primary key"></i>
                                        }
                                        @column.Name <span class="text-secondary">@QColumnMapping.ShortTypeName(column.DataTypeName)</span>
                                    </span>
                                }
                            </div>
                        </details>
                    }

                    @if (activeTab?.Object is { Parameters.Count: > 0 } operation)
                    {
                        <details class="flex-shrink-0 px-2 fz14px" open>
                            <summary class="text-secondary">параметры: @operation.Parameters.Count</summary>
                            <div class="row row-cols-1 row-cols-md-3 row-cols-xl-5 g-2 pt-1">
                                @foreach (var parameter in operation.Parameters)
                                {
                                    <div class="col">
                                        <label class="text-nowrap" title="@parameter.Description">
                                            @parameter.Name
                                            @if (parameter.Required)
                                            {
                                                <span class="text-danger">*</span>
                                            }
                                            <span class="text-secondary">@parameter.In · @parameter.Type</span>
                                        </label>
                                        @if (parameter.Enum is { Count: > 0 } allowed)
                                        {
                                            <select class="form-select form-select-sm"
                                                    value="@ParameterValue(parameter.Name)"
                                                    @onchange="@(args => SetParameter(parameter.Name, args.Value?.ToString()))">
                                                <option value=""></option>
                                                @foreach (var value in allowed)
                                                {
                                                    <option value="@value" selected="@(ParameterValue(parameter.Name) == value)">@value</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm" placeholder="@parameter.Default"
                                                   value="@ParameterValue(parameter.Name)"
                                                   @onchange="@(args => SetParameter(parameter.Name, args.Value?.ToString()))" />
                                        }
                                    </div>
                                }
                            </div>
                        </details>
                    }

                    <div class="ds-editor px-2">
                        <CodeEditor2 @ref="_editor" @key="EditorLang" Lang=@EditorLang Value="" OnInit="OnEditorInitAsync"
                                     ContainerCssStyle="height:100%;border:1px solid #dfdfdf;border-radius:4px;overflow:hidden;" />
                    </div>

                    <div class="ds-result px-2 pb-2">
                        @if (activeTab?.Loading == true)
                        {
                            <div class="p-4 text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else if (activeTab?.Error is not null)
                        {
                            <div class="alert alert-danger">@activeTab.Error</div>
                        }
                        else if (activeTab?.Result is { } result)
                        {
                            <QueryResultGrid Result="result" Tab="activeTab" Slug="@DataSourceConfigSlug"
                                             Source="source" OnSaved="RunActiveTabAsync" />
                        }
                        else if (IsSql)
                        {
                            <div class="text-secondary p-2">Выберите объект слева или напишите запрос и нажмите «Выполнить».</div>
                        }
                        else if (IsRest)
                        {
                            <div class="text-secondary p-2">
                                <div>Выберите операцию слева — в редакторе появится заготовка запроса.</div>
                                <div class="fz14px mt-1">
                                    Синтаксис <code>.http</code>: <code>GET {{baseUrl}}/wp/v2/posts?per_page=10</code>,
                                    заголовки через строку, тело после пустой строки, разделитель запросов <code>###</code>,
                                    имя запроса <code># @@name posts</code>, переменные <code>@@var = 1</code> и <code>{{var}}</code>.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-secondary p-2">
                                <div>Выберите файл слева — откроются его строки.</div>
                                <div class="fz14px mt-1">
                                    Условие фильтра (Dynamic LINQ): <code>Val.Num(age) &gt; 30</code>, <code>name == "ann"</code>,
                                    <code>Val.Date(created) &gt; Val.Date("2020-01-01")</code>. Пустое условие — все строки.
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </FluentMultiSplitterPane>
        </FluentMultiSplitter>
    </div>
}
