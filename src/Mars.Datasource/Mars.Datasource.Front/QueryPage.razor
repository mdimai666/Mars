@using Mars.Admin.Framework.Components
@using Mars.Datasource.Contracts.Catalog
@using Mars.Datasource.Contracts.Config
@using Mars.Datasource.Contracts.Document
@using Mars.Datasource.Contracts.Query
@using Mars.Datasource.Front.Workspaces.Objects
@using Mars.Datasource.Front.Workspaces.Sql

@if (loading)
{
    <div class="p-5 main-fill xcenter">
        <SharedLoader1 />
    </div>
}
else if (error is not null)
{
    <div class="p-4">
        <div class="alert alert-danger">@error</div>
        <button class="btn btn-sm btn-light" disabled="@loading" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise"></i> Повторить
        </button>
    </div>
}
else if (IsSql)
{
    <SqlQueryWorkspace DataSourceConfigSlug="@DataSourceConfigSlug" Sources="sources" />
}
else
{
    <ObjectsQueryWorkspace DataSourceConfigSlug="@DataSourceConfigSlug" Sources="sources" />
}
