@using Mars.Admin.Framework.Components
@using Mars.Datasource.Contracts.Catalog
@using Mars.Datasource.Contracts.Config
@using Mars.Datasource.Contracts.Document
@using Mars.Datasource.Contracts.Query
@using Mars.Datasource.Front.Workspaces

<div class="ds-pane ds-tree h-100 d-flex flex-column">
    <div class="ds-tree__head flex-shrink-0 hstack gap-1 p-2">
        <input class="ds-tree__filter" placeholder="объект…"
               value="@Filter" @oninput="@(args => FilterChanged.InvokeAsync(args.Value?.ToString() ?? ""))" />
        @ChildContent
    </div>
    <div class="ds-tree__scroll flex-fill overflow-scroll">
        @if (Busy)
        {
            <div class="p-3">
                <SharedLoader2 />
            </div>
        }
        else
        {
            <ul class="ds-tree__list">
                @foreach (var group in Groups)
                {
                    if (HasMultipleGroups)
                    {
                        <li class="ds-tree__group" @onclick="() => OnToggleGroup.InvokeAsync(group.Name)">
                            <i class="bi @(IsExpanded(group.Name) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                            <span>@group.Name</span>
                        </li>
                    }
                    @if (!HasMultipleGroups || IsExpanded(group.Name))
                    {
                        @foreach (var item in group.Objects)
                        {
                            var entry = new CatalogEntry(group.Name, item);
                            <li class="ds-tree__item @(IsActive(item) ? "ds-tree__item--active" : null)"
                                title="@item.ObjectType"
                                @onclick="() => OnOpen.InvokeAsync(entry)">
                                <span class="ds-tree__name">@item.Name</span>
                                @if (item.ObjectType is DatasourceObjectType.View or DatasourceObjectType.MaterializedView)
                                {
                                    <span class="ds-tree__badge">@item.ObjectType</span>
                                }
                            </li>
                        }
                    }
                }
            </ul>
        }
    </div>
</div>