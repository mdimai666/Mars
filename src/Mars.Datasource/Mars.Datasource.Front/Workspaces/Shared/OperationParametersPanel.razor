@using Mars.Datasource.Contracts.Catalog
@using Mars.Datasource.Contracts.Config
@using Mars.Datasource.Contracts.Document
@using Mars.Datasource.Contracts.Query

@if (Operation?.Operation is { Parameters.Count: > 0 } operation)
{
    <details class="flex-shrink-0 px-2 fz14px" open>
        <summary class="text-secondary">параметры: @operation.Parameters.Count</summary>
        <div class="row row-cols-1 row-cols-md-3 row-cols-xl-5 g-2 pt-1">
            @foreach (var parameter in operation.Parameters)
            {
                <div class="col">
                    <label class="text-nowrap" title="@parameter.Description">
                        @parameter.Name
                        @if (parameter.Required)
                        {
                            <span class="text-danger">*</span>
                        }
                        <span class="text-secondary">@parameter.In · @parameter.Type</span>
                    </label>
                    @if (parameter.Enum is { Count: > 0 } allowed)
                    {
                        <select class="form-select form-select-sm"
                                value="@GetValue(parameter.Name)"
                                @onchange="@(args => ValueChanged.InvokeAsync((parameter.Name, args.Value?.ToString())))">
                            <option value=""></option>
                            @foreach (var value in allowed)
                            {
                                <option value="@value" selected="@(GetValue(parameter.Name) == value)">@value</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input class="form-control form-control-sm" placeholder="@parameter.Default"
                               value="@GetValue(parameter.Name)"
                               @onchange="@(args => ValueChanged.InvokeAsync((parameter.Name, args.Value?.ToString())))" />
                    }
                </div>
            }
        </div>
    </details>
}
