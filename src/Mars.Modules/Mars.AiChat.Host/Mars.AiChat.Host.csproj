<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- harness-память и скиллы (FileMemoryStore, AgentSkillsSource) — experimental API Microsoft.Agents.AI -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" />
    <PackageReference Include="Microsoft.Extensions.AI.Ollama" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <!-- bundled-скиллы агента (SKILL.md), рядом со сборкой читаются AgentFileSkillsSource;
         папка ai-skills, чтобы не смешиваться со skills/ модуля SemanticKernel -->
    <Content Include="ai-skills\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mars.Datasource\Mars.Datasource.Host\Mars.Datasource.Host.csproj" />
    <ProjectReference Include="..\..\Mars.Server.Abstractions\Mars.Server.Abstractions.csproj" />
    <ProjectReference Include="..\Mars.AiChat.Abstractions\Mars.AiChat.Abstractions.csproj" />
    <ProjectReference Include="..\Mars.SiteEngine.Abstractions\Mars.SiteEngine.Abstractions.csproj" />
  </ItemGroup>

</Project>
