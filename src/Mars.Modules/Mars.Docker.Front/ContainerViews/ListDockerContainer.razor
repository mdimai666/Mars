@using Mars.Admin.Framework.Components
@using Mars.Contracts.Resources
@using Mars.Core.Extensions
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons;
@using Mars.Docker.Contracts;

<ErrorBoundary>
    <ChildContent>
        <div class="hstack gap-2">
            <FluentSearch @bind-Value=_searchText
                          @bind-Value:after=HandleSearchInput
                          Immediate
                          ImmediateDelay="300"
                          Appearance="FluentInputAppearance.Filled"
                          AriaLabel="Search" />
            <FluentSwitch Label="Running only" @bind-Value="_runningOnly" @bind-Value:after="HandleSearchInput" />
            <FluentButton aria-label="refresh" Title="Refresh" IconEnd="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="Refresh" />
            <div class="ms-auto">
                <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.Add())" OnClick="ShowCreateDialog">@AppRes.Create</FluentButton>
            </div>
        </div>

        <div class="mt-3">
            @if (IsBusy)
            {
                <SharedLoader1 />
            }
            else if (_items.Count == 0)
            {
                <SharedContentNoRecords />
            }
            else
            {
                <FluentDataGrid Items="@_items.Where(i => !i.IsHidden).AsQueryable()" TGridItem="DockerGridItem" ShowHover="true">
                    <TemplateColumn Title="Name" HierarchicalToggle="true" Width="4fr">
                        @if (context.Item.GroupName is not null)
                        {
                            <span class="docker-group-name">@context.Item.GroupName</span>
                            <span class="docker-group-count">@context.Item.Containers.Count</span>
                        }
                        else
                        {
                            var container = context.Item.Container!;
                            <div class="docker-container-name">
                                <DockerStateBadge State="@container.State" CustomText="@container.Status" />
                                <div class="position-relative">
                                    <span class="text-accent">@DisplayName(context.Item)</span>
                                    <a href="@UrlEditPage/@container.ID" class="stretched-link"></a>
                                </div>
                            </div>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Image" Width="2fr">
                        @context.Item.Container?.Image
                    </TemplateColumn>
                    <TemplateColumn Title="Ports" Width="1fr">
                        <div class="docker-cell-ports">
                            @foreach (var port in (context.Item.Container?.Ports ?? []).Where(p => p.PublicPort > 0))
                            {
                                <span>@port.PublicPort:@port.PrivatePort</span>
                            }
                        </div>
                    </TemplateColumn>
                    <TemplateColumn Title="Started" Width="1fr">
                        @if (context.Item.Container is { } started)
                        {
                            var date = started.StartedAt ?? started.Created;
                            <span title="@date.ToString("g")">@date.ToString("d")</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="@AppRes.Actions" Align="@Align.End" Width="auto">
                        <div class="docker-cell-actions">
                            @if (context.Item.GroupName is not null)
                            {
                                @if (GroupIsRunning(context.Item))
                                {
                                    <FluentButton aria-label="stop-all" Title="Stop all" IconEnd="@(new Icons.Regular.Size16.Stop())" OnClick="@(e => ToggleGroup(context))" />
                                }
                                else
                                {
                                    <FluentButton aria-label="start-all" Title="Start all" IconEnd="@(new Icons.Regular.Size16.Play())" OnClick="@(e => ToggleGroup(context))" />
                                }
                            }
                            else
                            {
                                var container = context.Item.Container!;
                                @if (container.State == "running")
                                {
                                    <FluentButton aria-label="stop" Title="Stop" IconEnd="@(new Icons.Regular.Size16.Stop())" OnClick="@(e => ToggleContainer(container))" />
                                    <FluentButton aria-label="restart" Title="Restart" IconEnd="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="@(e => RestartContainer(container))" />
                                }
                                else
                                {
                                    <FluentButton aria-label="start" Title="Start" IconEnd="@(new Icons.Regular.Size16.Play())" OnClick="@(e => ToggleContainer(container))" />
                                }
                                <FluentButton aria-label="delete" Title="Delete" IconEnd="@(new Icons.Regular.Size16.Delete())" OnClick="@(e => DeleteContainer(container))" />
                            }
                        </div>
                    </TemplateColumn>
                </FluentDataGrid>
            }
        </div>
    </ChildContent>
    <ErrorContent>
        <h2>500</h2>
    </ErrorContent>
</ErrorBoundary>
