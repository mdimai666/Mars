@namespace Mars.Forms.Front.Editors

@* Встроенный редактор даты: значение — DateTimeOffset в канонической кодировке ISO-8601.
   Смещение сохраняем из текущего значения, иначе берём локальное. Readonly — текстом. *@

@if (Binding.ReadOnly)
{
    <h6 class="card-subtitle mb-2 text-muted">@(Date?.ToString("g") ?? "—")</h6>
}
else
{
    <FluentDatePicker Value="@Date"
                      ValueChanged="OnChanged"
                      Name="@Binding.Field.Key"
                      Style="max-width:240px" />
}

@code {
    [Parameter] public FormFieldBinding Binding { get; set; } = default!;

    [Parameter] public int Index { get; set; } = -1;

    DateTime? Date => Binding.ValueAt(Index) switch
    {
        DateTimeOffset offset => offset.DateTime,
        DateTime date => date,
        _ => null,
    };

    void OnChanged(DateTime? date)
    {
        if (date is null)
        {
            Binding.SetValueAt(Index, null);
            return;
        }

        var offset = Binding.ValueAt(Index) as DateTimeOffset? ?? DateTimeOffset.Now;
        Binding.SetValueAt(Index, new DateTimeOffset(date.Value, offset.Offset));
    }
}
