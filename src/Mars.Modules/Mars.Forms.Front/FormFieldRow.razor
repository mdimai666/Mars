@namespace Mars.Forms.Front
@inject IFormEditorLocator Editors

<div class="form-field mb-3" data-key="@Item.Key" title="@Item.Key">
    @if (!SelfLabeled)
    {
        <FluentLabel>@Binding.Title</FluentLabel>
    }

    @if (EditorComponent is not null)
    {
        <DynamicComponent Type="@EditorComponent" Parameters="@EditorParameters" />
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <FluentLabel Color="@Color.Warning">
                    нет редактора для поля <strong>@Item.Key</strong> (тип @Item.Field!.Type)
                </FluentLabel>
            </div>
        </div>
    }

    @if (!SelfLabeled && !string.IsNullOrEmpty(Item.Field!.Description))
    {
        <div class="text-secondary fz10px">@Item.Field.Description</div>
    }
    @foreach (var error in Binding.Errors)
    {
        <div class="text-danger fz10px">@error.Message</div>
    }
</div>

@code {
    [CascadingParameter] public FormRenderContext Context { get; set; } = default!;

    [Parameter] public FormItem Item { get; set; } = default!;

    FormFieldBinding _binding = default!;

    protected override void OnParametersSet()
        => _binding = new FormFieldBinding
        {
            Item = Item,
            Field = Item.Field!,
            Values = Context.Values,
            TitleResolver = Context.TitleResolver,
        };

    FormFieldBinding Binding => _binding;

    /// <summary>Явный ключ редактора (раскладка → дескриптор), иначе встроенный редактор типа</summary>
    Type? EditorComponent
        => Editors.GetEditorComponent(_binding.Editor, LookupType, _binding.IsList)
           ?? Editors.GetDefaultEditor(_binding.ElementType, _binding.IsList);

    FormFieldType LookupType => _binding.IsList ? _binding.ElementType : _binding.Field.Type;

    /// <summary>Редактор сам рисует подпись и описание — общий рендерер их не дублирует</summary>
    bool SelfLabeled
        => EditorComponent is not null && typeof(IFormSelfLabeledEditor).IsAssignableFrom(EditorComponent);

    Dictionary<string, object> EditorParameters => new() { ["Binding"] = _binding };
}
