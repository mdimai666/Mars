@namespace Mars.Forms.Front

@* Точка входа рендера: одна зона = один экземпляр. Секции — маркеры плоского списка:
   поля идут за маркером до следующего (как Tab в ACF), вложенности у раскладки нет. *@
<CascadingValue Value="@_context">
    <div class="row">
        @foreach (var entry in Entries)
        {
            if (entry.IsHeader)
            {
                <div class="col-12">
                    <h6 class="mt-3 mb-1">@entry.Item.Title</h6>
                </div>
            }
            else
            {
                <div class="@WidthClass(entry.Item)">
                    @if (FieldTemplate is not null)
                    {
                        @FieldTemplate(entry.Item)
                    }
                    else
                    {
                        <FormFieldRow Item="@entry.Item" />
                    }
                </div>
            }
        }
    </div>
</CascadingValue>

@code {
    [Parameter] public FormDefinition Definition { get; set; } = default!;

    [Parameter] public IFormValueStore Values { get; set; } = default!;

    /// <summary>Ключ зоны из определения провайдера (пусто — единственная зона)</summary>
    [Parameter] public string Zone { get; set; } = "";

    [Parameter] public bool Client { get; set; }

    /// <summary>Резолвер переводимых заголовков (локализатор страницы-потребителя)</summary>
    [Parameter] public Func<string, string>? TitleResolver { get; set; }

    /// <summary>Свой рендер листа-поля (иначе встроенный <see cref="FormFieldRow"/>)</summary>
    [Parameter] public RenderFragment<FormItem>? FieldTemplate { get; set; }

    /// <summary>Общие хуки отложенной записи на форму (одни на все зоны страницы)</summary>
    [Parameter] public FormCommitHooks? Commits { get; set; }

    /// <summary>Общие живые редакторы на форму (одни на все зоны страницы)</summary>
    [Parameter] public FormLiveEditors? LiveEditors { get; set; }

    FormRenderContext _context = default!;

    protected override void OnParametersSet()
        => _context = new FormRenderContext
        {
            Definition = Definition,
            Values = Values,
            Client = Client,
            TitleResolver = TitleResolver,
            FieldTemplate = FieldTemplate,
            Commits = Commits ?? new FormCommitHooks(),
            LiveEditors = LiveEditors ?? new FormLiveEditors(),
        };

    /// <summary>Зона в порядке раскладки: заголовки-маркеры и листы-поля; поля без дескриптора не рендерятся</summary>
    IEnumerable<(FormItem Item, bool IsHeader)> Entries
        => (Definition?.Items ?? [])
            .Where(item => (item.Zone ?? "") == Zone)
            .Where(item => item.Kind == FormItemKind.Heading || (item.Visible && item.Field is not null))
            .Select(item => (item, item.Kind == FormItemKind.Heading));

    static string WidthClass(FormItem item) => item.Width switch
    {
        FormItemWidths.Half => "col-12 col-md-6",
        FormItemWidths.Third => "col-12 col-md-4",
        FormItemWidths.Quarter => "col-12 col-md-3",
        _ => "col-12",
    };
}
