@namespace Mars.Forms.Front

@* Встроенный контейнер-секция: заголовок и дети, значения не имеет *@
<section class="card mb-3 form-section">
    <div class="card-header d-flex align-items-center gap-2" style="cursor:pointer" @onclick="Toggle">
        <strong>@(string.IsNullOrEmpty(Item.Title) ? Item.Key : Item.Title)</strong>
        <i class="bi @(Collapsed ? "bi-chevron-down" : "bi-chevron-up")"></i>
    </div>
    @if (!Collapsed)
    {
        <div class="card-body">
            <FormItems Items="@Item.Items" />
        </div>
    }
</section>

@code {
    [CascadingParameter] public FormRenderContext Context { get; set; } = default!;

    [Parameter] public FormItem Item { get; set; } = default!;

    bool? _override;

    bool Collapsed => _override ?? Item.Collapsed;

    void Toggle() => _override = !Collapsed;
}
