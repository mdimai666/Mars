@using Mars.Contracts.Resources
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<d-aitool-chat-modal>
    <FluentDialog aria-label="AI prompt dialog"
                  @ref=_dialog
                  Modal=true
                  Class="AIToolChatModal"
                  OnStateChange="OnDialogStateChange">
        <FluentDialogBody>
            <TitleTemplate>
                <FluentStack VerticalAlignment="VerticalAlignment.Center">
                    <FluentIcon Value="@(new Icons.Regular.Size20.WindowApps())" />
                    <FluentText Size="TextSize.Size600">
                        @(ScenarioName ?? "Prompt")
                    </FluentText>

                    <FluentSpacer />
                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                  Color="var(--bs-danger)"
                                  OnClick="CloseClick">
                        <FluentIcon Value="@(new Icons.Filled.Size20.Dismiss())"
                                    Width="20px" Color="Color.Default" />
                    </FluentButton>
                </FluentStack>
            </TitleTemplate>
            <ChildContent>
                <div class="vstack gap-2">
                    <div>
                        @if (_busy)
                        {
                            <FluentSpinner />
                        }
                        else if (response is not null)
                        {
                            <div style="user-select:none">
                                <strong>AI: </strong>
                                <a @onclick=CopyClick role="button" style="float:right">[copy]</a>
                                <pre @ref=aiResponsePreElement
                                     class="form-control w-100 position-relative"
                                     style="user-select:text"> @response.Content </pre>
                                <FluentSpacer />
                            </div>
                        }
                    </div>

                    <FluentTextArea @bind-Value="@ChatInput"
                                    Placeholder="Type your prompt here..."
                                    @onkeydown="HandleKeyDown"
                                    tabindex="1"
                                    Autofocus
                                    Class="w-100" />
                </div>
            </ChildContent>
            <ActionTemplate>
                <div class="d-flex justify-content-end">
                    <FluentButton OnClick="SendMessage"
                                  Loading=@_busy
                                  tabindex="2"
                                  Title="(Ctrl+Enter) Send message"
                                  IconStart="@(new Icons.Regular.Size16.Send())"
                                  Appearance="ButtonAppearance.Primary">
                        Send
                    </FluentButton>
                </div>
            </ActionTemplate>
        </FluentDialogBody>
    </FluentDialog>
</d-aitool-chat-modal>

@code {
    // v5: FluentDialog без Hidden — показ/скрытие императивно; _visible остаётся источником правды,
    // синхронизация после рендера. OnStateChange(Closed) обрабатывает dismiss (ESC/backdrop).
    bool _dialogShown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialog is null) return;

        if (_visible && !_dialogShown)
        {
            await _dialog.ShowAsync();
            _dialogShown = true;
        }
        else if (!_visible && _dialogShown)
        {
            await _dialog.HideAsync();
            _dialogShown = false;
        }
    }

    void OnDialogStateChange(DialogEventArgs e)
    {
        if (e.State != DialogState.Closed) return;

        _dialogShown = false;
        if (_visible)
        {
            OnDialogDismiss(e);
        }
    }
}

<style>
    .fluent-dialog-main {
        /*bootstrap offcanvas overlow*/
        /* z-index: 1050 !important; */
    }

    fluent-dialog.AIToolChatModal::part(dialog) {
        /* margin-bottom: 0 !important; */
        /* v5: --dialog-width мёртв (max-width 600px в shadow-стилях) — ширина здесь */
        width: 600px;
        max-width: 600px;
        border-radius: 0;
    }
</style>
