@using System.Text.Json.Nodes
@using Mars.Admin.Framework.Components
@using Mars.SemanticKernel.Contracts.Options
@using System.Text.Json

<FormItem2 For="() => Value.ModelId">
    <FluentTextInput @bind-Value=Value.ModelId />
</FormItem2>
<FormItem2 For="() => Value.Endpoint">
    <FluentTextInput @bind-Value=Value.Endpoint Placeholder="@OpenAIOptions.DefaultEndpoint" />
</FormItem2>
<FormItem2 For="() => Value.ApiKey">
    <FluentTextInput @bind-Value=Value.ApiKey Class="w-100" />
</FormItem2>
<FormItem2 For="() => Value.OrgId">
    <FluentTextInput @bind-Value=Value.OrgId />
</FormItem2>

@code {
    OpenAIOptions _value = default!;

    [Parameter]
    public OpenAIOptions Value
    {
        get => _value;
        set
        {
            if (value == _value) return;
            _value = value;
            ValueChanged.InvokeAsync(_value);
        }
    }

    [Parameter]
    public EventCallback<OpenAIOptions> ValueChanged { get; set; }

}
