@using Mars.Nodes.Contracts.Nodes
@using Mars.Admin.Framework.Dialogs
@using MarsCodeEditor2
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody Class="text-start">
    <TitleTemplate>
        <div class="hstack gap-3">
            <FluentLabel Typo="Typography.Header">DebugNode full object</FluentLabel>
            @if (Content is { CapturedAt: { } captured })
            {
                <FluentLabel>@captured.ToLocalTime().ToString("HH:mm:ss") · @($"{Content.Size:N0} chars")@(Content.Truncated ? " · truncated (2 MB)" : "")</FluentLabel>
            }
        </div>
    </TitleTemplate>
    <ChildContent>
        <MarsCodeEditor2.CodeEditor2 Lang=@Lang
                                     Value=@(Content?.Json ?? "")
                                     OptionsJson=@("""{"wordWrap":"on","minimap":{"enabled":false}}""")
                                     ContainerCssStyle="height:70vh;border:1px solid #dfdfdf;overflow:hidden;"
                                     HideToolbarComponents="true" />
    </ChildContent>
</FluentDialogBody>

@code {
    [Parameter] public NodeDebugFullResponse Content { get; set; } = default!;

    // обрезанный на 2 МБ JSON — битый, подсветка json-ошибками только мешает
    string Lang => Content is { Truncated: true } ? CodeEditor2.Language.plaintext : CodeEditor2.Language.json;

    public static void ShowDialog(IDialogService dialogService, NodeDebugFullResponse content)
    {
        DialogParameters parameters = new()
        {
            Title = "DebugNode full object",
            ShowDismiss = true,
            Width = "1100px",
            Modal = true,
        };

        _ = dialogService.ShowDialogAsync<DebugNodeFullObjectDialog>(content, parameters);
    }
}
