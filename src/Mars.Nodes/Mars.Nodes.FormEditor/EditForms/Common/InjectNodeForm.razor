@using Mars.Admin.Framework.Components
@using Mars.Core.Utils
@using Mars.Nodes.FormEditor.EditForms.Components
@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inherits NodeEditForm
@attribute [NodeEditFormForNode(typeof(InjectNode))]
@inject IStringLocalizer<AppRes> L

<div class="form-group d-flex flex-column flex-fill gap-4">

    <div class="vstack gap-2">
        <div class="text-secondary">
            <b>@InjectNode.PayloadKey</b> becomes <code>msg.Payload</code>, any other key becomes <code>msg.&lt;key&gt;</code>
        </div>

        <FormItem2 For="()=>Email">
            <MarsValueInput @bind-Value=Email For="() => Email" />
        </FormItem2>

        <FormItem2 For="()=>Count">
            <MarsValueInput @bind-Value=Count VarType="int" For="() => Count" />
        </FormItem2>

        <FormItem2 For="()=>DueDate">
            <MarsValueInput @bind-Value=DueDate VarType="DateTime" For="() => DueDate" />
        </FormItem2>

        <FormItem2 For="()=>ReadOnlyValue">
            <MarsValueInput @bind-Value=ReadOnlyValue VarType="double" ReadOnly="true" For="() => ReadOnlyValue" />
        </FormItem2>

        <FormItem2 For="()=>DisabledValue">
            <MarsValueInput @bind-Value=DisabledValue Disabled="true" For="() => DisabledValue" />
        </FormItem2>

        <FluentSortableList Id="injectFields" Handle="true" Items="Node.Fields" OnUpdate="@SortList" Context="item">
            <ItemTemplate>
                <div class="sortable-grab">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSort())" />
                </div>
                <div class="sortable-item-content p-1" style="flex-grow: 1;" @key=item>
                    <div class="d-grid align-items-center" style="grid-template-columns: 1fr 130px 1.5fr 33px; column-gap: 10px;">
                        <MarsPathInput Root="msg" ShowRoot="false" @bind-Value="item.Key" For="() => item.Key" Placeholder="Key" />
                        <FluentSelect TOption="string" Items="@VarTypeItems" @bind-SelectedOption="item.VarType" Style="min-width: unset;" />
                        <ValueSourceEditor @bind-Value="item.Value" @bind-ValueKind="item.ValueKind" VarType="item.VarType" />
                        <FluentButton OnClick=@(() => DeleteItem(item)) IconStart="@(new Icons.Regular.Size16.Delete())" />
                    </div>
                    <FluentValidationMessage For=@(() => item.Key) />
                    <FluentValidationMessage For=@(() => item.VarType) />
                    <FluentValidationMessage For=@(() => item.Value) />
                </div>
            </ItemTemplate>
        </FluentSortableList>

        <div class="mt-1 hstack gap-1">
            <FluentButton OnClick="AddNew" IconStart="@(new Icons.Regular.Size16.Add())">@AppRes.Add</FluentButton>
        </div>
    </div>

    <div class="hstack gap-3">
        <div class="hstack gap-2">
            <i class="bi bi-clock"></i>
            <FluentLabel>@(L[nameof(Node.RunAtStartup)])</FluentLabel>
        </div>
        <FluentCheckbox @bind-Value=Node.RunAtStartup />
        <FluentLabel>@(L["delay millis"])</FluentLabel>
        <FluentNumberField @bind-Value=Node.StartupDelayMillis Min="10" Disabled=!Node.RunAtStartup />
    </div>

    <div class="hstack gap-3" style="min-height:32px;">
        <div class="hstack gap-2">
            <i class="bi bi-repeat"></i>
            <FluentLabel>@(L[nameof(Node.IsSchedule)])</FluentLabel>
        </div>
        <FluentCheckbox @bind-Value=Node.IsSchedule />
        @if (Node.IsSchedule)
        {
            <FluentLabel>@(L["cron mask"])</FluentLabel>
            <SchedulerMaskInput @bind-Value=Node.ScheduleCronMask />
            <div class="hstack gap-1 ms-2">
                <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => Node.ScheduleCronMask = "0/5 * * * * ?")">every 5 seconds</FluentButton>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => Node.ScheduleCronMask = "0 0/5 * * * ?")">every 5 minutes</FluentButton>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] Node Value { get; set; } = default!;
    InjectNode Node { get => (InjectNode)Value; set => Value = value; }

    IReadOnlyList<string> VarTypeItems => VarNode.ListTypesSelect();

    void SortList(FluentSortableListEventArgs args) => Node.Fields = Node.Fields.MoveItem(args.OldIndex, args.NewIndex);

    void AddNew() => Node.Fields = [.. Node.Fields, new() { Key = $"field{Node.Fields.Length + 1}" }];

    void DeleteItem(InjectNodeField item) => Node.Fields = Node.Fields.Where(s => s != item).ToArray();

    public string Email { get; set; } = "";

    public string Count { get; set; } = "42";

    public string DueDate { get; set; } = "2026-09-16";

    public string ReadOnlyValue { get; set; } = "3.14";

    public string DisabledValue { get; set; } = "issued by scheduler";
}
