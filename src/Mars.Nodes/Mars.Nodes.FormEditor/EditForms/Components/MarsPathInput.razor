@using System.Linq.Expressions
@using Mars.Nodes.Front.Abstractions.Services
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IServiceProvider Services
@implements IAsyncDisposable

<div @ref="_root" class="@RootClass" @attributes="RootAttributes">
    <div @ref="_body" class="mvi-body">
        @if (ShowChip)
        {
            <span class="mvi-tag">@RootLabel</span>
        }

        <div class="mvi-field">
            <input @ref="_input" class="mvi-input" type="text" spellcheck="false" autocomplete="off"
                   role="combobox" aria-autocomplete="list"
                   aria-expanded="@AriaExpanded" aria-invalid="@AriaInvalid"
                   aria-controls="@(ListOpen ? ListId : null)" aria-activedescendant="@ActiveOptionId"
                   aria-describedby="@(IsInvalid ? ErrorId : null)"
                   disabled="@Disabled" readonly="@ReadOnly"
                   value="@Value" placeholder="@EffectivePlaceholder"
                   @oninput="OnInput" @onkeydown="OnKeyDown" @onfocus="OnFocus" />
        </div>

        @if (CanEdit)
        {
            <div class="mvi-actions">
                <button type="button" class="mvi-btn" tabindex="-1" aria-expanded="@AriaPicker"
                        aria-label="Pick path (Alt+Down)"
                        @onmousedown:preventDefault="true" @onclick="TogglePicker">◈</button>
            </div>
        }

        <span class="mvi-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

        @if (_pickerOpen)
        {
            <div @ref="_popup" popover="manual" id="@ListId" class="mvi-popup mvi-popup-tree"
                 role="listbox" aria-label="Available paths">
                @{ var rows = TreeRows().ToList(); }
                @for (var i = 0; i < rows.Count; i++)
                {
                    var index = i;
                    var row = rows[index];
                    var active = index == _activeIndex;
                    var selected = active ? "true" : "false";
                    <div class="mvi-row @(active ? "is-active" : null)" id="@OptionId(index)" role="option"
                         aria-selected="@selected" style="padding-left:@(6 + row.Depth * 12)px"
                         @onmousedown:preventDefault="true" @onclick="() => OnTreeRowClick(row)">
                        <span class="mvi-bullet" @onclick="() => ToggleBranch(row)" @onclick:stopPropagation="true">@(row.Branch ? (IsCollapsed(row.Node.Path) ? "▸" : "▾") : "·")</span>
                        <span class="mvi-name">@row.Node.Name</span>
                        @if (row.Node.Type is not null)
                        {
                            <span class="mvi-type">@row.Node.Type</span>
                        }
                    </div>
                }
            </div>
        }

        @if (_suggestOpen && _suggestions.Count > 0)
        {
            <div @ref="_popup" popover="manual" id="@ListId" class="mvi-popup mvi-popup-suggest"
                 role="listbox" aria-label="Path suggestions">
                @for (var i = 0; i < _suggestions.Count; i++)
                {
                    var item = _suggestions[i];
                    var active = i == _activeIndex;
                    var selected = active ? "true" : "false";
                    <div class="mvi-row @(active ? "is-active" : null)" id="@OptionId(i)" role="option"
                         aria-selected="@selected" @key="item.Path"
                         @onmousedown:preventDefault="true" @onclick="() => PickPath(item.Path)">
                        <span class="mvi-name">@item.Path</span>
                        @if (!string.IsNullOrEmpty(item.Value))
                        {
                            <span class="mvi-value" title="@item.Value">@item.Value</span>
                        }
                        <span class="mvi-type">@item.VarType</span>
                    </div>
                }
            </div>
        }
    </div>

    @if (ValidationMessage is string message)
    {
        <div id="@ErrorId" class="mvi-error" role="alert">@message</div>
    }
</div>

@code {
    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>Allowed roots in full-path mode; null = all (<see cref="ValuePath.Roots"/>).</summary>
    [Parameter]
    public string[]? Roots { get; set; }

    /// <summary>Fixed root: value is relative to it ("Payload.x" for Root="msg") and the chip shows the root.</summary>
    [Parameter]
    public string? Root { get; set; }

    [Parameter]
    public bool ShowRoot { get; set; } = true;

    [Parameter]
    public IReadOnlyCollection<ValueFieldInfo>? Candidates { get; set; }

    /// <summary>Model member the field writes to: used to fetch candidates from the container.</summary>
    [Parameter]
    public Expression<Func<object?>>? For { get; set; }

    /// <summary>Дополнительный класс на корень компонента; биндится с атрибута class/Class и не мешает основным.</summary>
    [Parameter]
    public string? Class { get; set; }

    [CascadingParameter]
    public NodeEditContainer1? NodeEditContainer { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    ElementReference _root;
    ElementReference _body;
    ElementReference _input;
    ElementReference _popup;
    readonly string _uid = Guid.NewGuid().ToString("N")[..6];
    bool _pickerOpen;
    bool _suggestOpen;
    bool _disposed;
    int _activeIndex;
    int? _pendingCaret;
    List<ValueFieldInfo> _suggestions = [];
    readonly HashSet<string> _collapsed = [];
    IReadOnlyCollection<ValueFieldInfo>? _candidatesSource;
    List<ValueFieldInfo> _display = [];
    IReadOnlyCollection<ValueFieldInfo>? _hostFields;
    string? _hostFieldsKey;
    FieldTreeNode? _tree;
    DotNetObjectReference<MarsPathInput>? _selfRef;

    NodeFormEditorJsInterop? _js;
    bool _ownsJs;
    string? _popupKey;
    NodeFormEditorJsInterop Js => _js ??= ResolveJs();

    NodeFormEditorJsInterop ResolveJs()
    {
        if (Services.GetService(typeof(NodeFormEditorJsInterop)) is NodeFormEditorJsInterop shared)
            return shared;

        _ownsJs = true;
        return new NodeFormEditorJsInterop(JS);
    }

    string ListId => $"mpi-list-{_uid}";
    string ErrorId => $"mpi-err-{_uid}";

    bool IsRelative => Root is not null;
    string[] EffectiveRoots => Root is not null ? [Root] : Roots ?? ValuePath.Roots;
    bool CanEdit => !Disabled && !ReadOnly;
    bool ListOpen => _pickerOpen || _suggestOpen;
    bool AnyPopupOpen => ListOpen;
    bool PopupVisible => ListOpen;
    bool ShowChip => IsRelative ? ShowRoot : true;
    bool IsInvalid => ValidationMessage is not null;
    string AriaExpanded => PopupVisible ? "true" : "false";
    string AriaInvalid => IsInvalid ? "true" : "false";
    string AriaPicker => _pickerOpen ? "true" : "false";
    string? ActiveOptionId => ListOpen && _activeIndex >= 0 ? OptionId(_activeIndex) : null;

    string RootLabel => IsRelative ? Root! : "path";

    string EffectivePlaceholder => Placeholder ?? (IsRelative ? "field.name" : "msg.Payload");

    IReadOnlyCollection<ValueFieldInfo> EffectiveCandidates => Candidates ?? _hostFields ?? [];

    string? FieldName => For?.Body switch
    {
        MemberExpression member => member.Member.Name,
        UnaryExpression { Operand: MemberExpression member } => member.Member.Name,
        _ => null
    };

    string RootClass
    {
        get
        {
            var css = "mars-value-input mars-path-input mvi-const";

            if (Disabled)
                css += " mvi-disabled";

            if (ReadOnly)
                css += " mvi-readonly";

            if (IsInvalid)
                css += " mvi-invalid";

            return Class is { Length: > 0 } extra ? $"{css} {extra}" : css;
        }
    }

    IReadOnlyDictionary<string, object>? RootAttributes => AdditionalAttributes;

    string? ValidationMessage => ValidatePath(Value ?? "");

    string? ValidatePath(string value)
    {
        value = value.Trim();
        if (value.Length == 0)
            return null;

        if (!ValuePath.IsSyntaxValid(value))
            return $"Not a valid path: '{value}'";

        if (IsRelative)
        {
            var root = ValuePath.GetRoot(value);
            return root is null
                ? null
                : $"Path is relative to {Root} — drop the '{root}' prefix";
        }

        var pathRoot = ValuePath.GetRoot(value);
        if (pathRoot is null || !EffectiveRoots.Contains(pathRoot))
            return $"Root must be one of: {string.Join(", ", EffectiveRoots)}";

        if (pathRoot == nameof(VarNode) && ValuePath.GetSegments(value).Length != 2)
            return "VarNode path must be exactly 'VarNode.<name>'";

        return null;
    }

    protected override void OnParametersSet()
    {
        if (Candidates is null)
        {
            var node = NodeEditContainer?.Node;
            var key = node is null ? null : $"{node.Id}|{FieldName}|{NodeEditContainer?.ValueFieldsVersion}";

            if (_hostFieldsKey != key)
            {
                _hostFieldsKey = key;
                _hostFields = node is null ? null : NodeEditContainer!.GetValueFields(FieldName);
            }
        }

        var source = EffectiveCandidates;

        if (_tree is null || !ReferenceEquals(_candidatesSource, source))
        {
            _candidatesSource = source;
            _display = FilterCandidates(source).ToList();
            _tree = ValueFieldTree.Build(_display);
        }
    }

    IEnumerable<ValueFieldInfo> FilterCandidates(IEnumerable<ValueFieldInfo> candidates)
    {
        var relativePrefix = IsRelative ? Root + "." : null;

        foreach (var candidate in candidates)
        {
            if (relativePrefix is not null)
            {
                if (candidate.Path.StartsWith(relativePrefix, StringComparison.OrdinalIgnoreCase)
                    && candidate.Path.Length > relativePrefix.Length)
                    yield return candidate with { Path = candidate.Path[relativePrefix.Length..] };

                continue;
            }

            var root = ValuePath.GetRoot(candidate.Path);
            if (root is not null && EffectiveRoots.Contains(root, StringComparer.OrdinalIgnoreCase))
                yield return candidate;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await Js.ValueInput_Bind(_root, _input, _selfRef, nameof(OnOutsideClick), nameof(OnPasteText));
        }

        var popupKey = PopupVisible ? PopupKind : null;
        if (popupKey != _popupKey)
        {
            _popupKey = popupKey;

            if (popupKey is not null)
                await Js.ValueInput_PopupOpen(_popup, _body, "right");
        }

        if (_pendingCaret is int pos)
        {
            _pendingCaret = null;
            await Js.ValueInput_SetCaret(_input, pos);
        }
    }

    string? PopupKind => _pickerOpen ? "picker" : _suggestOpen ? "suggest" : null;

    [JSInvokable]
    public void OnOutsideClick()
    {
        if (!AnyPopupOpen)
            return;

        ClosePopups();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPasteText(string text)
    {
        if (!CanEdit || _disposed || string.IsNullOrEmpty(text))
            return;

        await SetValue(SanitizePasted(text));
        ClosePopups();
        _pendingCaret = (Value ?? "").Length;
        await InvokeAsync(StateHasChanged);
    }

    string SanitizePasted(string text)
    {
        var value = text.Trim().Trim('"').Trim();

        if (value.StartsWith('@'))
            value = value[1..].Trim();

        if (IsRelative)
        {
            var root = ValuePath.GetRoot(value);
            if (root is not null)
                value = ValuePath.GetRest(value);
        }

        return value;
    }

    string OptionId(int index) => $"mpi-opt-{_uid}-{index}";

    async Task OnInput(ChangeEventArgs e)
    {
        if (!CanEdit)
            return;

        await SetValue(e.Value?.ToString() ?? "");

        _pickerOpen = false;
        UpdateSuggestions();
    }

    void OnFocus()
    {
        if (!CanEdit || ListOpen)
            return;

        UpdateSuggestions();
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
            return;

        if (e.Key == "Escape")
        {
            ClosePopups();
            return;
        }

        if (e.CtrlKey && e.Code == "Space")
        {
            if (!CanEdit)
                return;

            UpdateSuggestions(force: true);
            return;
        }

        if (e.AltKey && e.Key == "ArrowDown")
        {
            if (CanEdit)
                TogglePicker();

            return;
        }

        if (!ListOpen)
            return;

        switch (e.Key)
        {
            case "ArrowDown":
                MoveActive(1);
                break;
            case "ArrowUp":
                MoveActive(-1);
                break;
            case "ArrowRight" when _pickerOpen:
                SetActiveBranchCollapsed(false);
                break;
            case "ArrowLeft" when _pickerOpen:
                SetActiveBranchCollapsed(true);
                break;
            case "Tab" or "Enter":
                await ActivateActive();
                break;
            case " ":
                ClosePopups();
                break;
        }
    }

    void MoveActive(int delta)
    {
        var count = _suggestOpen ? _suggestions.Count
            : _pickerOpen ? TreeRows().Count()
            : 0;

        if (count == 0)
            return;

        _activeIndex = Math.Clamp(_activeIndex + delta, 0, count - 1);
    }

    async Task ActivateActive()
    {
        if (_suggestOpen && _suggestions.Count > 0)
        {
            await PickPath(_suggestions[Math.Clamp(_activeIndex, 0, _suggestions.Count - 1)].Path);
            return;
        }

        if (_pickerOpen)
        {
            var rows = TreeRows().ToList();
            if (rows.Count == 0)
                return;

            await OnTreeRowClick(rows[Math.Clamp(_activeIndex, 0, rows.Count - 1)]);
        }
    }

    async Task OnTreeRowClick((FieldTreeNode Node, int Depth, bool Branch) row) => await PickPath(row.Node.Path);

    void ToggleBranch((FieldTreeNode Node, int Depth, bool Branch) row)
    {
        if (!row.Branch)
            return;

        if (!_collapsed.Remove(row.Node.Path))
            _collapsed.Add(row.Node.Path);
    }

    void SetActiveBranchCollapsed(bool collapsed)
    {
        var rows = TreeRows().ToList();
        if (_activeIndex < 0 || _activeIndex >= rows.Count)
            return;

        var row = rows[_activeIndex];
        if (!row.Branch)
            return;

        if (collapsed)
            _collapsed.Add(row.Node.Path);
        else
            _collapsed.Remove(row.Node.Path);
    }

    async Task PickPath(string path)
    {
        if (!CanEdit)
            return;

        await SetValue(path);
        ClosePopups();
        _pendingCaret = path.Length;
        await InvokeAsync(StateHasChanged);
    }

    void TogglePicker()
    {
        if (!CanEdit)
            return;

        _pickerOpen = !_pickerOpen;
        _suggestOpen = false;
        _activeIndex = 0;
    }

    void ClosePopups()
    {
        _pickerOpen = false;
        _suggestOpen = false;
    }

    void UpdateSuggestions(bool force = false)
    {
        _activeIndex = 0;

        if (!CanEdit)
        {
            _suggestOpen = false;
            _suggestions = [];
            return;
        }

        var value = (Value ?? "").Trim();

        _suggestions = [.. _display
            .Where(c => value.Length == 0
                        || (c.Path.StartsWith(value, StringComparison.OrdinalIgnoreCase)
                            && !string.Equals(c.Path, value, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(c => c.Path, StringComparer.OrdinalIgnoreCase)
            .Take(force ? 100 : 30)];

        _suggestOpen = _suggestions.Count > 0;
    }

    async Task SetValue(string value)
    {
        if (value == Value)
            return;

        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    bool IsCollapsed(string path) => _collapsed.Contains(path);

    IEnumerable<(FieldTreeNode Node, int Depth, bool Branch)> TreeRows() => ValueFieldTree.Rows(_tree, _collapsed);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_js is not null)
        {
            try
            {
                await _js.ValueInput_Dispose(_root, _input, _body);
            }
            catch (JSDisconnectedException)
            {
            }

            if (_ownsJs)
                await _js.DisposeAsync();
        }

        _selfRef?.Dispose();
    }
}
