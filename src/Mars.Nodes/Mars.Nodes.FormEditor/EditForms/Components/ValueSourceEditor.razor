<div class="value-source-editor">
    <div class="vse-kind">
        <button type="button" class="vse-kind-btn" tabindex="-1" @onclick="ToggleKindPopup">
            <span class="vse-kind-label">@KindLabel(ValueKind)</span><span class="vse-caret">@(_kindOpen ? "▴" : "▾")</span>
        </button>
        @if (_kindOpen)
        {
            <div class="vse-popup">
                @foreach (var kind in KindItems)
                {
                    <div class="vse-item @(kind == ValueKind ? "active" : string.Empty)" @key="kind" @onclick="() => SelectKind(kind)">@KindLabel(kind)</div>
                }
            </div>
        }
    </div>
    <div class="vse-value">
        @if (ValueKind == InputValueKind.Msg)
        {
            <FieldPathPicker Root="msg" ShowRoot="false" Value="Value" ValueChanged="SetValue" Candidates="Candidates" />
        }
        else if (ValueKind == InputValueKind.Expression)
        {
            <input class="vse-input vse-expr" type="text" value="@Value" placeholder="expression" @oninput="OnInput" />
        }
        else if (VarType == "bool")
        {
            <select class="vse-input vse-bool" @bind="BoolProxy">
                <option value="true">true</option>
                <option value="false">false</option>
            </select>
        }
        else
        {
            <input class="vse-input" type="text" value="@Value" placeholder="@ConstPlaceholder" @oninput="OnInput" />
        }
    </div>
</div>

@code {
    static readonly string[] KindItems = [InputValueKind.Const, InputValueKind.Msg, InputValueKind.Expression];
    bool _kindOpen;

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string ValueKind { get; set; } = InputValueKind.Const;

    [Parameter]
    public EventCallback<string> ValueKindChanged { get; set; }

    [Parameter]
    public string VarType { get; set; } = "string";

    [Parameter]
    public IReadOnlyCollection<string> Candidates { get; set; } = [];

    string ConstPlaceholder => VarType == VarNode.TimestampTypeName ? "empty = now (unix millis)" : VarType;

    string BoolProxy
    {
        get => Value;
        set => _ = SetValue(value);
    }

    static string KindLabel(string kind) => kind switch
    {
        InputValueKind.Msg => "msg.",
        InputValueKind.Expression => "expr",
        _ => "const",
    };

    void ToggleKindPopup() => _kindOpen = !_kindOpen;

    async Task SelectKind(string kind)
    {
        _kindOpen = false;

        if (kind == ValueKind) return;

        ValueKind = kind;
        await ValueKindChanged.InvokeAsync(kind);
    }

    async Task OnInput(ChangeEventArgs e) => await SetValue(e.Value?.ToString() ?? "");

    async Task SetValue(string value)
    {
        if (value == Value) return;

        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
