@using Mars.Admin.Framework.Components
@using Mars.Nodes.Core.Nodes.Connections
@using Mars.Nodes.FormEditor.EditForms.Components
@using Microsoft.FluentUI.AspNetCore.Components
@inherits NodeEditForm
@attribute [NodeEditFormForNode(typeof(DevAdminConnectionNode))]

<div class="vstack gap-3">

    <FormItem2 For="() => Node.Action" Class="">
        <FluentSelect @bind-Value="@Node.Action"
                      OptionText=@(s => s.ToString())
                      Items="DevAdminConnectionNode.Actions"
                      Style="width: 250px;" />
    </FormItem2>

    @if (Node.Action == DevAdminConnectionNode.ACTION_MESSAGE)
    {
        <FormItem2 For="() => Node.Message" Class="">
            <MarsValueInput Class="mvi-fill" VarType="string" Multiline Rows="3"
                            Placeholder="leave it empty for msg.payload"
                            Value="@MessageValue" ValueChanged="SetMessageValue" For="() => Node.Message" />
        </FormItem2>

        <FormItem2 For=@(() => Node.MessageRecipient)>
            <FluentSelect @bind-SelectedOption="@Node.MessageRecipient"
                          TOption="MessageRecipientType"
                          Items="Enum.GetValues<MessageRecipientType>()"
                          Style="width: 250px;">
            </FluentSelect>
        </FormItem2>

        <FormItem2 For=@(() => Node.MessageIntent)>
            <FluentSelect @bind-Value="@Node.MessageIntent"
                          TOption="Mars.Core.Models.MessageIntent"
                          OptionValue=@(s=>s.ToString())
                          OptionText=@(s=>s.ToString())
                          Items="Enum.GetValues<Mars.Core.Models.MessageIntent>()"
                          Style="width: 250px;">
            </FluentSelect>
        </FormItem2>
    }
</div>

@code {
    [CascadingParameter] Node Value { get; set; } = default!;
    DevAdminConnectionNode Node { get => (DevAdminConnectionNode)Value; set => Value = value; }

    string MessageValue => Node.MessageKind switch
    {
        InputValueKind.Expression => "@" + Node.Message,
        InputValueKind.Msg => "@msg." + Node.Message,
        _ => Node.Message,
    };

    void SetMessageValue(string value)
    {
        if (value.StartsWith('@'))
        {
            Node.MessageKind = InputValueKind.Expression;
            Node.Message = value[1..].Trim();
        }
        else
        {
            Node.MessageKind = InputValueKind.Const;
            Node.Message = value;
        }
    }
}
