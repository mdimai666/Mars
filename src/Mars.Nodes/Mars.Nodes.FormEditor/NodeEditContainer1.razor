@using Mars.Admin.Framework.Components
@using Mars.Nodes.Core.Nodes.Common
@using MarsCodeEditor2
@using Microsoft.FluentUI.AspNetCore.Components

@if (_visible && _node is not null)
{
    <div class="NodeEditContainer1 node-edit-panel">
        <header class="nep-head">
            <div class="nep-title">
                @if (_node is UnknownNode unknownNode)
                {
                    <span>(UnknownNode)@unknownNode.UnrecognizedType</span>
                }
                else
                {
                    <span>@_node?.TypeId</span>
                }
            </div>

            <div class="nep-actions">
                <DFluentDeleteButton OnConfirm="FormDeleteClick" />

                <FluentButton OnClick="FormSaveClick"
                              Loading=@saveLoading
                              Appearance="ButtonAppearance.Primary">
                    @AppRes.Save
                </FluentButton>

                <button type="button" class="nep-close" title="@AppRes.Cancel" @onclick="FormCloseClick">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </header>

        <nav class="nep-tabs">
            <button type="button" class="@(_mode == NepMode.Form ? "active" : null)" @onclick="() => SetModeAsync(NepMode.Form)">Form</button>
            <button type="button" class="@(_mode == NepMode.Docs ? "active" : null)" @onclick="() => SetModeAsync(NepMode.Docs)">Docs</button>
        </nav>

        <CascadingValue Value="this">
            <div class="nep-body">
                @if (_mode == NepMode.Form)
                {
                    <div class="nep-toolbar">
                        @if (isEditJsonMode)
                        {
                            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="CancelJsonEditMode">
                                @AppRes.Cancel
                            </FluentButton>
                        }
                        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ToggleEditMode" Title="JSON">
                            <FluentIcon Value=@(new Icons.Regular.Size24.CodeBlock()) Color="Microsoft.FluentUI.AspNetCore.Components.Color.Default" />
                        </FluentButton>
                    </div>
                }

                @* форма всегда в DOM (скрыта в JSON/Docs) — EditContext и валидация живут
                   при сохранении из любого режима, как раньше *@
                <div class="nep-form @(_mode == NepMode.Form && !isEditJsonMode ? null : "nep-form--hidden")">
                    <NodeFormEditor1 @ref=nodeFormEditor1 @bind-Node=_node OnValidSubmit=OnValidSubmit />
                </div>

                @if (_mode == NepMode.Docs)
                {
                    <DocViewer For="() => _node!.GetType()" />
                }
                else if (isEditJsonMode)
                {
                    <div class="nep-json">
                        <MarsCodeEditor2.CodeEditor2 @ref=codeEditor
                                                     Lang=@CodeEditor2.Language.json
                                                     OnSave="OnSaveFromCodeEditor"
                                                     ContainerCssStyle="height:100%"
                                                     Value=@GetModelAsJson() />
                    </div>
                }
            </div>
        </CascadingValue>
    </div>
}
