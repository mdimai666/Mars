@using Mars.Nodes.Core
@using Mars.Nodes.Core.Nodes.Common
@using Mars.Nodes.Front.Abstractions.Components.NodeViews

<div class="card-body p-2 ">
    <p class="card-text">Configs (@ConfigNodes.Count())</p>
</div>
<ul class="list-group">
    @foreach (Node node in ConfigNodes)
    {
        <li class="list-group-item px-2 py-0 border-0">
            <svg width="170" height="46" version="1.1" xmlns="http://www.w3.org/2000/svg">
                <NodeComponent Node="@node" OnDblClick=@(e => OnEditNode.InvokeAsync(node)) FixedWidth="120" />
            </svg>
        </li>
    }
</ul>

@code {
    [Parameter] public IEnumerable<ConfigNode> ConfigNodes { get; set; } = [];
    [Parameter] public EventCallback<Node> OnEditNode { get; set; }
}
