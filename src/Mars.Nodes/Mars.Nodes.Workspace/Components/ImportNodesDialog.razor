@using Mars.Admin.Framework.Components
@using Mars.Admin.Framework.Dialogs
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Mars.Contracts.Resources
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody Class="text-start">
    <TitleTemplate>
        <div class="hstack">
            <FluentIcon Value="@(new Icons.Regular.Size24.ArrowImport())" Color="Color.Info" Class="me-2" />
            <FluentText Size="TextSize.Size500">@(Dialog.Options.Header.Title ?? "Import nodes")</FluentText>
        </div>
    </TitleTemplate>
    <ChildContent>
        <div class="d-flex flex-row gap-4" style="_min-height:50vh;">
            <EditForm Model="@_json" class="flex-fill vstack">
                <FormItem2 Label="JSON" For="() => _json">
                    <FluentTextArea Rows="10" @bind-Value="@_json" Class="w-100 h-100" />
                </FormItem2>
            </EditForm>
        </div>
    </ChildContent>
    <ActionTemplate>
        <div class="hstack gap-2 justify-content-end">
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="@CancelAsync">@AppRes.Cancel</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@OkAsync">@AppRes.Import</FluentButton>
        </div>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public string Content { get; set; } = default!;

    string _json = "";

    private Task OkAsync() => Dialog.CloseAsync(_json);

    private Task CancelAsync() => Dialog.CancelAsync();

    public static Task<IDialogReference> ShowDialog(IDialogService _dialogService)
    {
        DialogParameters parameters = new()
        {
            ShowDismiss = true,
            Width = "900px",
            TrapFocus = false,
            Modal = true,
            PreventScroll = true
        };

        return _dialogService.ShowDialogAsync<ImportNodesDialog>("", parameters);
    }

}
