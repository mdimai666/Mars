@using Mars.Nodes.Contracts.NodeTaskJob
@using Mars.Nodes.Front.Abstractions.Editor.Interfaces
@using Mars.Nodes.Front.Abstractions.Services
@using Mars.Nodes.Workspace.Components.JobViews
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<FluentDialogBody Class="text-start">
    <TitleTemplate>
        <div class="hstack">
            <FluentIcon Value="@(new Icons.Regular.Size24.History())" Color="Color.Info" Class="me-2" />
            <FluentText Size="TextSize.Size500">@(Dialog.Options.Header.Title ?? "NodeTask Job result")</FluentText>
        </div>
    </TitleTemplate>
    <ChildContent>
        <div class="d-flex flex-row gap-4" style="min-height:80vh;">
            <div class="flex-fill">
                @if (_busy)
                {
                    <FluentSpinner />
                }
                else if (_model is not null)
                {
                    <NodeTaskJobResultDetailView Model="_model" Editor="Content.Editor" />
                }
                else
                {
                    <Mars.Admin.Framework.Components.SharedContentNoRecords />
                }
            </div>
        </div>
    </ChildContent>
</FluentDialogBody>

@code {
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    [Inject] INodeServiceClient _client { get; set; } = default!;

    [Parameter]
    public NodeTaskJobResultDialogModel Content { get; set; } = default!;

    private Guid TaskId => Content.TaskId;

    bool _busy;
    NodeTaskResultDetailResponse? _model;

    private Task OkAsync() => Dialog.CloseAsync();

    private Task CancelAsync() => Dialog.CancelAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) Load();
    }

    async void Load()
    {
        _busy = true;
        StateHasChanged();

        _model = await _client.JobDetail(TaskId);

        _busy = false;
        StateHasChanged();
    }

    public static void ShowDialog(IDialogService _dialogService, Guid taskId, INodeEditorApi editor)
    {
        _ = _dialogService.ShowDialogAsync<NodeTaskJobResultDialog>(new DialogOptions
        {
            Header = { Title = "NodeTask Job result", CloseAction = { Visible = true } },
            Width = "1200px",
            Modal = true,
            Parameters = { ["Content"] = new NodeTaskJobResultDialogModel(taskId, editor) }
        });
    }

}
