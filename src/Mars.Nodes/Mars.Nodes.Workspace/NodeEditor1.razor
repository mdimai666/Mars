@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons;
@using Icons16R = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16;
@using Mars.Nodes.Core
@using Mars.Nodes.Core.Nodes.Common
@using Mars.Nodes.FormEditor
@using Mars.Nodes.Workspace.ActionManager.Actions.Globals
@using Mars.Nodes.Workspace.ActionManager.Actions.NodesWorkspace
@using Mars.Nodes.Workspace.Components
@using Mars.Nodes.Workspace.EditorParts
@using Mars.Contracts.Resources
@using Microsoft.FluentUI.AspNetCore.Components

<div class="NodeEditor1 red-ui-editor container-fluid p-0 flex-fill d-flex flex-column main-fill use-fluent-typo">
    <CascadingValue Value="this">
        <div class="border-bottom shadow-sm flex-shrink-0" style="height:40px;">
            <div class="d-flex justify-content-between p-1 align-items-center">
                <div class="d-flex fs-5">

                    <div class="master-menu d-flex align-items-center">
                        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size24.Settings())" OnClick="OnSettingsButtonClick" />
                        <div class="btn-group btn-group-sm ms-3" role="group">
                            @foreach (var _tab in masterTabs)
                            {
                                var tab = _tab;
                                <input type="radio" class="btn-check" name="btnradio" id=@($"mtab-{tab.key}")
                                       autocomplete="off" checked="@(tab.key == activeMasterTab)">
                                <label class="btn btn-light rounded-5" for=@($"mtab-{tab.key}")
                                       @onclick=@(e => activeMasterTab = tab.key)>@tab.label</label>
                            }

                        </div>
                    </div>
                    <div class="vr mx-3"></div>
                    <div class="btn-group" role="group" aria-label="Basic outlined example">
                        <FluentButton OnClick="@_actionManager.Undo" IconStart="@(new Icons16R.ArrowUndo())" Disabled=!_actionManager.CanUndo Appearance="ButtonAppearance.Subtle"></FluentButton>
                        <FluentButton OnClick="@_actionManager.Redo" IconStart="@(new Icons16R.ArrowRedo())" Disabled=!_actionManager.CanRedo Appearance="ButtonAppearance.Subtle"></FluentButton>
                    </div>
                </div>

                <div class="gap-2">
                    <span>[@SelectContextString]</span>
                </div>

                <div class="d-flex align-items-center gap-2 me-2">
                    <FluentTooltip Anchor="debug-mode-switch">
                        <b>DEBUG MODE</b><br />
                        Stores the last message every node sent further (10 min, one per node output).<br />
                        Values appear in field hints and in the INPUT panel.<br />
                        Turns itself off after 30 minutes.
                    </FluentTooltip>
                    <FluentSwitch Id="debug-mode-switch"
                                  Value="DebugMode"
                                  ValueChanged="OnDebugModeSwitchChanged"
                                  Label="DEBUG">
                    </FluentSwitch>
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="OnJobListHistoryButtonClick" Title="task history">
                        <FluentIcon Value="@(new Icons.Regular.Size24.History().WithColor(Color.Default))" />
                    </FluentButton>
                    <FluentButton OnClick="@(_actionManager.ExecuteAction<TerminateAllJobsAction>)"
                                  IconStart="@(new Icons16R.DismissSquareMultiple().WithColor(Color.Default))"
                                  Class="btn-terminate-all-tasks"
                                  Title="terminate all task"
                                  Appearance="ButtonAppearance.Subtle">
                        <FluentBadge Color="BadgeColor.Informative" title="running tasks count">
                            @runningTaskCountDisplayText
                        </FluentBadge>
                    </FluentButton>

                    @if (SectionActions is not null)
                    {
                        @SectionActions
                    }

                    <FluentButton OnClick="@(_actionManager.ExecuteAction<DeployNodesAction>)"
                                  IconEnd="@(new Icons16R.SaveMultiple())"
                                  Title="Deploy nodes"
                                  Appearance="ButtonAppearance.Primary">
                        Deploy
                    </FluentButton>
                </div>
            </div>
        </div>
        <main class="d-flex no-gutters g-0 flex-fill w-100" style="min-height:0">
            <div @ref="_paletteSidebarRef" id="nodes-palette-sidebar" class="flex-shrink-0 position-absolute shadow" style="top:50px;left:10px;z-index:1;user-select:none;">
                <div class="bg-white custom-scroll1" style="overflow-y:scroll;overflow-x:hidden;scroll-behavior: auto;width:190px;max-height:500px">
                    @if (activeMasterTab == "nodes")
                    {
                        <PaletteSidebar Palette="Palette"
                                        VarNodes="varNodes"
                                        OnNodeMouseDown="OnMouseDownPaletteNode"
                                        OnNodeContextMenu="OnPaletteNodeContextMenu"
                                        OnEditVarNode="StartEditNode"
                                        OnAddVarNode="OnClickAddVarNode" />
                    }
                    else if (activeMasterTab == "tabs")
                    {
                        <FlowsTabList Flows="flows" ActiveFlow="ActiveFlow"
                                      OnSelectFlow="ChangeFlow" OnEditFlow="StartEditNode" OnAddFlow="ClickAddFlow" />
                    }
                    else if (activeMasterTab == "configs")
                    {
                        <ConfigsTabList ConfigNodes="AllNodes.Values.OfType<ConfigNode>()" OnEditNode="StartEditNode" />
                    }
                    <FluentMenu @ref="_paletteNodeContextMenu">
                        <FluentMenuList>
                            <FluentMenuItem Label="Examples" Disabled="!_currentPaletteNodeExamples.Any()">
                                <MenuItems>
                                    @foreach (var _example in _currentPaletteNodeExamples)
                                    {
                                        var example = _example;
                                        <FluentMenuItem Label="@example.Name" OnClick="@(() => UseExample(example))" />
                                    }
                                </MenuItems>
                            </FluentMenuItem>
                        </FluentMenuList>
                    </FluentMenu>
                </div>
            </div>
            <FluentMultiSplitter Orientation="_editorSpaceOrientation ?? Orientation.Horizontal" BarSize="6px" Class="w-100 h-100">
                <FluentMultiSplitterPane Min="15%">
                    <div class="h-100 w-100" style="position:relative">
                        <NodeWorkspace1 @ref=_nodeWorkspace1
                                        Style=""
                                        Class="h-100"
                                        OnInject="OnInject"
                                        FlowNodes=FlowNodes
                                        OnMouseEnter="OnWorkspaceMouseEnter"
                                        OnClickNode="OnClickNode"
                                        OnDblClickNode="OnDblClickNode"
                                        OnNodeContextMenu="OnNodeContextMenu"
                                        OnWireContextMenu="OnWireContextMenu"
                                        OnWorkspaceClick="OnWorkspaceClick"
                                        OnWorkspaceDblClick="OnWorkspaceDblClick">
                            <QuickNodeAddMenu Palette="Palette"
                                              @ref=quickNodeAddMenu
                                              OnSelectNode="QuickNodeAddMenuOnSelectNode"
                                              OnNodeContextMenu="OnPaletteNodeContextMenu" />
                            <FluentMenu @ref="_workspaceContextMenu">
                                <FluentMenuList>
                                @if (_selectContext == typeof(Node))
                                {
                                    foreach (var item in NodeContextMenuItems)
                                    {
                                        <FluentMenuItem OnClick="@(() => OnNodeContextMenuItemClick(item.Key))">@item.Value</FluentMenuItem>
                                    }
                                    <FluentMenuItem Label="Examples" Disabled="!_currentPaletteNodeExamples.Any()">
                                        <MenuItems>
                                            @foreach (var _example in _currentPaletteNodeExamples)
                                            {
                                                var example = _example;
                                                <FluentMenuItem Label="@example.Name" OnClick="@(() => UseExample(example))" />
                                            }
                                        </MenuItems>
                                    </FluentMenuItem>
                                }
                                else if (_selectContext == typeof(Wire))
                                {
                                    foreach (var item in WireContextMenuItems)
                                    {
                                        <FluentMenuItem OnClick="@(() => OnWireContextMenuItemClick(item.Key))">@item.Value</FluentMenuItem>
                                    }
                                }
                                </FluentMenuList>
                            </FluentMenu>
                        </NodeWorkspace1>
                    </div>
                </FluentMultiSplitterPane>
                <FluentMultiSplitterPane Size="20%" Min="200px">
                    <div class="console-panel d-flex flex-column" style="height: 100%; min-height: 0;">
                        @if (DebugMode)
                        {
                            <NodeInputViewer Node="_selectedNode" Nodes="AllNodes" />
                        }
                        <DebugMessagesConsole @ref="_debugMessagesConsole" />
                    </div>
                </FluentMultiSplitterPane>
            </FluentMultiSplitter>
            <NodeEditContainer1 @ref=nodeEditContainer1
                                OnSave="OnEditFormSaveNodeClick"
                                OnDelete="DeleteNode"
                                OnClickEditConfigNode=OnClickEditConfigNode
                                OnClickNewConfigNode=OnClickNewConfigNode />
        </main>
    </CascadingValue>
</div>

<style>
    .btn-terminate-all-tasks:hover {
        color: red;
    }

    #debug-mode-switch[checked]::part(checked-indicator) {
        background: #7a2101;
    }
</style>

@code {
    public RenderFragment MainActionMenuItems => @<text>
        <FluentMenuItem Label="@AppRes.Import" OnClick="ActionManager.ExecuteAction<OpenImportWindowAction>" />
        <FluentMenuItem Label="@AppRes.Export" OnClick="ActionManager.ExecuteAction<OpenExportWindowAction>" />
    </text>;
}
