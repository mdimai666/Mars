<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--Project-->

        <!--Author-->
        <!--Not published-->
        <PackageId>mdimai666.Mars.PxBlocks.Host</PackageId>
        <PackageVersion>$(MarsAppVersion)</PackageVersion>
        <Version>$(MarsAppVersion)</Version>
        <Authors>mdimai666</Authors>
        <Company>mdimai666</Company>
        <Product>Mars.PxBlocks.Host</Product>
        <PackageTags>Mars;PxBlocks;</PackageTags>
        <Description>
            PxBlock — это Programming x Block: среда, где код собирается как конструктор.
            Host: серверное исполнение PxBlocks-программ (api/PxBlocks + SignalR-стриминг событий),
            организация — по образцу Mars.Nodes.Host.
        </Description>
        <PackageIcon>icon-nuget.png</PackageIcon>
        <PackageProjectUrl>https://github.com/mdimai666/Mars</PackageProjectUrl>
        <RepositoryUrl>https://github.com/mdimai666/Mars</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\assets\icon-nuget.png" Pack="true" PackagePath="\" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mars.PxBlocks.Host.Shared\Mars.PxBlocks.Host.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Test.Mars.PxBlocks</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
