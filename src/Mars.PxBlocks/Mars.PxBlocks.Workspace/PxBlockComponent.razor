@using Mars.PxBlocks.Shared
@namespace Mars.PxBlocks.Workspace

@((MarkupString)BuildSvg())

@code {
    [Parameter] public PxBlock Block { get; set; } = default!;
    [Parameter] public float RenderX { get; set; } = float.NaN;
    [Parameter] public float RenderY { get; set; } = float.NaN;

    private string BuildSvg()
    {
        float x = float.IsNaN(RenderX) ? Block.X : RenderX;
        float y = float.IsNaN(RenderY) ? Block.Y : RenderY;

        float width, height;
        string bodyPath;
        bool isHat = Block is PxBlockHat;
        bool isValue = Block is PxBlockValue;
        bool hasStatementInput = Block.Inputs.Any(i => i.Type == PxInputType.Statement);

        if (isHat)
        {
            (width, height) = PxBlockSvgHelper.MeasureBlock(Block.DisplayName, Block.Fields.Count, Block.Inputs.Count);
            bodyPath = PxBlockSvgHelper.HatBlockPath(width, height, hasStatementInput);
        }
        else if (isValue)
        {
            (width, height) = PxBlockSvgHelper.MeasureBlock(Block.DisplayName, Block.Fields.Count, Block.Inputs.Count);
            width += PxBlockSvgHelper.ValueOutputWidth;
            bodyPath = PxBlockSvgHelper.ValueBlockPath(width, height);
        }
        else
        {
            (width, height) = PxBlockSvgHelper.MeasureBlock(Block.DisplayName, Block.Fields.Count, Block.Inputs.Count);
            bodyPath = PxBlockSvgHelper.StatementBlockPath(width, height, hasStatementInput);
        }

        float bodyBottom = height; // Shadow overlays the bottom of the body
        float textY = PxBlockSvgHelper.RowHeight / 2 + 4;
        float si = hasStatementInput ? PxBlockSvgHelper.StatementIndent : 0;

        string darker = Darken(Block.Color, 0.15f);
        string lighter = Lighten(Block.Color, 0.12f);

        var sb = new System.Text.StringBuilder();

        float translateX = x + (isValue ? PxBlockSvgHelper.ValueOutputWidth : 0);
        float translateY = y;

        sb.Append($"<g class=\"px-block {(Block.IsDragging ? "dragging" : "")}\" ");
        sb.Append($"transform=\"translate({translateX:F1}, {translateY:F1})\" ");
        sb.Append($"style=\"cursor:grab;{(Block.IsDragging ? "opacity:0.90;" : "")}\" ");
        sb.Append($"data-block-id=\"{Block.Id}\">");

        // --- Shadow (bottom strip overlay) ---
        sb.Append($"<path d=\"{PxBlockSvgHelper.ShadowPath(width, bodyBottom)}\" ");
        sb.Append($"fill=\"{darker}\" />");

        // --- Main body ---
        sb.Append($"<path d=\"{bodyPath}\" fill=\"{Block.Color}\" />");

        // --- Highlight (top strip) ---
        if (!isHat)
        {
            sb.Append($"<path d=\"{PxBlockSvgHelper.HighlightPath(width, PxBlockSvgHelper.NotchHeight)}\" ");
            sb.Append($"fill=\"{lighter}\" opacity=\"0.5\" />");
        }

        // --- Fields or label ---
        float fx = PxBlockSvgHelper.FieldPadding + si + 2;
        if (Block.Fields.Count == 0)
        {
            sb.Append(SvgText(fx, textY, "white", "13", "600", Block.DisplayName));
        }
        else
        {
            foreach (var field in Block.Fields)
            {
                float fw = EstimateFieldWidth(field);
                sb.Append(RenderFieldSvg(field, fx, textY, fw, Block.Color));
                fx += fw + 4;
            }
        }

        // --- Inputs ---
        for (int i = 0; i < Block.Inputs.Count; i++)
        {
            var input = Block.Inputs[i];
            float iy = PxBlockSvgHelper.RowHeight + i * PxBlockSvgHelper.RowHeight;
            float rowMid = iy + PxBlockSvgHelper.RowHeight / 2;

            if (input.Type == PxInputType.Statement)
            {
                // Statement socket
                float socketStart = iy + 4;
                float socketEnd = iy + PxBlockSvgHelper.RowHeight - 4;
                sb.Append($"<path d=\"{PxBlockSvgHelper.StatementSocketPath(width, socketStart, socketEnd)}\" ");
                sb.Append($"fill=\"{darker}\" opacity=\"0.5\" rx=\"3\" />");
            }
            else
            {
                // Value input socket
                sb.Append($"<rect x=\"{width - 14:F1}\" y=\"{rowMid - 6:F1}\" ");
                sb.Append($"width=\"12\" height=\"12\" fill=\"white\" opacity=\"0.85\" ");
                sb.Append($"stroke=\"{darker}\" stroke-width=\"1\" rx=\"2\" />");
            }

            if (!string.IsNullOrEmpty(input.Name))
                sb.Append(SvgText(PxBlockSvgHelper.FieldPadding + si, rowMid + 4, "rgba(255,255,255,0.75)", "11", "500", input.Name));
        }

        sb.Append("</g>");
        return sb.ToString();
    }

    // --- Field rendering ---

    private string GetFieldDataAttrs(PxField field) =>
        $"data-block-id=\"{Block.Id}\" data-field-name=\"{field.Name}\" data-field-type=\"{field.GetType().Name}\"";

    private string FieldWrap(PxField field, float x, float y, float w, string inner)
    {
        if (field is PxLabelField)
            return inner; // Labels are not editable, no data attrs needed

        // Add an invisible clickable rect + wrap in g with data attrs
        return $"<g {GetFieldDataAttrs(field)}>" +
               $"<rect x=\"{x - 1:F1}\" y=\"{y - 10:F1}\" width=\"{w + 2:F1}\" height=\"20\" " +
               $"fill=\"transparent\" style=\"cursor:text;\" />" +
               inner +
               $"</g>";
    }

    private string RenderFieldSvg(PxField field, float x, float y, float w, string blockColor)
    {
        string darker = Darken(blockColor, 0.2f);

        string inner = field switch
        {
            PxLabelField label =>
                SvgText(x, y, "white", "13", "600", label.Text),

            PxTextField tf =>
                FieldBg(x, y, w, darker) +
                SvgText(x + 5, y, "#333", "12", "400", string.IsNullOrEmpty(tf.Value) ? tf.Placeholder ?? "" : tf.Value),

            PxNumberField nf =>
                FieldBg(x, y, w, darker) +
                SvgText(x + 5, y, "#333", "12", "400", nf.Value.ToString()),

            PxDropdownField df =>
                FieldBg(x, y, w, darker) +
                SvgText(x + 5, y, "#333", "12", "400", df.SelectedValue) +
                $"<text x=\"{x + w - 12:F1}\" y=\"{y + 1:F1}\" fill=\"#999\" font-size=\"9\" " +
                $"font-family=\"Segoe UI, sans-serif\" dominant-baseline=\"middle\">\u25BC</text>",

            PxCheckboxField cf =>
                $"<rect x=\"{x:F1}\" y=\"{y - 8:F1}\" width=\"16\" height=\"16\" " +
                $"fill=\"{(cf.Checked ? "white" : "rgba(255,255,255,0.25)")}\" " +
                $"stroke=\"white\" stroke-width=\"1.5\" rx=\"2\" />" +
                (cf.Checked ? SvgText(x + 3, y + 1, blockColor, "14", "600", "\u2713") : ""),

            PxVariableField vf =>
                FieldBg(x, y, w, darker) +
                SvgText(x + 5, y, "#333", "12", "400", vf.VariableName),

            _ => SvgText(x, y, "white", "12", "400", "?")
        };

        return FieldWrap(field, x, y, w, inner);
    }

    private static string FieldBg(float x, float y, float w, string darker) =>
        $"<rect x=\"{x - 1:F1}\" y=\"{y - 9:F1}\" width=\"{w:F1}\" height=\"18\" " +
        $"fill=\"white\" stroke=\"{darker}\" stroke-width=\"1\" rx=\"3\" />";

    private static string SvgText(float x, float y, string fill, string fontSize, string weight, string content) =>
        $"<text x=\"{x:F1}\" y=\"{y:F1}\" fill=\"{fill}\" font-size=\"{fontSize}\" " +
        $"font-weight=\"{weight}\" font-family=\"Segoe UI, sans-serif\" " +
        $"dominant-baseline=\"middle\">{System.Net.WebUtility.HtmlEncode(content)}</text>";

    // --- Color helpers ---

    private static string Darken(string hex, float amount)
    {
        if (hex.StartsWith("#") && hex.Length == 7)
        {
            int r = (int)(Convert.ToInt32(hex[1..3], 16) * (1 - amount));
            int g = (int)(Convert.ToInt32(hex[3..5], 16) * (1 - amount));
            int b = (int)(Convert.ToInt32(hex[5..7], 16) * (1 - amount));
            return $"#{Math.Clamp(r, 0, 255):X2}{Math.Clamp(g, 0, 255):X2}{Math.Clamp(b, 0, 255):X2}";
        }
        return "#333";
    }

    private static string Lighten(string hex, float amount)
    {
        if (hex.StartsWith("#") && hex.Length == 7)
        {
            int r = (int)(Convert.ToInt32(hex[1..3], 16) + (255 - Convert.ToInt32(hex[1..3], 16)) * amount);
            int g = (int)(Convert.ToInt32(hex[3..5], 16) + (255 - Convert.ToInt32(hex[3..5], 16)) * amount);
            int b = (int)(Convert.ToInt32(hex[5..7], 16) + (255 - Convert.ToInt32(hex[5..7], 16)) * amount);
            return $"#{Math.Clamp(r, 0, 255):X2}{Math.Clamp(g, 0, 255):X2}{Math.Clamp(b, 0, 255):X2}";
        }
        return "#fff";
    }

    private static float EstimateFieldWidth(PxField field)
    {
        return field switch
        {
            PxLabelField l => l.Text.Length * 7f + 6,
            PxTextField t => Math.Max(40f, (t.Value.Length > 0 ? t.Value.Length : (t.Placeholder?.Length ?? 3)) * 7.5f + 12),
            PxNumberField n => n.Value.ToString().Length * 7.5f + 14,
            PxDropdownField d => d.SelectedValue.Length * 7f + 18,
            PxCheckboxField _ => 24f,
            PxVariableField v => v.VariableName.Length * 7f + 12,
            _ => 40f
        };
    }
}
