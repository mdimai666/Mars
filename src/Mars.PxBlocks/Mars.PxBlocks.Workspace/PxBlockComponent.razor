@using Mars.PxBlocks.Shared
@namespace Mars.PxBlocks.Workspace

@{
    float x = float.IsNaN(RenderX) ? Block.X : RenderX;
    float y = float.IsNaN(RenderY) ? Block.Y : RenderY;

    bool isHat = Block is PxBlockHat;
    bool isValue = Block is PxBlockValue;
    bool hasStmtInput = Block.Inputs.Any(i => i.Type == PxInputType.Statement);

    float totalFieldW = PxBlockSvgHelper.TotalFieldWidth(Block.Fields);
    float bodyH = PxBlockSvgHelper.BodyH(Block.Inputs.Count);
    float width;
    string bodyPath;

    if (isHat)
    {
        width = PxBlockSvgHelper.StatementWidth(totalFieldW);
        if (hasStmtInput) width = Math.Max(width, PxBlockSvgHelper.StatementIndent * 2 + PxBlockSvgHelper.R * 2 + PxBlockSvgHelper.TabW * 4);
        bodyPath = PxBlockSvgHelper.HatPath(width, bodyH, hasStmtInput);
    }
    else if (isValue)
    {
        width = PxBlockSvgHelper.ValueWidth(totalFieldW);
        bodyPath = PxBlockSvgHelper.ValuePath(width);
    }
    else
    {
        width = PxBlockSvgHelper.StatementWidth(totalFieldW);
        if (hasStmtInput) width = Math.Max(width, PxBlockSvgHelper.StatementIndent * 2 + PxBlockSvgHelper.R * 2 + PxBlockSvgHelper.TabW * 4);
        bodyPath = PxBlockSvgHelper.StatementPath(width, bodyH, hasStmtInput);
    }

    string darker = Darken(Block.Color, 0.15f);

    float tx = x + (isValue ? PxBlockSvgHelper.ValueConnR : 0);
    float ty = y;

    float labelY = isHat ? PxBlockSvgHelper.LabelYHat : PxBlockSvgHelper.LabelYStmt;
    float fx = PxBlockSvgHelper.FieldPadX;
}

<g class="px-block @(Block.IsDragging ? "dragging" : "")"
   transform="translate(@(tx.ToString("F1", Inv)), @(ty.ToString("F1", Inv)))"
   style="cursor:grab;@(Block.IsDragging ? "opacity:0.90;" : "")"
   data-block-id="@Block.Id">

    <path d="@bodyPath" fill="@Block.Color" stroke="@darker" stroke-width="1.5" />

    @if (Block.Fields.Count == 0)
    {
        <text><text x="@(fx.ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
              fill="white" font-size="13" font-weight="600"
              font-family="Segoe UI, sans-serif" dominant-baseline="central">@Block.DisplayName</text></text>
    }
    else @foreach (var _field in Block.Fields)
    {
        var field = _field;
        float fw = PxBlockSvgHelper.EstimateFieldWidth(field);
        float fcy = labelY - PxBlockSvgHelper.RowH / 2;

        @if (field is PxLabelField lab)
        {
            <text><text x="@(fx.ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                  fill="white" font-size="13" font-weight="600"
                  font-family="Segoe UI, sans-serif" dominant-baseline="central">@lab.Text</text></text>
        }
        else
        {
            <g data-block-id="@Block.Id" data-field-name="@field.Name" data-field-type="@field.GetType().Name">
                <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                      width="@((fw + 2).ToString("F1", Inv))" height="@(PxBlockSvgHelper.RowH.ToString("F0"))"
                      fill="transparent" style="cursor:text;" />
                @{
                    string dd = Darken(Block.Color, 0.2f);
                }
                @switch (field)
                {
                    case PxTextField tf:
                        <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                              width="@(fw.ToString("F1", Inv))" height="@(PxBlockSvgHelper.RowH.ToString("F0"))"
                              fill="white" stroke="@dd" stroke-width="1" rx="3" />
                        <text><text x="@((fx + 5).ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                              fill="#333" font-size="12" font-weight="400"
                              font-family="Segoe UI, sans-serif" dominant-baseline="central">
                            @(string.IsNullOrEmpty(tf.Value) ? tf.Placeholder ?? "" : tf.Value)
                        </text></text>
                        break;
                    case PxNumberField nf:
                        <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                              width="@(fw.ToString("F1", Inv))" height="@(PxBlockSvgHelper.RowH.ToString("F0"))"
                              fill="white" stroke="@dd" stroke-width="1" rx="3" />
                        <text><text x="@((fx + 5).ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                              fill="#333" font-size="12" font-weight="400"
                              font-family="Segoe UI, sans-serif" dominant-baseline="central">@nf.Value</text></text>
                        break;
                    case PxDropdownField df:
                        <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                              width="@(fw.ToString("F1", Inv))" height="@(PxBlockSvgHelper.RowH.ToString("F0"))"
                              fill="white" stroke="@dd" stroke-width="1" rx="3" />
                        <text><text x="@((fx + 5).ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                              fill="#333" font-size="12" font-weight="400"
                              font-family="Segoe UI, sans-serif" dominant-baseline="central">@df.SelectedValue</text></text>
                        <text><text x="@((fx + fw - 12).ToString("F1", Inv))" y="@((labelY + 1).ToString("F1", Inv))"
                              fill="#999" font-size="9" font-family="Segoe UI, sans-serif"
                              dominant-baseline="central">\u25BC</text></text>
                        break;
                    case PxCheckboxField cf:
                        <rect x="@(fx.ToString("F1", Inv))" y="@((labelY - 8).ToString("F1", Inv))"
                              width="16" height="16"
                              fill="@(cf.Checked ? "white" : "rgba(255,255,255,0.25)")"
                              stroke="white" stroke-width="1.5" rx="2" />
                        @if (cf.Checked)
                        {
                            <text><text x="@((fx + 3).ToString("F1", Inv))" y="@((labelY + 1).ToString("F1", Inv))"
                                  fill="@Block.Color" font-size="14" font-weight="600"
                                  font-family="Segoe UI, sans-serif" dominant-baseline="central">\u2713</text></text>
                        }
                        break;
                    case PxVariableField vf:
                        <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                              width="@(fw.ToString("F1", Inv))" height="@(PxBlockSvgHelper.RowH.ToString("F0"))"
                              fill="white" stroke="@dd" stroke-width="1" rx="3" />
                        <text><text x="@((fx + 5).ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                              fill="#333" font-size="12" font-weight="400"
                              font-family="Segoe UI, sans-serif" dominant-baseline="central">@vf.VariableName</text></text>
                        break;
                    default:
                        <text><text x="@(fx.ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                              fill="white" font-size="12" font-weight="400"
                              font-family="Segoe UI, sans-serif" dominant-baseline="central">?</text></text>
                        break;
                }
            </g>
        }
        fx += fw + 4;
    }

    @for (int i = 0; i < Block.Inputs.Count; i++)
    {
        var input = Block.Inputs[i];
        float rowTop = isHat
            ? PxBlockSvgHelper.InputRowTopHat(i)
            : PxBlockSvgHelper.InputRowTopStmt(i);
        float rowMid = rowTop + PxBlockSvgHelper.RowH / 2;

        if (input.Type == PxInputType.Statement)
        {
            float connX = PxBlockSvgHelper.StatementIndent + PxBlockSvgHelper.R;
            float connW = width - PxBlockSvgHelper.StatementIndent * 2 - PxBlockSvgHelper.R * 2;
            <path d="@PxBlockSvgHelper.StatementConnectorPath(connW)"
                  fill="@Block.Color" stroke="@darker" stroke-width="1"
                  transform="translate(@(connX.ToString("F1", Inv)), @(rowTop.ToString("F1", Inv)))" />
        }
        else
        {
            float slotX = PxBlockSvgHelper.ValueSlotX(width);
            <path d="@PxBlockSvgHelper.ValueConnectorPath(40)"
                  fill="white" opacity="0.85" stroke="@darker" stroke-width="1"
                  transform="translate(@(slotX.ToString("F1", Inv)), @(rowMid.ToString("F1", Inv)))" />
        }

        @if (!string.IsNullOrEmpty(input.Name))
        {
            <text><text x="@(PxBlockSvgHelper.FieldPadX.ToString("F1", Inv))" y="@(rowMid.ToString("F1", Inv))"
                  fill="rgba(255,255,255,0.75)" font-size="11" font-weight="500"
                  font-family="Segoe UI, sans-serif" dominant-baseline="central">@input.Name</text></text>
        }
    }

    @* Statement children (chain via NextBlockId) *@
    @{
        string? nextId = (Block as PxBlockCommand)?.NextBlockId ?? (Block as PxBlockHat)?.NextBlockId;
    }
    @if (nextId != null && TryGetBlock != null)
    {
        var child = TryGetBlock(nextId);
        if (child != null)
        {
            <PxBlockComponent Block="child"
                              RenderX="@(child.X - x)"
                              RenderY="@(child.Y - y)"
                              TryGetBlock="TryGetBlock" />
        }
    }

    @* Value children (connected to value inputs) *@
    @for (int i = 0; i < Block.Inputs.Count; i++)
    {
        var input = Block.Inputs[i];
        if (input.Type == PxInputType.Value && input.ConnectedBlockId != null && TryGetBlock != null)
        {
            var child = TryGetBlock(input.ConnectedBlockId);
            if (child != null)
            {
                float cRowTop = isHat
                    ? PxBlockSvgHelper.InputRowTopHat(i)
                    : PxBlockSvgHelper.InputRowTopStmt(i);
                float cRowMid = cRowTop + PxBlockSvgHelper.RowH / 2;
                float cSlotX = PxBlockSvgHelper.ValueSlotX(width);
                <PxBlockComponent Block="child"
                                  RenderX="@(cSlotX + PxBlockSvgHelper.ValueConnR)"
                                  RenderY="@(cRowMid - PxBlockSvgHelper.ValueH / 2)"
                                  TryGetBlock="TryGetBlock" />
            }
        }
    }
</g>

@code {
    [Parameter] public PxBlock Block { get; set; } = default!;
    [Parameter] public float RenderX { get; set; } = float.NaN;
    [Parameter] public float RenderY { get; set; } = float.NaN;
    [Parameter] public Func<string, PxBlock?>? TryGetBlock { get; set; }

    private static readonly IFormatProvider Inv = System.Globalization.CultureInfo.InvariantCulture;

    private static string Darken(string h, float a)
    {
        if (h.StartsWith("#") && h.Length == 7)
        {
            int r = (int)(Convert.ToInt32(h[1..3], 16) * (1 - a));
            int g = (int)(Convert.ToInt32(h[3..5], 16) * (1 - a));
            int b = (int)(Convert.ToInt32(h[5..7], 16) * (1 - a));
            return $"#{Math.Clamp(r, 0, 255):X2}{Math.Clamp(g, 0, 255):X2}{Math.Clamp(b, 0, 255):X2}";
        }
        return "#333";
    }

    private static string Lighten(string h, float a)
    {
        if (h.StartsWith("#") && h.Length == 7)
        {
            int r = (int)(Convert.ToInt32(h[1..3], 16) + (255 - Convert.ToInt32(h[1..3], 16)) * a);
            int g = (int)(Convert.ToInt32(h[3..5], 16) + (255 - Convert.ToInt32(h[3..5], 16)) * a);
            int b = (int)(Convert.ToInt32(h[5..7], 16) + (255 - Convert.ToInt32(h[5..7], 16)) * a);
            return $"#{Math.Clamp(r, 0, 255):X2}{Math.Clamp(g, 0, 255):X2}{Math.Clamp(b, 0, 255):X2}";
        }
        return "#fff";
    }
}
