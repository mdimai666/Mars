@using Mars.PxBlocks.Shared
@namespace Mars.PxBlocks.Workspace

@{
    float x = float.IsNaN(RenderX) ? Block.X : RenderX;
    float y = float.IsNaN(RenderY) ? Block.Y : RenderY;

    bool isHat = Block is PxBlockHat;
    bool isValue = Block is PxBlockValue;
    bool isChild = !float.IsNaN(RenderX);

    var stmtInputs = Block.Inputs.Where(i => i.Type == PxInputType.Statement).ToList();
    var valInputs = Block.Inputs.Where(i => i.Type == PxInputType.Value).ToList();
    int stmtCount = stmtInputs.Count;
    bool hasC = stmtCount > 0;

    float totalFieldW = PxBlockSvgHelper.TotalFieldW(Block.Fields);

    float bodyH = PxBlockSvgHelper.BodyH(stmtCount);
    float width;
    string bodyPath;

    if (isHat)
    {
        width = PxBlockSvgHelper.StmtWidth(totalFieldW);
        if (hasC) width = Math.Max(width, PxBlockSvgHelper.C_INDENT * 2);
        bodyPath = PxBlockSvgHelper.HatPath(width, bodyH, hasC);
    }
    else if (isValue)
    {
        width = PxBlockSvgHelper.ValWidth(totalFieldW);
        bodyPath = PxBlockSvgHelper.ValPath(width);
    }
    else
    {
        width = PxBlockSvgHelper.StmtWidth(totalFieldW);
        if (hasC) width = Math.Max(width, PxBlockSvgHelper.C_INDENT * 2);
        bodyPath = PxBlockSvgHelper.StmtPath(width, bodyH, hasC);
    }

    string darker = Darken(Block.Color, 0.15f);

    float tx = x;
    float ty = y;

    float labelY = PxBlockSvgHelper.LabelY(isHat);
    float fx = PxBlockSvgHelper.MEDIUM_PAD;
}

<g class="px-block @(Block.IsDragging ? "dragging" : "")"
   transform="translate(@(tx.ToString("F1", Inv)), @(ty.ToString("F1", Inv)))"
   style="cursor:grab;@(Block.IsDragging ? "opacity:0.90;" : "")"
   data-block-id="@Block.Id">

    <path d="@bodyPath" fill="@Block.Color" stroke="@darker" stroke-width="1.5" />

    @* Fields and labels *@
    @if (Block.Fields.Count == 0 && !isValue)
    {
        <text><text x="@(fx.ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
              fill="white" font-size="12" font-weight="600"
              font-family="Segoe UI, sans-serif" dominant-baseline="central">@Block.DisplayName</text></text>
    }
    else @foreach (var _field in Block.Fields)
    {
        var field = _field;
        float fw = PxBlockSvgHelper.FieldW(field);
        float fcy = labelY - PxBlockSvgHelper.ROW_H / 2;

        @if (field is PxLabelField lab)
        {
            <text><text x="@(fx.ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                  fill="white" font-size="12" font-weight="600"
                  font-family="Segoe UI, sans-serif" dominant-baseline="central">@lab.Text</text></text>
        }
        else
        {
            <g data-block-id="@Block.Id" data-field-name="@field.Name" data-field-type="@field.GetType().Name">
                <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                      width="@((fw + 2).ToString("F1", Inv))" height="@(PxBlockSvgHelper.ROW_H.ToString("F0"))"
                      fill="transparent" style="cursor:text;" />
                @{ string dd = Darken(Block.Color, 0.2f); }
                @switch (field)
                {
                    case PxTextField tf:
                        <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                              width="@(fw.ToString("F1", Inv))" height="@(PxBlockSvgHelper.ROW_H.ToString("F0"))"
                              fill="white" stroke="@dd" stroke-width="1" rx="3" />
                        <text><text x="@((fx + 5).ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                              fill="#333" font-size="12" font-weight="400"
                              font-family="Segoe UI, sans-serif" dominant-baseline="central">
                            @(string.IsNullOrEmpty(tf.Value) ? tf.Placeholder ?? "" : tf.Value)
                        </text></text>
                        break;
                    case PxNumberField nf:
                        <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                              width="@(fw.ToString("F1", Inv))" height="@(PxBlockSvgHelper.ROW_H.ToString("F0"))"
                              fill="white" stroke="@dd" stroke-width="1" rx="3" />
                        <text><text x="@((fx + 5).ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                              fill="#333" font-size="12" font-weight="400"
                              font-family="Segoe UI, sans-serif" dominant-baseline="central">@nf.Value</text></text>
                        break;
                    case PxDropdownField df:
                        <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                              width="@(fw.ToString("F1", Inv))" height="@(PxBlockSvgHelper.ROW_H.ToString("F0"))"
                              fill="white" stroke="@dd" stroke-width="1" rx="3" />
                        <text><text x="@((fx + 5).ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                              fill="#333" font-size="12" font-weight="400"
                              font-family="Segoe UI, sans-serif" dominant-baseline="central">@df.SelectedValue</text></text>
                        <text><text x="@((fx + fw - 12).ToString("F1", Inv))" y="@((labelY + 1).ToString("F1", Inv))"
                              fill="#999" font-size="9" font-family="Segoe UI, sans-serif"
                              dominant-baseline="central">&#x25BC;</text></text>
                        break;
                    case PxCheckboxField cf:
                        <rect x="@(fx.ToString("F1", Inv))" y="@((labelY - 8).ToString("F1", Inv))"
                              width="16" height="16"
                              fill="@(cf.Checked ? "white" : "rgba(255,255,255,0.25)")"
                              stroke="white" stroke-width="1.5" rx="2" />
                        @if (cf.Checked)
                        {
                            <text><text x="@((fx + 3).ToString("F1", Inv))" y="@((labelY + 1).ToString("F1", Inv))"
                                  fill="@Block.Color" font-size="14" font-weight="600"
                                  font-family="Segoe UI, sans-serif" dominant-baseline="central">&#x2713;</text></text>
                        }
                        break;
                    case PxVariableField vf:
                        <rect x="@((fx - 1).ToString("F1", Inv))" y="@(fcy.ToString("F1", Inv))"
                              width="@(fw.ToString("F1", Inv))" height="@(PxBlockSvgHelper.ROW_H.ToString("F0"))"
                              fill="white" stroke="@dd" stroke-width="1" rx="3" />
                        <text><text x="@((fx + 5).ToString("F1", Inv))" y="@(labelY.ToString("F1", Inv))"
                              fill="#333" font-size="12" font-weight="400"
                              font-family="Segoe UI, sans-serif" dominant-baseline="central">@vf.VariableName</text></text>
                        break;
                }
            </g>
        }
        fx += fw + 6;
    }

    @* Value inputs — inline after fields *@
    @if (!isValue && valInputs.Count > 0)
    {
        @for (int vi = 0; vi < valInputs.Count; vi++)
        {
            var input = valInputs[vi];
            float slotX = fx;
            float slotY = labelY;

            @if (input.ConnectedBlockId != null && TryGetBlock != null)
            {
                var child = TryGetBlock(input.ConnectedBlockId);
                if (child != null)
                {
                    <PxBlockComponent Block="child"
                                      RenderX="@slotX"
                                      RenderY="@(slotY - PxBlockSvgHelper.VALUE_H / 2)"
                                      TryGetBlock="TryGetBlock" />
                }
            }
            else
            {
                @* Empty value slot — rounded rectangle *@
                <rect x="@((slotX - 1).ToString("F1", Inv))" y="@((slotY - PxBlockSvgHelper.VALUE_H / 2).ToString("F1", Inv))"
                      width="48" height="@PxBlockSvgHelper.VALUE_H"
                      fill="white" opacity="0.3" stroke="@darker" stroke-width="1" rx="16" />
            }
            fx += 48 + 6;
        }
    }

    @* Statement input labels and C-gap children *@
    @for (int si = 0; si < stmtInputs.Count; si++)
    {
        var input = stmtInputs[si];
        float rowY = PxBlockSvgHelper.StmtInputY(si, isHat);
        float rowMid = rowY + PxBlockSvgHelper.ROW_H / 2;
        float cGapX = PxBlockSvgHelper.CGapX();

        @if (!string.IsNullOrEmpty(input.Name))
        {
            <text><text x="@(cGapX.ToString("F1", Inv))" y="@(rowMid.ToString("F1", Inv))"
                  fill="rgba(255,255,255,0.75)" font-size="11" font-weight="500"
                  font-family="Segoe UI, sans-serif" dominant-baseline="central">@input.Name</text></text>
        }

        @* Render connected block inside C-gap *@
        @if (input.ConnectedBlockId != null && TryGetBlock != null)
        {
            var child = TryGetBlock(input.ConnectedBlockId);
            if (child != null)
            {
                <PxBlockComponent Block="child"
                                  RenderX="@cGapX"
                                  RenderY="@rowY"
                                  TryGetBlock="TryGetBlock" />
            }
        }
    }

    @* Statement chain children (NextBlockId) — rendered below this block *@
    @{
        string? nextId = (Block as PxBlockCommand)?.NextBlockId ?? (Block as PxBlockHat)?.NextBlockId;
    }
    @if (nextId != null && TryGetBlock != null)
    {
        var child = TryGetBlock(nextId);
        if (child != null)
        {
            <PxBlockComponent Block="child"
                              RenderX="0"
                              RenderY="@bodyH"
                              TryGetBlock="TryGetBlock" />
        }
    }
</g>

@code {
    [Parameter] public PxBlock Block { get; set; } = default!;
    [Parameter] public float RenderX { get; set; } = float.NaN;
    [Parameter] public float RenderY { get; set; } = float.NaN;
    [Parameter] public Func<string, PxBlock?>? TryGetBlock { get; set; }

    private static readonly IFormatProvider Inv = System.Globalization.CultureInfo.InvariantCulture;

    private static string Darken(string h, float a)
    {
        if (h.StartsWith("#") && h.Length == 7)
        {
            int r = (int)(Convert.ToInt32(h[1..3], 16) * (1 - a));
            int g = (int)(Convert.ToInt32(h[3..5], 16) * (1 - a));
            int b = (int)(Convert.ToInt32(h[5..7], 16) * (1 - a));
            return $"#{Math.Clamp(r, 0, 255):X2}{Math.Clamp(g, 0, 255):X2}{Math.Clamp(b, 0, 255):X2}";
        }
        return "#333";
    }
}
