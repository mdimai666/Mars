@namespace Mars.PxBlocks.Workspace

<div class="px-blocks-editor" data-rail="@RailDisplay.ToString().ToLowerInvariant()" style="width:100%; height:100%; display:flex;">
    @if (_loadError != null)
    {
        <div style="padding:16px; color:#B00020;">@_loadError</div>
    }
    else if (Context != null && _contextDefinitions == null)
    {
        <div style="padding:16px; color:#888;">Загрузка контекста «@Context»…</div>
    }
    else
    {
        <PxToolboxRail Toolbox="EffectiveToolbox"
                       Selected="_selectedCategory"
                       OnCategorySelected="OnCategorySelectedAsync"
                       OnSearch="OnSearchAsync" />
        <div style="flex:1; min-width:0;">
            <PxBlocksWorkspace @ref="_workspace"
                               OptionsJson="@OptionsJson"
                               Toolbox="EffectiveToolbox"
                               Types="EffectiveTypes"
                               BlockDefinitions="EffectiveDefinitions"
                               BlockDefinitionsJson="@EffectiveDefinitionsJson"
                               OnReady="OnWorkspaceReady"
                               OnWorkspaceChanged="OnWorkspaceChangedInternal"
                               OnToolboxSelectionChanged="OnToolboxSelectionChanged" />
        </div>
    }
</div>

@code {
    [Parameter] public string? OptionsJson { get; set; }

    /// <summary>Свой toolbox; без него — toolbox контекста либо MakeCode-дефолт.</summary>
    [Parameter] public PxToolbox? Toolbox { get; set; }

    /// <summary>Свой реестр типов; без него — дефолт (Boolean/Number/String/Any/Object).</summary>
    [Parameter] public PxTypeRegistry? Types { get; set; }

    /// <summary>Свои определения блоков (список или PxBlockSet); без них — ядерные события Start/Loop.</summary>
    [Parameter] public IEnumerable<PxBlockDefinition>? BlockDefinitions { get; set; }

    /// <summary>
    /// Определения блоков с сервера — Blockly JSON-массив из api/PxBlocks/Definitions.
    /// Имеет приоритет над <see cref="BlockDefinitions"/> (блоки объявлены на сервере,
    /// в WASM их определений нет).
    /// </summary>
    [Parameter] public string? BlockDefinitionsJson { get; set; }

    /// <summary>
    /// Имя контекста редактора (регистр не важен): определения и toolbox берутся
    /// с сервера через <see cref="Transport"/> (api/PxBlocks/Contexts/{имя}).
    /// Явные <see cref="BlockDefinitionsJson"/>/<see cref="Toolbox"/> имеют приоритет.
    /// </summary>
    [Parameter] public string? Context { get; set; }

    /// <summary>Клиент серверного API — нужен для <see cref="Context"/>.</summary>
    [Parameter] public IPxBlocksApiClient? Transport { get; set; }

    /// <summary>
    /// Начальный JSON блоков (управляемый режим): редактор загружает его в полотно.
    /// Смена значения параметра перечитывает полотно — хост так откатывает изменения.
    /// Сохранение — <see cref="SaveAsync"/> (хост сам решает, куда сохранять).
    /// </summary>
    [Parameter] public string? BlocksJson { get; set; }

    /// <summary>Отображение рейки категорий: авто-сворачивание при малой ширине, явно полная или компактная.</summary>
    [Parameter] public PxRailDisplay RailDisplay { get; set; } = PxRailDisplay.Auto;

    /// <summary>Полотно создано и готово к LoadAsync/SaveAsync.</summary>
    [Parameter] public EventCallback OnReady { get; set; }

    /// <summary>Проброс событий workspace потребителю.</summary>
    [Parameter] public EventCallback<IReadOnlyList<PxBlocklyEvent>> OnWorkspaceChanged { get; set; }

    private PxBlocksWorkspace? _workspace;
    private string? _selectedCategory;
    private string? _lastCategory;
    private bool _searchActive;

    private PxToolbox? _defaultToolbox;
    private PxTypeRegistry? _defaultTypes;
    private IReadOnlyList<PxBlockDefinition>? _defaultDefinitions;

    private PxDefinitionsResponse? _contextDefinitions;
    private string? _loadError;
    private bool _ready;
    private string? _appliedBlocksJson;

    // Приоритет определений: явный JSON → контекст → явные классы → ядерный минимум.
    private string? EffectiveDefinitionsJson => BlockDefinitionsJson ?? _contextDefinitions?.DefinitionsJson;
    private PxToolbox EffectiveToolbox => Toolbox ?? _contextDefinitions?.Toolbox ?? (_defaultToolbox ??= PxDefaultToolbox.Create());
    private PxTypeRegistry EffectiveTypes => Types ?? (_defaultTypes ??= PxTypeRegistry.CreateDefault());

    // Локальный минимум: событийные блоки Start/Loop (определения в Shared);
    // доменные наборы приходят с сервера (EffectiveDefinitionsJson).
    private IEnumerable<PxBlockDefinition> EffectiveDefinitions => BlockDefinitions ?? (_defaultDefinitions ??= [.. new PxEventBlocks().Definitions]);

    protected override async Task OnInitializedAsync()
    {
        if (Context == null)
            return;

        if (Transport == null)
        {
            _loadError = "Для параметра Context нужен транспорт (IPxBlocksApiClient)";
            return;
        }

        try
        {
            _contextDefinitions = await Transport.GetContextDefinitionsAsync(Context);
        }
        catch (Exception exception)
        {
            _loadError = $"Не удалось получить контекст «{Context}»: {exception.Message}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Хост асинхронно подгрузил/откатил сценарий — перечитываем полотно новым значением.
        if (_ready && BlocksJson != _appliedBlocksJson)
            await ApplyBlocksJsonAsync();
    }

    private async Task OnWorkspaceReady()
    {
        _ready = true;
        if (BlocksJson != _appliedBlocksJson)
            await ApplyBlocksJsonAsync();
        await OnReady.InvokeAsync();
    }

    private async Task ApplyBlocksJsonAsync()
    {
        _appliedBlocksJson = BlocksJson;
        if (!string.IsNullOrEmpty(BlocksJson))
            await _workspace!.LoadAsync(BlocksJson);
    }

    private async Task OnWorkspaceChangedInternal(IReadOnlyList<PxBlocklyEvent> events)
        => await OnWorkspaceChanged.InvokeAsync(events);

    /// <summary>Blockly сам закрыл flyout/сбросил выбор (drag-out, клик мимо) — гасим подсветку рейки.</summary>
    private async Task OnToolboxSelectionChanged(string? name)
    {
        if (name == SearchCategoryName)
            name = null;
        if (_selectedCategory == name)
            return;
        _selectedCategory = name;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCategorySelectedAsync(string name)
    {
        if (_searchActive)
        {
            _searchActive = false;
            await _workspace!.SetToolboxAsync(EffectiveToolbox);
        }

        // Тогл «закрыть flyout» — только если он реально открыт на этой категории:
        // после drag-out Blockly закрывает flyout сам, и клик должен снова открыть.
        if (_selectedCategory == name && await _workspace!.IsFlyoutVisibleAsync())
        {
            await _workspace!.ClearToolboxSelectionAsync();
        }
        else
        {
            _lastCategory = name;
            await _workspace!.SelectCategoryAsync(name);
        }
    }

    private const string SearchCategoryName = "Поиск";

    private async Task OnSearchAsync(string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            if (!_searchActive)
                return;
            _searchActive = false;
            await _workspace!.SetToolboxAsync(EffectiveToolbox);
            if (_lastCategory != null)
                await _workspace!.SelectCategoryAsync(_lastCategory);
            return;
        }

        _searchActive = true;
        await _workspace!.SetToolboxAsync(BuildSearchToolbox(query));
        await _workspace!.SelectCategoryAsync(SearchCategoryName);
    }

    /// <summary>Категория/блок совпадают с запросом — блоки попадают во flyout поиска.</summary>
    private PxToolbox BuildSearchToolbox(string query)
    {
        var found = new List<PxToolboxItem>();
        foreach (var category in EffectiveToolbox.Contents.OfType<PxToolboxCategory>())
        {
            var categoryMatch = category.Name.Contains(query, StringComparison.OrdinalIgnoreCase);
            foreach (var block in category.Items.OfType<PxToolboxBlock>())
            {
                if (categoryMatch || block.Type.Contains(query, StringComparison.OrdinalIgnoreCase))
                {
                    found.Add(block);
                    if (found.Count >= 50)
                        break;
                }
            }
        }

        if (found.Count == 0)
            found.Add(new PxToolboxLabel { Text = "Ничего не найдено" });

        return new PxToolbox
        {
            Contents =
            [
                new PxToolboxCategory { Name = SearchCategoryName, Colour = "#575E75", Items = found }
            ]
        };
    }

    public ValueTask<string> SaveAsync() => _workspace!.SaveAsync();

    public ValueTask LoadAsync(string blocksJson) => _workspace!.LoadAsync(blocksJson);

    public async Task Undo() => await _workspace!.UndoAsync();

    public async Task Redo() => await _workspace!.RedoAsync();

    public async Task Clear() => await _workspace!.ClearAsync();

    public async Task Center() => await _workspace!.CenterContentAsync();

    /// <summary>Подсветка блока (исполнение: бегущий блок, блок с ошибкой).</summary>
    public ValueTask HighlightBlockAsync(string blockId, bool on) => _workspace!.HighlightBlockAsync(blockId, on);
}
