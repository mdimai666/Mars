@namespace Mars.PxBlocks.Workspace

<div class="px-blocks-editor" style="width:100%; height:100%; display:flex; flex-direction:column;">
    <div class="px-blocks-toolbar" style="display:flex; gap:6px; align-items:center; padding:6px 10px; border-bottom:1px solid #ddd;">
        <button class="btn btn-sm btn-outline-secondary" @onclick="Undo" title="Ctrl+Z">↶ Undo</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Redo" title="Ctrl+Y">↷ Redo</button>
        <button class="btn btn-sm btn-outline-danger" @onclick="Clear">🗑 Clear</button>
        <span style="flex:1"></span>
        <span style="font-size:12px; color:#888;">@_status</span>
    </div>
    <div style="flex:1; min-height:0;">
        <PxBlocksWorkspace @ref="_workspace"
                           OptionsJson="@OptionsJson"
                           Toolbox="EffectiveToolbox"
                           Types="EffectiveTypes"
                           BlockDefinitions="EffectiveDefinitions"
                           OnReady="OnWorkspaceReady"
                           OnWorkspaceChanged="OnWorkspaceChangedInternal" />
    </div>
</div>

@code {
    [Parameter] public string? OptionsJson { get; set; }

    /// <summary>Свой toolbox; без него — MakeCode-дефолт.</summary>
    [Parameter] public PxToolbox? Toolbox { get; set; }

    /// <summary>Свой реестр типов; без него — дефолт (Boolean/Number/String/Any/Object).</summary>
    [Parameter] public PxTypeRegistry? Types { get; set; }

    /// <summary>Свои определения блоков (список или PxBlockSet); без них — демо-набор.</summary>
    [Parameter] public IEnumerable<PxBlockDefinition>? BlockDefinitions { get; set; }

    /// <summary>Ключ localStorage для автосейва; пустая строка отключает автосейв.</summary>
    [Parameter] public string StorageKey { get; set; } = "pxblocks.workspace";

    /// <summary>Проброс событий workspace потребителю.</summary>
    [Parameter] public EventCallback<IReadOnlyList<PxBlocklyEvent>> OnWorkspaceChanged { get; set; }

    [Inject] private ILocalStorageService LocalStorage { get; set; } = default!;

    private PxBlocksWorkspace? _workspace;
    private string _status = "";

    private PxToolbox? _defaultToolbox;
    private PxTypeRegistry? _defaultTypes;
    private IReadOnlyList<PxBlockDefinition>? _defaultDefinitions;

    private PxToolbox EffectiveToolbox => Toolbox ?? (_defaultToolbox ??= PxDefaultToolbox.Create());
    private PxTypeRegistry EffectiveTypes => Types ?? (_defaultTypes ??= PxTypeRegistry.CreateDefault());
    private IEnumerable<PxBlockDefinition> EffectiveDefinitions => BlockDefinitions ?? (_defaultDefinitions ??= PxDefaultBlocks.Create());

    private async Task OnWorkspaceReady()
    {
        if (string.IsNullOrEmpty(StorageKey))
            return;

        var json = await LocalStorage.GetItemAsStringAsync(StorageKey);
        if (string.IsNullOrEmpty(json))
            return;

        await _workspace!.LoadAsync(json);
        _status = "загружено из localStorage";
    }

    private async Task OnWorkspaceChangedInternal(IReadOnlyList<PxBlocklyEvent> events)
    {
        if (!string.IsNullOrEmpty(StorageKey))
        {
            var json = await _workspace!.SaveAsync();
            await LocalStorage.SetItemAsStringAsync(StorageKey, json);
            _status = $"автосейв {DateTime.Now:HH:mm:ss} (событий: {events.Count})";
        }
        await OnWorkspaceChanged.InvokeAsync(events);
    }

    public ValueTask<string> SaveAsync() => _workspace!.SaveAsync();

    public ValueTask LoadAsync(string blocksJson) => _workspace!.LoadAsync(blocksJson);

    public async Task Undo() => await _workspace!.UndoAsync();

    public async Task Redo() => await _workspace!.RedoAsync();

    public async Task Clear() => await _workspace!.ClearAsync();
}
