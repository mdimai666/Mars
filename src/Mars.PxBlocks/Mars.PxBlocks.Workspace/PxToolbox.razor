@using Mars.PxBlocks.Shared
@namespace Mars.PxBlocks.Workspace

<div class="px-toolbox"
     style="width:160px; background:#2C2C2C; color:#fff; font-family:'Segoe UI',sans-serif; font-size:12px; user-select:none; overflow-y:auto; height:100%;">
    @foreach (var cat in Categories)
    {
        <div class="px-toolbox-category">
            <div class="px-category-header d-flex align-items-center"
                 style="background:@cat.Colour; cursor:pointer; padding:6px 10px;"
                 @onclick="() => cat.Expanded = !cat.Expanded">
                <span style="font-size:10px; width:14px; text-align:center; opacity:0.7;">@(cat.Expanded ? "\u25BC" : "\u25B6")</span>
                <span style="font-weight:600; font-size:12px; letter-spacing:0.3px;">@cat.Name.ToUpperInvariant()</span>
            </div>
            @if (cat.Expanded)
            {
                <div class="px-category-blocks" style="padding:3px 4px; background:#333;">
                    @foreach (var def in cat.Blocks)
                    {
                        <div class="px-toolbox-item"
                             style="padding:4px 7px; margin:1px 0; background:@def.Colour;
                                    border-radius:3px; cursor:grab; white-space:nowrap;
                                    overflow:hidden; text-overflow:ellipsis; font-size:12px;
                                    font-weight:500;"
                             draggable="true"
                             @ondragstart="(e) => OnDragStart(e, def)"
                             title="@def.Tooltip">
                            @def.Message
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<PxToolboxCategory> Categories { get; set; } = [];

    [Parameter] public EventCallback<PxBlockDefinition> OnBlockDragStart { get; set; }

    private async Task OnDragStart(DragEventArgs e, PxBlockDefinition def)
    {
        await OnBlockDragStart.InvokeAsync(def);
    }
}
