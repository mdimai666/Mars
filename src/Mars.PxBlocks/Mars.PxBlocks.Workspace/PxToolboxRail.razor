@namespace Mars.PxBlocks.Workspace

<div class="pxb-rail">
    <div class="pxb-rail-search">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <circle cx="7" cy="7" r="4.5" />
            <path d="M10.5 10.5L14 14" />
        </svg>
        <input type="text" placeholder="Поиск…" value="@_query" @oninput="OnInputAsync" />
    </div>
    <div class="pxb-rail-list">
        @foreach (var category in Categories.Where(c => !c.Advanced))
        {
            @Row(category)
        }
        @if (AdvancedCategories.Any())
        {
            <button class="pxb-rail-item pxb-rail-advanced" @onclick="ToggleAdvanced">
                <svg class="pxb-chev @(_advancedOpen ? "open" : "")" viewBox="0 0 16 16" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3l5 5-5 5" />
                </svg>
                Advanced
            </button>
            @if (_advancedOpen)
            {
                @foreach (var category in AdvancedCategories)
                {
                    @Row(category)
                }
            }
        }
    </div>
</div>

@code {
    [Parameter] public PxToolbox? Toolbox { get; set; }

    /// <summary>Имя выбранной категории (подсветка рейки).</summary>
    [Parameter] public string? Selected { get; set; }

    [Parameter] public EventCallback<string> OnCategorySelected { get; set; }

    /// <summary>Поисковый запрос (с дебаунсом); пустая строка — сброс поиска.</summary>
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    private string _query = "";
    private bool _advancedOpen;
    private CancellationTokenSource? _debounce;

    private IEnumerable<PxToolboxCategory> Categories =>
        Toolbox?.Contents.OfType<PxToolboxCategory>() ?? [];

    private IEnumerable<PxToolboxCategory> AdvancedCategories => Categories.Where(c => c.Advanced);

    private RenderFragment Row(PxToolboxCategory category) =>
        @<button class="pxb-rail-item @(Selected == category.Name ? "selected" : "")"
                 style="@(Selected == category.Name ? $"background:{category.Colour}" : "")"
                 @onclick="() => ClickAsync(category)">
            <span style="color:@(Selected == category.Name ? "#ffffff" : category.Colour)">@Icon(category.Icon)</span>
            @category.Name
        </button>;

    private async Task ClickAsync(PxToolboxCategory category)
    {
        _debounce?.Cancel();
        _query = "";
        await OnCategorySelected.InvokeAsync(category.Name);
    }

    private void ToggleAdvanced() => _advancedOpen = !_advancedOpen;

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        _query = e.Value as string ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(250, token);
            await OnSearch.InvokeAsync(_query);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private static RenderFragment Icon(string name) =>
        @<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round">
            @switch (name)
            {
                case "flask":
                    <path d="M6 2h4M7 2v4L3.5 12.5A1.5 1.5 0 0 0 4.9 14.5h6.2a1.5 1.5 0 0 0 1.4-2L9 6V2" />
                    break;
                case "logic":
                    <circle cx="4" cy="4" r="1.8" />
                    <circle cx="4" cy="12" r="1.8" />
                    <circle cx="12" cy="8" r="1.8" />
                    <path d="M5.6 4.8l4.8 2.4M5.6 11.2l4.8-2.4" />
                    break;
                case "loops":
                    <path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v2.8h-2.8" />
                    break;
                case "math":
                    <path d="M4.5 2.5v7M1 6h7M10.5 12.5h4.5M10.5 2.5l4.5 5M15 2.5l-4.5 5" />
                    break;
                case "text":
                    <path d="M3 4h10M3 8h10M3 12h6" />
                    break;
                case "arrays":
                    <rect x="2" y="3.5" width="12" height="9" rx="1.5" />
                    <path d="M6.5 3.5v9M10.5 3.5v9" />
                    break;
                case "variables":
                    <path d="M2 5h12M2 11h12" />
                    <circle cx="6" cy="5" r="2" fill="currentColor" />
                    <circle cx="10" cy="11" r="2" fill="currentColor" />
                    break;
                case "functions":
                    <path d="M10.5 2.5c-2.5 0-2.7 2-3 4-.4 3-.7 7-3.5 7M2.5 7.5h6" />
                    <path d="M10.5 9l4 4.5M14.5 9l-4 4.5" />
                    break;
                default:
                    <circle cx="8" cy="8" r="5" />
                    break;
            }
        </svg>;
}
