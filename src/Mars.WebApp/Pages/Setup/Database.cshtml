@page "/setup/database"
@model Mars.Pages.Setup.DatabaseModel
@{
    ViewData["Title"] = "Настройка базы данных";
    ViewData["CurrentStep"] = 2;
}

<h3 class="mb-1">Настройка базы данных</h3>
<p class="text-muted mb-4">Введите параметры подключения к PostgreSQL</p>

@if (!string.IsNullOrEmpty(Model.TestResult))
{
    var isSuccess = Model.TestSuccess;
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-mars d-flex align-items-center" role="alert">
        <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
        <small>@Model.TestResult</small>
    </div>
}

<form method="post">
    <div class="mb-3">
        <label class="form-label fw-semibold">Хост</label>
        <input asp-for="Host" class="form-control" placeholder="localhost" />
    </div>
    <div class="mb-3">
        <label class="form-label fw-semibold">Порт</label>
        <input asp-for="Port" class="form-control" placeholder="5432" type="number" />
    </div>
    <div class="mb-3">
        <label class="form-label fw-semibold">Имя базы данных</label>
        <input asp-for="Database" class="form-control" placeholder="mars" />
    </div>
    <div class="mb-3">
        <label class="form-label fw-semibold">Пользователь</label>
        <input asp-for="Username" class="form-control" placeholder="mars" />
    </div>
    <div class="mb-3">
        <label class="form-label fw-semibold">Пароль</label>
        <input asp-for="Password" class="form-control" type="password" placeholder="••••••" />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" asp-page-handler="TestDb" class="btn btn-mars-outline">
            <i class="bi bi-plug me-1"></i> Проверить подключение
        </button>
        <button type="submit" asp-page-handler="Next" class="btn btn-mars ms-auto">
            Далее <i class="bi bi-arrow-right ms-1"></i>
        </button>
    </div>
</form>
