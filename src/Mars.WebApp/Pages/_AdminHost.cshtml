@page ""
@namespace Mars.Pages
@using Mars.Admin.Framework
@using Mars.Options.Services
@using Mars.Identity.Abstractions.Interfaces
@using Mars.Core.Features
@using Mars.Server.Handlers
@using Mars.SiteEngine.Abstractions.Constants.Website
@using Mars.Server.Abstractions.Interfaces
@using Mars.Server.Abstractions.Services
@using Mars.SiteEngine.Abstractions.WebSite.Scripts
@using Mars.SiteEngine.WebSite.Scripts
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
@inject IOptionService optionService
@inject IServiceProvider serviceProvider;
@inject IRequestContext requestContext;
@inject InitialSiteDataViewModelHandler _initialSiteDataHandler;

@{
    var scriptsBuilder = serviceProvider.GetRequiredKeyedService<ISiteScriptsBuilder>(AppAdminConstants.SiteScriptsBuilderKey);

    var vm = await _initialSiteDataHandler.Handle(Request, devAdminPageData: true, CancellationToken.None);

    Q.UpdateInitialSiteData(vm);

    var json = System.Text.Json.JsonSerializer.Serialize(vm);

    string bodyClass = "logged-in ";

    if (requestContext.IsAuthenticated && requestContext.Roles is not null)
    {
        var isAdmin = requestContext.Roles.Contains("Admin");

        bodyClass += $"{(isAdmin ? "admin" : "")} ";
    }

    bool isDarkTheme = false;
    if (Request.Cookies.ContainsKey("dark"))
    {
        isDarkTheme = bool.Parse(Request.Cookies["dark"] ?? "false");
    }
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@optionService.SysOption.SiteName</title>
    <base href="/dev/" />

    @* все скрипты админки собираются в AppAdminSpaHtmlScripts *@
    @Html.Raw(scriptsBuilder.HeadScriptsRender())

</head>
<body class="@($"{bodyClass} {(isDarkTheme ? "dark" : "")}")">

    <script>
        function InitialSiteDataViewModel() {
            let vm = "@Html.Raw(TextZip.ZipToBase64(json))";
            return vm;
        }
    </script>
    <app id="app">
        <div class="flex-fill xcenter">
            <img src="/mars/img/logo.svg" width="200" class="mb-2" />

            <div class="loading-progress">
                <div class="loading-progress-bar"></div>
            </div>

            <style>
                .loading-progress {
                    position: relative;
                    display: block;
                    width: 100px;
                    height: 4px;
                    background-color: #e1e1e1;
                }

                .loading-progress-bar {
                    height: 100%;
                    background-color: var(--accent-fill-rest);
                    width: var(--blazor-load-percentage, 0%);
                    transition: width 0.2s ease;
                }
            </style>
        </div>

    </app>

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Произошла ошибка. Это приложение может больше не отвечать до перезагрузки.
        </environment>
        <environment include="Development">
            Произошло необработанное исключение. Дополнительные сведения см. в инструментах разработки браузера.
        </environment>
        <a href="" class="reload">Перезагрузить</a>
        <a class="dismiss">🗙</a>
    </div>

    @Html.Raw(scriptsBuilder.FooterScriptsRender())

</body>
</html>
