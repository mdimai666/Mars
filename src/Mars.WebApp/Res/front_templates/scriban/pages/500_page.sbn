@page "/500"
@layout "layout/centered"

<h1 class="" style="font-size: 200px;">500</h1>

{{ if !_dev }}
<h3 class="text-muted">Внутренняя ошибка</h3>
{{ else }}
<h2 class="text-danger">{{ ex.Message }}</h2>

<div class="mw-100 fs-6 alert alert-secondary">
    <strong>StackTrace:</strong>
    <pre class="wrap">{{ ex.StackTrace }}</pre>
</div>
{{ end }}

<div class="text-center mt-5">
    <a href="/" class="btn btn-outline-primary rounded-0 position-relative">
        <i class="bi bi-house"></i>
        <span>На главную</span>
    </a>
</div>
