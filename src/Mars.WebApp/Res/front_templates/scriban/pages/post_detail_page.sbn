@page "/posts/{Slug}"

{{ context '
post = ef.post.First(post.Slug.ToLower() == Slug.ToLower())
' }}
{{ page_title = post.Title + ' - ' + SiteSettings.SiteName }}

<div class="container">
    <article>
        <h1>{{ post.Title }}</h1>

        <img src="img/image_placeholder.svg" alt="" style="max-height: 300px;">

        <div class="mt-4 content">
            {{ render_post_content post.Id }}
        </div>

    </article>

    <div class="mt-5">
        <div class="accordion" id="accordionExample">

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        Json
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse _show" data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <code><pre>{{ tojson post }}</pre></code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
