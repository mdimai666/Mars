{
    "ConnectionStrings": {
        "DefaultConnection": "Host=127.0.0.1;Database=mars;Username=mars;Password=mars"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Quartz.Impl.StdSchedulerFactory": "Warning",
            "Quartz.Core.QuartzScheduler": "Warning"
        },
        "File": {
            "LogLevel": {
                "Default": "Warning"
            },
            "RetentionDays": 30
        }
    },
    "Urls": "http://+:80",
    "AllowedHosts": "*",
    "JWTSettings": {
        "PrivateKeyPath": "jwt_private.pem",
        "validAudience": "mars-app",
        "expiryInMinutes": 4320
    },
    "Plugins": {
        "_HelloPlugin1": {
            "ContentRootPath": "...",
            "AssemblyPath": "...\\HelloPlugin1.dll"
        }
    },
    "PluginCatalog": {
        "Enabled": true,
        "Url": "https://catalog.mdimai666.ru"
    },
    "Docker": {
        "Endpoint": "",
        "RegistryUrl": "",
        "DefaultRunTimeoutSeconds": 300
    },
    "FeatureManagement": {
        "DockerAgent": false,
        "AITool": true,
        "AiChat": true,
        "SingleSignOn": true,
        "CodeCompletion": false
    },
    "CodeCompletion": {
        "IdleTimeoutMinutes": 30
    },
    "AppDatabaseMigrationOptions": {
        "AutoMigrate": true
    },
    "OpenTelemetryAppOptions": {
        "Enable": false,
        "AddProcessInstrumentation": true,
        "AddRuntimeInstrumentation": false,
        "AddEntityFrameworkCoreInstrumentation": false,
        "AddPrometheusExporter": true,
        "PrometheusScrapingEndpoint": "/_ot/metrics"
    },
    "PostgresDistributedCache": {
        "SchemaName": "cache",
        "TableName": "cache",
        "CreateIfNotExists": true,
        "UseWAL": false,
        "ExpiredItemsDeletionInterval": "00:30:00",
        "DefaultSlidingExpiration": "00:20:00"
    }
}
