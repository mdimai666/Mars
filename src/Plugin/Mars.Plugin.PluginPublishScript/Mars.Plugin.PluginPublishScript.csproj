<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>

        <PackageId>mdimai666.Mars.Plugin.PluginPublishScript</PackageId>
        <Product>Mars.Plugin.PluginPublishScript</Product>
        <Description>
            Tool for developing and publishing plugins;
        </Description>
        <GenerateRuntimeConfigDevFile>true</GenerateRuntimeConfigDevFile>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Mars.deps.json" Pack="true" PackagePath="\lib\net10.0\" />
        <None Include="$(OutDir)Mars.Plugin.Front.Abstractions.dll" Pack="true" PackagePath="\lib\net10.0\" />
        <None Include="$(OutDir)Microsoft.AspNetCore.Components.WebAssembly.dll" Pack="true" PackagePath="\lib\net10.0\" />
    </ItemGroup>

    <!-- При параллельной пересборке источника (полный ребилд) файла может ещё не быть —
         тогда оставляем прежнюю копию: содержимое обновится следующей сборкой -->
    <Target Name="RunPostCompileDebugScript" AfterTargets="CoreBuild"
            Condition="'$(Configuration)' == 'Debug' and Exists('$(ProjectDir)..\..\Mars.WebApp\bin\$(Configuration)\net10.0\Mars.deps.json')">
        <Exec Command="copy $(ProjectDir)..\..\Mars.WebApp\bin\$(Configuration)\net10.0\Mars.deps.json $(ProjectDir)Mars.deps.json" />
        <!--<Exec Command="copy $(ProjectDir)..\..\Mars.WebApp\bin\$(Configuration)\net10.0\Mars.deps.json $(OutDir)Mars.deps.json" />-->
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\Mars.Plugin.Front.Abstractions\Mars.Plugin.Front.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Mars.deps.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
