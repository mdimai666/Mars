    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ExternalServices.TestContainers\ExternalServices.TestContainers.csproj" />
        <ProjectReference Include="..\Mars.Test.AppHost\Mars.Test.AppHost.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
