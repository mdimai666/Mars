<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Testcontainers" />
        <!-- Не-тестовая сборка (общие фикстуры): мета-пакет xunit.v3 требует OutputType=Exe
             (ошибка из xunit.v3.core.mtp-v2.targets); для classlib нужен только
             xunit.v3.extensibility.core (IAsyncLifetime). -->
        <PackageReference Include="xunit.v3.extensibility.core" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
