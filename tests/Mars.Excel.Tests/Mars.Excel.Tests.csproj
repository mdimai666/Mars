<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <ItemGroup>
        <!-- В Mars.Excel.Host оба пакета с PrivateAssets="All" и не текут транзитивно —
             ссылки нужны и для проверки результата (ClosedXML), и для рантайма генерации (ClosedXML.Report). -->
        <PackageReference Include="ClosedXML" />
        <PackageReference Include="ClosedXML.Report" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Testing.Platform" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Mars.Modules\Mars.Excel.Host\Mars.Excel.Host.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Реальный прод-шаблон отчёта фидбека: тестируем его как есть, без копирования в репо тестов. -->
        <Content Include="..\..\src\Mars.WebApp\Res\Excel\Feedback\feedback_list.xlsx" Link="Templates\feedback_list.xlsx" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
