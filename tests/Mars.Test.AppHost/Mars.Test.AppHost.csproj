<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- RCS1139 — как в исходном тест-проекте; CA2255 — NpgsqlGlobalSetup намеренно использует ModuleInitializer в библиотеке -->
        <NoWarn>RCS1139;CA2255</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoFixture" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Flurl.Http" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Respawn" />
        <PackageReference Include="Testcontainers" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <!-- Не-тестовая сборка: мета-пакет xunit.v3 требует OutputType=Exe (ошибка из xunit.v3.core.mtp-v2.targets).
             Для classlib нужны xunit.v3.extensibility.core (атрибуты/fixtures) + xunit.v3.assert (Xunit.Assert). -->
        <PackageReference Include="xunit.v3.assert" />
        <PackageReference Include="xunit.v3.extensibility.core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Mars.WebApp\Mars.WebApp.csproj" />
        <ProjectReference Include="..\..\src\Server\Mars.Data.Repositories\Mars.Data.Repositories.csproj" />
        <ProjectReference Include="..\Mars.Test.Common\Mars.Test.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
