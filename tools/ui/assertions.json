      { "name": "cloudy-grid header compact (design 57px: padding 12+12 + line 20)", "selector": "table.cloudy-grid.fluent-data-grid th", "box": { "maxHeight": 60 }, "optional": true },
      { "name": "actions column is last", "selector": ".fluent-data-grid th:last-child", "text": { "contains": "Действия" }, "optional": true },
      { "name": "icon-only row button square", "selector": ".fluent-data-grid td fluent-button:has(> svg:only-child)", "box": { "maxWidth": 48 }, "optional": true }
