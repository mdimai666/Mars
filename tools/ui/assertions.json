{
  "all": [
    { "name": "body background is white", "selector": "body", "css": { "background-color": "rgb(255, 255, 255)" } },
    { "name": "admin-layout background is white", "selector": ".admin-layout", "css": { "background-color": "rgb(255, 255, 255)" }, "optional": true },
    { "name": "fluent-menu items wrapped in fluent-menu-list", "each": "fluent-menu", "hasChild": "fluent-menu-list" },
    { "name": "no dead attr usemenuservice", "absent": "[usemenuservice]" },
    { "name": "sidebar nav background transparent", "selector": ".admin-layout .menu-admin1", "css": { "--nav-bg-color": "transparent" }, "optional": true }
  ],
  "pages": {
    "/dev": [
      { "name": "cloudy shell rendered", "selector": ".cloudy-layout .cloudy-sidebar", "exists": { "min": 1 } },
      { "name": "cloudy home stats rendered", "selector": ".cloudy-stats .cloudy-stat", "exists": { "min": 4 } },
      { "name": "cloudy recent posts rendered", "selector": ".cloudy-recent", "exists": { "min": 1 } }
    ],
    "/dev/Post": [
      { "name": "cloudy acrylic shell", "selector": ".cloudy-acrylic", "exists": { "min": 1 }, "optional": true },
      { "name": "data-grid header compact", "selector": ".fluent-data-grid th", "box": { "maxHeight": 40 } },
      { "name": "actions column is last", "selector": ".fluent-data-grid th:last-child", "text": { "contains": "Действия" } },
      { "name": "icon-only row button square", "selector": ".fluent-data-grid td fluent-button:has(> svg:only-child)", "box": { "maxWidth": 48 }, "optional": true }
    ],
    "/dev/Post/*": [
      { "name": "cloudy acrylic shell", "selector": ".cloudy-acrylic", "exists": { "min": 1 }, "optional": true },
      { "name": "data-grid header compact", "selector": ".fluent-data-grid th", "box": { "maxHeight": 40 } },
      { "name": "actions column is last", "selector": ".fluent-data-grid th:last-child", "text": { "contains": "Действия" } },
      { "name": "icon-only row button square", "selector": ".fluent-data-grid td fluent-button:has(> svg:only-child)", "box": { "maxWidth": 48 }, "optional": true }
    ],
    "/dev/PostCategory": [
      { "name": "cloudy acrylic shell", "selector": ".cloudy-acrylic", "exists": { "min": 1 } }
    ],
    "/dev/PostCategory/*": [
      { "name": "cloudy acrylic shell", "selector": ".cloudy-acrylic", "exists": { "min": 1 } }
    ],
    "/dev/Users": [
      { "name": "cloudy acrylic shell", "selector": ".cloudy-acrylic", "exists": { "min": 1 } }
    ],
    "/dev/Settings": [
      { "name": "cloudy acrylic shell", "selector": ".cloudy-acrylic", "exists": { "min": 1 } }
    ],
    "/dev/dashboard": [
      { "name": "cloudy shell rendered", "selector": ".cloudy-layout .cloudy-sidebar", "exists": { "min": 1 } }
    ],
    "/dev/legion": [
      { "name": "cloudy shell rendered", "selector": ".cloudy-layout .cloudy-sidebar", "exists": { "min": 1 } }
    ],
    "/dev/tech/automation": [
      { "name": "tech shell rendered", "selector": ".cloudy-tech .cloudy-tech-rail", "exists": { "min": 1 } }
    ],
    "/dev/tech/logs": [
      { "name": "tech shell rendered", "selector": ".cloudy-tech .cloudy-tech-rail", "exists": { "min": 1 } }
    ],
    "/dev/tech/database": [
      { "name": "tech shell rendered", "selector": ".cloudy-tech .cloudy-tech-rail", "exists": { "min": 1 } }
    ],
    "/dev/tech/frontend": [
      { "name": "tech shell rendered", "selector": ".cloudy-tech .cloudy-tech-rail", "exists": { "min": 1 } }
    ],
    "/dev/tech/plugins": [
      { "name": "tech shell rendered", "selector": ".cloudy-tech .cloudy-tech-rail", "exists": { "min": 1 } }
    ],
    "/dev/tech/marketplace": [
      { "name": "tech shell rendered", "selector": ".cloudy-tech .cloudy-tech-rail", "exists": { "min": 1 } }
    ],
    "/dev/builder/style-gallery": [
      { "name": "gallery sections rendered", "selector": "[data-gallery-section]", "exists": { "min": 21 } },
      { "name": "gallery grid header compact (ItemSize=76 regression)", "selector": ".fluent-data-grid th", "box": { "maxHeight": 40 } }
    ],
    "/dev/nodered": [
      { "name": "no dead --dialog-width inline", "absent": "fluent-dialog[style*='--dialog-width']" }
    ]
  }
}
